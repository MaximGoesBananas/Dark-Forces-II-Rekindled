+// A deterministic star field sampled on a sphere. Compact stars stay inside their
+// 3D cells, so there are no panorama seams, poles, or stretched ceiling texels.
+vec3 spaceStars(vec3 direction)
+{
+    vec3 p = direction * 80.0;
+    float footprint = max(length(dFdx(p)), length(dFdy(p))) * 0.5;
+    vec3 cell = floor(p);
+    vec3 random = fract(sin(vec3(dot(cell, vec3(127.1, 311.7, 74.7)),
+                                 dot(cell, vec3(269.5, 183.3, 246.1)),
+                                 dot(cell, vec3(113.5, 271.9, 124.6)))) * 43758.5453);
+    vec3 center = cell + 0.35 + 0.3 * random;
+    float radius = mix(0.06, 0.13, random.z * random.z);
+    float filteredRadius = sqrt(radius * radius + footprint * footprint);
+    float distanceToStar = length(p - center);
+    float star = 1.0 - smoothstep(0.0, filteredRadius, distanceToStar);
+    star *= radius * radius / (filteredRadius * filteredRadius);
+    star *= step(0.55, random.x) * mix(0.5, 1.3, random.y);
+    vec3 color = mix(vec3(0.72, 0.83, 1.0), vec3(1.0, 0.91, 0.78), random.y);
+    return vec3(0.009, 0.012, 0.023) + color * star;
+}
+
+// Overlap a narrow strip of neighboring repeats instead of exposing the image edge.
+vec4 cloudTexture(vec2 uv)
+{
+    const float overlap = 0.0625;
+    const float period = 1.0 - overlap;
+    vec2 p = fract(uv) * period;
+    vec2 weight = smoothstep(vec2(0.0), vec2(overlap), p);
+    vec4 color = texture(tex, p);
+    if (p.x < overlap)
+        color = mix(texture(tex, p + vec2(period, 0.0)), color, weight.x);
+    if (p.y < overlap) {
+        vec4 other = texture(tex, p + vec2(0.0, period));
+        if (p.x < overlap)
+            other = mix(texture(tex, p + vec2(period)), other, weight.x);
+        color = mix(other, color, weight.y);
+    }
+    return color;
+}
