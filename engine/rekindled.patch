+static void jkRpg_SetRank(SithThing* p, int up, int rank)
+{
+    sithInventory_SetInventory(p, RPG_BIN_RANK0 + up, rank);
+    flex_t oldMax = p->actorParams.maxHealth;
+    jkRpg_ApplyStats(p);
+    // Health grows or shrinks with its maximum straight away.
+    p->actorParams.health += p->actorParams.maxHealth - oldMax;
+    if (p->actorParams.health < 1)
+        p->actorParams.health = 1;
+}
+
+static void jkRpg_Spend(SithThing* p, int up)
+{
+    if (!jkRpg_CanSpend(p, up) || jkRpg_numUndo >= UP_COUNT)
+        return;
+    int undo = jkRpg_numUndo++;
+    jkRpg_aUndo[undo].up = up;
+    jkRpg_aUndo[undo].rank = jkRpg_Rank(p, up);
+    jkRpg_aUndo[undo].lightGap = up == UP_LIGHT && jkRpg_Get(p, RPG_BIN_LIGHTGAP);
+    jkRpg_aUndo[undo].raised = jkRpg_Get(p, RPG_BIN_MISSION0 + up);
+    sithInventory_SetInventory(p, RPG_BIN_MISSION0 + up, 1);
+    sithInventory_ChangeInventory(p, RPG_BIN_POINTS, -1);
+    if (jkRpg_aUndo[undo].lightGap)
+        sithInventory_SetInventory(p, RPG_BIN_LIGHTGAP, 0);
+    else
+        jkRpg_SetRank(p, up, jkRpg_Rank(p, up) + 1);
+    jkRpg_PlaySound(RPG_SOUND_UPGRADE);
+}
+
+// The newest purchase of this upgrade that can still be taken back, or -1.
+static int jkRpg_FindUndo(int up)
+{
+    for (int i = jkRpg_numUndo - 1; i >= 0; i--)
+        if (jkRpg_aUndo[i].up == up)
+            return i;
+    return -1;
+}
+
+static void jkRpg_Undo(SithThing* p, int up)
+{
+    int i = jkRpg_FindUndo(up);
+    if (i < 0)
+        return;
+    int rank = jkRpg_aUndo[i].rank, gap = jkRpg_aUndo[i].lightGap, raised = jkRpg_aUndo[i].raised;
+    for (; i < jkRpg_numUndo - 1; i++)
+        jkRpg_aUndo[i] = jkRpg_aUndo[i + 1];
+    jkRpg_numUndo--;
+    sithInventory_SetInventory(p, RPG_BIN_MISSION0 + up, raised);
+    if (up == UP_LIGHT) sithInventory_SetInventory(p, RPG_BIN_LIGHTGAP, gap);
+    sithInventory_ChangeInventory(p, RPG_BIN_POINTS, 1);
+    jkRpg_SetRank(p, up, rank);
+    jkRpg_PlaySound(RPG_SOUND_UNDO);
+}
+
+int jkRpg_CanUndo(int up)
+{
+    return jkRpg_FindUndo(up) >= 0;
+}
+
+int jkRpg_UndoTier(int up)
+{
+    int i = jkRpg_FindUndo(up);
+    return i < 0 ? 0 : jkRpg_aUndo[i].lightGap ? 2 : jkRpg_aUndo[i].rank + 1;
+}
