+
+// Mission 4's training remotes (04_remotes1-3.cog) fly to a waypoint and only start their run
+// once within a quarter unit of it. One that is blocked (by Kyle in its path, or a corner) hovered
+// there forever with its hiss repeating. A remote still not hunting after 8 seconds is switched to
+// hunting the way the scripts do it (aisetmode 0x4), so the training goes on.
+#define RPG_REMOTE_PATIENCE 8.0
+static void jkRpg_FreeStuckRemotes(void)
+{
+    static struct { int idx; uint32_t sig; flex_t since; } seen[6];
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (!world || __strcmpi(world->map_jkl_fname, "04escapehouse.jkl")) return;
+    flex_t now = sithTime_g_secGameTime;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* t = &world->aThings[i];
+        if (t->type != SITH_THING_ACTOR || !t->actor || (t->flags & (SITH_TF_DEAD | SITH_TF_DESTROYED))
+            || !(jkRpg_IsScript(t->pCaptureCog, "04_remotes1.cog") || jkRpg_IsScript(t->pCaptureCog, "04_remotes2.cog")
+                 || jkRpg_IsScript(t->pCaptureCog, "04_remotes3.cog"))
+            || (t->actor->flags & (SITHAI_MODE_SEARCHING | SITHAI_MODE_ACTIVE)))
+            continue;
+        int slot = -1, free = -1;
+        for (int s = 0; s < 6; s++) {
+            if (seen[s].idx == t->idx && seen[s].sig == t->signature && seen[s].since <= now) slot = s;
+            if (free < 0 && (!seen[s].sig || seen[s].since > now || now - seen[s].since > 60)) free = s;
+        }
+        if (slot < 0) {
+            if (free >= 0) seen[free] = (typeof(seen[0])){t->idx, t->signature, now};
+            continue;
+        }
+        if (now - seen[slot].since < RPG_REMOTE_PATIENCE) continue;
+        int old = t->actor->flags;
+        t->actor->flags |= SITHAI_MODE_SEARCHING;
+        sithAI_EmitEvent(t->actor, SITHAI_MODE_UNK100, old);
+        seen[slot].sig = 0;
+    }
+}
