+const char* jkRpg_BindingName(int function)
+{
+    static char name[64];
+    const stdControlKeyInfo* keys = &sithControl_aInputFuncToKeyinfo[function];
+    for (uint32_t i = 0; i < keys->numEntries; i++) {
+        if (!(keys->aEntries[i].flags & INPUT_MAPPING_FLAG_DXKEY))
+            continue;
+        const char* id = jkGuiKeyboard_DIKNumToStr(keys->aEntries[i].dxKeyNum, 0);
+        stdString_WcharToChar(name, jkStrings_GetUniStringWithFallback(id), sizeof(name) - 1);
+        name[sizeof(name) - 1] = 0;
+        return name;
+    }
+    return NULL;
+}
