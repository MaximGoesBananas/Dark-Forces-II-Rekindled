+static int jkRpg_IsCampaignBoss(const SithThing* thing)
+{
+    if (Main_bMotsCompat || !thing || thing->type != SITH_THING_ACTOR || !thing->pTemplate || !sithWorld_g_pCurrentWorld)
+        return 0;
+    static const struct { const char* map; const char* name; } bosses[] = {
+        {"07yun.jkl", "yun"}, {"11gorc.jkl", "gorc"}, {"11gorc.jkl", "pic"},
+        {"15maw.jkl", "maw"}, {"17asarris.jkl", "sariss"}, {"17bsarris.jkl", "yun2"},
+        {"20aboc.jkl", "boc"}, {"20bboc.jkl", "boc"},
+        {"21ajerec.jkl", "jerec"}, {"21bjerec.jkl", "jerec"}
+    };
+    for (int i = 0; i < (int)(sizeof(bosses) / sizeof(bosses[0])); ++i)
+        if (!__strcmpi(sithWorld_g_pCurrentWorld->map_jkl_fname, bosses[i].map)
+            && !__strcmpi(thing->pTemplate->aName, bosses[i].name)) return 1;
+    return 0;
+}
