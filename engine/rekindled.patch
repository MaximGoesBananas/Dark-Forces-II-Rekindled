+// Only a living save from this profile, episode and map can replace the normal
+// death restart. The refreshed level-start checkpoint also fences off an older
+// playthrough's timed autosave, even when it used the same starting map.
+static int sithGamesave_CanRestartAutosave(char *checkpoint)
+{
+    char path[128], checkpointPath[128];
+    sithGamesave_Header header;
+    struct stat saved, started;
+    if (sithNet_isMulti || Main_bMotsCompat || !sithWorld_g_pCurrentWorld)
+        return 0;
+    sithGamesave_GetProfilePath(path, sizeof(path), "autosave.jks");
+    sithGamesave_GetProfilePath(checkpointPath, sizeof(checkpointPath), checkpoint);
+    if (stat(path, &saved) != 0 || saved.st_size <= sizeof(header))
+        return 0;
+    if (stat(checkpointPath, &started) == 0 && saved.st_mtime < started.st_mtime)
+        return 0;
+    stdFile_t file = pLowLevelHS->fileOpen(path, "rb");
+    if (!file)
+        return 0;
+    int read = pLowLevelHS->fileRead(file, &header, sizeof(header)) == sizeof(header);
+    pLowLevelHS->fileClose(file);
+    return read && header.version == 6
+        && isfinite(header.playerHealth) && isfinite(header.playerMaxHealth)
+        && header.playerHealth > 0.0f
+        && header.playerHealth <= header.playerMaxHealth
+        && memchr(header.episodeName, 0, sizeof(header.episodeName))
+        && memchr(header.jklName, 0, sizeof(header.jklName))
+        && !__strcmpi(header.episodeName, sithWorld_g_pCurrentWorld->episodeName)
+        && !__strcmpi(header.jklName, sithWorld_g_pCurrentWorld->map_jkl_fname);
+}
+
+// Death reloads the save the player last made or loaded, as in the original game; a timed
+// autosave becomes that save when it is written. An autosave older than a later quicksave or
+// load is never used, so dying cannot skip ahead to progress the current attempt has not made.
+// Whether a profile save was made on the current map (its header only).
+static int sithGamesave_IsSameMapSave(const char* name)
+{
+    char path[128];
+    sithGamesave_Header header;
+    if (!name[0] || !sithWorld_g_pCurrentWorld) return 0;
+    sithGamesave_GetProfilePath(path, sizeof(path), name);
+    stdFile_t file = pLowLevelHS->fileOpen(path, "rb");
+    if (!file) return 0;
+    int read = pLowLevelHS->fileRead(file, &header, sizeof(header)) == sizeof(header);
+    pLowLevelHS->fileClose(file);
+    return read && memchr(header.jklName, 0, sizeof(header.jklName))
+        && !__strcmpi(header.jklName, sithWorld_g_pCurrentWorld->map_jkl_fname);
+}
+
+int sithGamesave_Restart(void)
+{
+    char checkpoint[128], previous[128], before[128];
+    stdString_snprintf(checkpoint, sizeof(checkpoint), "_JKAUTO_%s", sithGamesave_AutosaveMapName());
+    stdFnames_ChangeExt(checkpoint, "jks");
+    stdString_SafeStrCopy(previous, sithGamesave_autosave_fname, sizeof(previous));
+    stdString_SafeStrCopy(before, sithGamesave_preAutosave, sizeof(before));
+    if (!sithGamesave_IsSameMapSave(before)) before[0] = 0; // e.g. a save before an autosave loaded from the menu
+    if (__strcmpi(previous, "autosave.jks"))
+        return (previous[0] && sithGamesave_Restore(previous, 0, 0)) || sithGamesave_Restore(checkpoint, 0, 0);
+    if (sithGamesave_CanRestartAutosave(checkpoint) && sithGamesave_Restore("autosave.jks", 0, 0))
+    {
+        // Capture full paths before loading can tear down the current world.
+        if (before[0])
+            sithGamesave_GetProfilePath(sithGamesave_restartFallback[0], 128, before);
+        sithGamesave_GetProfilePath(sithGamesave_restartFallback[1], 128, checkpoint);
+        return 1;
+    }
+    if (before[0] && sithGamesave_Restore(before, 0, 0))
+        return 1;
+    return sithGamesave_Restore(checkpoint, 0, 0);
+}
+
+static int sithGamesave_RestorePending(void)
+{
+    char fallback[2][128];
+    memcpy(fallback, sithGamesave_restartFallback, sizeof(fallback));
+    memset(sithGamesave_restartFallback, 0, sizeof(sithGamesave_restartFallback));
+    if (sithGamesave_RestoreFile(sithGamesave_aCurFilename))
+        return 1;
+    for (int i = 0; i < 2; ++i)
+    {
+        if (fallback[i][0] && sithGamesave_RestoreFile(fallback[i]))
+            return 1;
+    }
+    return 0;
+}
