+// Grip boots: letting go near top running speed roughly halves the stopping time.
+// Taps, walking and slower movement never reach that speed and keep the original slide.
+// Called by ground physics every step: coasting means no thrust on a normal floor.
+flex_t jkRpg_StopDragScale(SithThing* pThing, int coasting)
+{
+    static int moving, braking;
+    if (!jkRpg_IsActive(pThing))
+        return 1.0;
+    if (!coasting) {
+        moving = 1;
+        braking = 0;
+        return 1.0;
+    }
+    flex_t speed = sqrt(pThing->physicsParams.vel.x * pThing->physicsParams.vel.x
+                        + pThing->physicsParams.vel.y * pThing->physicsParams.vel.y);
+    if (moving) { // the controls were just released
+        moving = 0;
+        flex_t top = pThing->physicsParams.surfDrag > 0
+            ? (pThing->actorParams.maxThrust + pThing->actorParams.extraSpeed) / pThing->physicsParams.surfDrag : 0;
+        braking = jkRpg_Rank(pThing, UP_ATHLETICS) >= 3 && top > 0 && speed >= RPG_GRIP_SPEED * top;
+    }
+    flex_t scale = braking ? RPG_GRIP_DRAG : 1.0;
+    if (speed <= pThing->physicsParams.staticDrag) // stopped this step; later pushes slide normally
+        braking = 0;
+    return scale;
+}
+
+// Stand firm: explosions and weapon hits push the player half as far.
+flex_t jkRpg_PushScale(SithThing* pThing)
+{
+    return jkRpg_IsActive(pThing) && jkRpg_Rank(pThing, UP_ENDURANCE) >= 3 ? RPG_PUSH_SCALE : 1.0;
+}
