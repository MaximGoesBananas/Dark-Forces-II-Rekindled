+// One reduction per saved mission. Compact visible neighborhoods, not long chains
+// along a street, define areas; walls and a half-unit height separation keep rooms apart.
+static void jkRpg_ThinDenseCrowds(SithThing* player)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (jkRpg_Get(player, RPG_BIN_CROWDFIX) >= 2 || !jkRpg_IsCrowdMap(world->map_jkl_fname)) return;
+    uint32_t now = sithTime_g_msecGameTime;
+    if (!jkRpg_crowdTrimStarted) { jkRpg_crowdTrimStarted = now; return; }
+    // Created COGs register civilian totals on their one-second timers first.
+    if ((uint32_t)(now - jkRpg_crowdTrimStarted) < 1500) return;
+    SithThing* people[SITHAI_MAX_ACTORS];
+    int count = 0;
+    for (int i = 0; i <= world->numThings && count < SITHAI_MAX_ACTORS; i++) {
+        SithThing* thing = &world->aThings[i];
+        if (jkRpg_CivilianKind(thing) && thing->sector
+            && !(thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))) people[count++] = thing;
+    }
+    unsigned char nearby[SITHAI_MAX_ACTORS][SITHAI_MAX_ACTORS] = {{0}};
+    unsigned char used[SITHAI_MAX_ACTORS] = {0};
+    for (int i = 0; i < count; i++) {
+        nearby[i][i] = 1;
+        for (int j = i + 1; j < count; j++) {
+            rdVector3 delta; rdVector_Sub3(&delta, &people[i]->position, &people[j]->position);
+            int wall;
+            if (fabs(delta.z) <= 0.5 && delta.x * delta.x + delta.y * delta.y <= 4.0
+                && jkRpg_CrowdProbe(people[i]->sector, &people[i]->position, &people[j]->position, &wall))
+                nearby[i][j] = nearby[j][i] = 1;
+        }
+    }
+    int totalRemoved = 0;
+    while (1) {
+        int center = -1, size = 10;
+        for (int i = 0; i < count; i++) {
+            if (used[i]) continue;
+            int neighbors = 0;
+            for (int j = 0; j < count; j++) neighbors += !used[j] && nearby[i][j];
+            if (neighbors > size) { center = i; size = neighbors; }
+        }
+        if (center < 0) break;
+        int added = 0;
+        for (int j = 0; j < count; j++)
+            if (!used[j] && nearby[center][j] && !jkRpg_IsAuthored(people[j])) added++;
+        int remove = (size + 2) / 5; // nearest whole person to 20% of the whole area
+        if (remove > added) remove = added;
+        int seen = 0;
+        for (int j = 0; j < count; j++) {
+            if (used[j] || !nearby[center][j]) continue;
+            used[j] = 1; // overlapping neighborhoods must never trim the same area twice
+            if (jkRpg_IsAuthored(people[j])) continue;
+            if (added && (seen + 1) * remove / added > seen * remove / added) {
+                sithThing_DestroyThing(people[j]); // no damage, kill message, drop or XP
+                totalRemoved++;
+            }
+            seen++;
+        }
+        stdPlatform_Printf("RPG crowd density: %s area=%d before=%d removed=%d after=%d\n",
+            world->map_jkl_fname, people[center]->idx, size, remove, size - remove);
+    }
+    sithInventory_ChangeInventory(player, SITHBIN_PEDS_TOTAL, -totalRemoved);
+    sithInventory_SetInventory(player, RPG_BIN_CROWDFIX, 2);
+    jkRpg_crowdTrimStarted = 0;
+}
