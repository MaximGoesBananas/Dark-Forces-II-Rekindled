+// A short incandescent cut, using the game's own saber sparks. Damage stays in the caller.
+static void jkSaber_Slash(jkPlayerInfo* info, SithThing* victim, const rdVector3* pos,
+                          const rdVector3* bladeDir, flex_t distance, SithSector* sector)
+{
+    if (sithNet_isMulti || info->actorThing != sithPlayer_g_pLocalPlayerThing ||
+        (victim->type != SITH_THING_ACTOR && victim->type != SITH_THING_PLAYER) ||
+        victim->actorParams.health <= 0 || (victim->flags & (SITH_TF_DEAD | SITH_TF_DESTROYED))) return;
+    SithThing* source = sithTemplate_GetTemplate("+sspks_wall");
+    if (!source || source->type != SITH_THING_PARTICLE || !source->particleParams.material) return;
+    SithThing effect = *source;
+    effect.moveType = SITH_MT_NONE;
+    effect.particleParams.flags = SITHPARTICLE_FLAG_EMIT_LIGHT | SITHPARTICLE_FLAG_FADE_OUT_OVER_TIME;
+    effect.particleParams.count = 24;
+    effect.particleParams.size = 0.0045;
+    effect.particleParams.range = 0;
+    effect.particleParams.rate = 120;
+    effect.msecLifeLeft = 120;
+    SithThing* slash = sithThing_CreateThingAtPos(&effect, pos, &rdroid_identMatrix34, sector, info->actorThing);
+    if (!slash) return;
+    slash->pTemplate = source;
+    rdParticle* cloud = slash->renderData.particlecloud;
+    if (!cloud) { sithThing_DestroyThing(slash); return; }
+    rdVector3 direction = *bladeDir;
+    if (info->bHasLastJointMat) {
+        rdVector3 previous = info->lastSaberJointMat.scale;
+        rdVector_ScaleAdd3Acc(&previous, &info->lastSaberJointMat.lvec, distance);
+        rdVector_Sub3(&direction, pos, &previous);
+        if (rdVector_Dot3(&direction, &direction) < 0.000001) direction = *bladeDir;
+    }
+    rdVector_Normalize3Acc(&direction);
+    cloud->cloudRadius = 0.085;
+    for (int i=0; i<cloud->numVertices; ++i) {
+        // Interleave the ends so the existing fade shortens both ends of the cut.
+        flex_t along = ((i & 1) ? -1 : 1) * (i/2) * 0.0065;
+        rdVector_Scale3(&cloud->aVertices[i], &direction, along);
+        int cel = i/4;
+        cloud->aVertMatCelNums[i] = cel < cloud->material->num_texinfo ? cel : cloud->material->num_texinfo-1;
+    }
+}
