+++ b/src/Main/jkRpgCrash.c
@@ -0,0 +1,128 @@
+// Crash notes: when the Windows game crashes, a few lines are appended to rpg/reports/crash-log.txt:
+// the time, crash code, the module and offset where it broke, the calling addresses, the build and
+// the level. tools/crash_addr.sh names the engine function for an openjkdf2-64.exe offset of the
+// same build. Windows still reports the crash as before; the game does not try to keep running.
+// Not covered: deliberate aborts that end the process without an exception.
+#include "Main/jkRpg.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+#include "version.h"
+#include "World/sithWorld.h"
+#include "Gameplay/sithPlayer.h"
+#include <stdlib.h>
+
+#define RPG_CRASH_DIR "rpg\\reports"
+#define RPG_CRASH_LOG RPG_CRASH_DIR "\\crash-log.txt"
+#define RPG_CRASH_LOG_MAX (32 * 1024) // past this, startup keeps only the newest half
+#define RPG_CRASH_FRAMES 24
+
+static void jkRpg_CrashAppend(const char* text)
+{
+    HANDLE file = CreateFileA(RPG_CRASH_LOG, FILE_APPEND_DATA, FILE_SHARE_READ, NULL, OPEN_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return;
+    DWORD written;
+    WriteFile(file, text, (DWORD)strlen(text), &written, NULL);
+    CloseHandle(file);
+}
+
+// "module+0xoffset", or the bare address when it lies in no loaded module.
+static void jkRpg_CrashAddress(char* out, size_t size, void* address)
+{
+    HMODULE module = NULL;
+    char name[MAX_PATH];
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)address, &module) && GetModuleFileNameA(module, name, sizeof(name))) {
+        const char* base = strrchr(name, '\\');
+        snprintf(out, size, "%s+0x%llx", base ? base + 1 : name,
+                 (unsigned long long)((uintptr_t)address - (uintptr_t)module));
+    } else {
+        snprintf(out, size, "0x%llx", (unsigned long long)(uintptr_t)address);
+    }
+}
+
+// Runs on the crashing thread. Written in steps, so the basic facts are saved even if the game's
+// own state is too damaged to read the level.
+static LONG WINAPI jkRpg_OnCrash(EXCEPTION_POINTERS* info)
+{
+    static volatile LONG once;
+    if (InterlockedExchange(&once, 1)) return EXCEPTION_CONTINUE_SEARCH;
+    char line[512], where[MAX_PATH + 32];
+    SYSTEMTIME t;
+    GetLocalTime(&t);
+    CreateDirectoryA(RPG_CRASH_DIR, NULL);
+    jkRpg_CrashAddress(where, sizeof(where), info->ExceptionRecord->ExceptionAddress);
+    snprintf(line, sizeof(line), "%04d-%02d-%02d %02d:%02d:%02d crash 0x%08lx at %s, build %s\n",
+             t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond,
+             (unsigned long)info->ExceptionRecord->ExceptionCode, where, openjkdf2_aReleaseCommitShort);
+    jkRpg_CrashAppend(line);
+
+    void* frames[RPG_CRASH_FRAMES];
+    USHORT count = RtlCaptureStackBackTrace(0, RPG_CRASH_FRAMES, frames, NULL);
+    jkRpg_CrashAppend("  calls:");
+    for (USHORT i = 0; i < count; i++) {
+        jkRpg_CrashAddress(where, sizeof(where), frames[i]);
+        snprintf(line, sizeof(line), " %s", where);
+        jkRpg_CrashAppend(line);
+    }
+    jkRpg_CrashAppend("\n");
+
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    SithThing* player = sithPlayer_g_pLocalPlayerThing;
+    if (world) {
+        snprintf(line, sizeof(line), "  level %.31s", world->map_jkl_fname);
+        jkRpg_CrashAppend(line);
+        if (player) {
+            snprintf(line, sizeof(line), ", player at %.2f %.2f %.2f", player->position.x, player->position.y,
+                     player->position.z);
+            jkRpg_CrashAppend(line);
+        }
+    } else {
+        jkRpg_CrashAppend("  no level loaded");
+    }
+    jkRpg_CrashAppend("\n");
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+// Keep the log small: past its limit, only the newest half (from a whole line) is kept.
+static void jkRpg_TrimCrashLog(void)
+{
+    FILE* f = fopen(RPG_CRASH_LOG, "rb");
+    if (!f) return;
+    static char tail[RPG_CRASH_LOG_MAX / 2];
+    size_t kept = 0;
+    if (fseek(f, 0, SEEK_END) == 0 && ftell(f) > RPG_CRASH_LOG_MAX
+        && fseek(f, -(long)sizeof(tail), SEEK_END) == 0)
+        kept = fread(tail, 1, sizeof(tail), f);
+    fclose(f);
+    if (!kept) return;
+    char* start = memchr(tail, '\n', kept);
+    start = start ? start + 1 : tail;
+    f = fopen(RPG_CRASH_LOG, "wb");
+    if (!f) return;
+    fwrite(start, 1, kept - (start - tail), f);
+    fclose(f);
+}
+
+void jkRpg_InstallCrashNotes(void)
+{
+    jkRpg_TrimCrashLog();
+    SetUnhandledExceptionFilter(jkRpg_OnCrash);
+#ifdef RPG_DEVELOPMENT_REPORTS
+    // Development builds only: JKRPG_CRASH_TEST=1 in the environment crashes on purpose at startup,
+    // to check the crash note (DEVELOPING.md "Crash notes").
+    const char* test = getenv("JKRPG_CRASH_TEST");
+    if (test && !strcmp(test, "1"))
+    {
+        int* volatile nowhere = NULL;
+        *nowhere = 1;
+    }
+#endif
+}
+
+#else
+void jkRpg_InstallCrashNotes(void) {}
+#endif
