+// A script's own copy of one of its variables, found by name in the script's symbol table.
+static SithCogSymbol* jkRpg_CogVariable(sithCog* pCog, const char* name)
+{
+    if (!pCog || !pCog->pScript || !pCog->pScript->pSymbolTable || !pCog->pSymbolTable)
+        return NULL;
+    SithCogSymbolTable* script = pCog->pScript->pSymbolTable;
+    SithCogSymbol* symbol = sithCogParse_GetSymbol(script, (char*)name);
+    if (!symbol || symbol < script->aSymbols || symbol >= script->aSymbols + script->numUsedSymbols)
+        return NULL;
+    return &pCog->pSymbolTable->aSymbols[symbol - script->aSymbols];
+}
