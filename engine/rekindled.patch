+
+// Skill and item upgrade effects that run every frame while the game runs, in game time.
+static void jkRpg_SkillsTick(SithThing* p, flex_t deltaSecs)
+{
+    if (deltaSecs <= 0)
+        return;
+    flex_t cooldown = sithInventory_GetInventory(p, RPG_BIN_BACTACOOL);
+    if (cooldown > 0)
+        sithInventory_SetInventory(p, RPG_BIN_BACTACOOL, cooldown > deltaSecs ? cooldown - deltaSecs : 0);
+    int alive = p->actorParams.health > 0 && !(p->flags & SITH_TF_DEAD);
+    flex_t pending = sithInventory_GetInventory(p, RPG_BIN_BACTAHEAL);
+    if (pending > 0) {
+        flex_t step = alive ? jkRpg_LastingStep(pending, deltaSecs) : pending;
+        if (alive)
+            jkRpg_Heal(p, step);
+        sithInventory_SetInventory(p, RPG_BIN_BACTAHEAL, pending - step);
+    }
+    flex_t wait = sithInventory_GetInventory(p, RPG_BIN_REGENWAIT);
+    flex_t regenSecs = deltaSecs > wait ? deltaSecs - wait : 0;
+    if (wait > 0)
+        sithInventory_SetInventory(p, RPG_BIN_REGENWAIT, wait > deltaSecs ? wait - deltaSecs : 0);
+    if (alive && jkRpg_Rank(p, UP_HEALTH) >= 3)
+        jkRpg_Heal(p, RPG_REGEN_PER_SEC * regenSecs);
+}
+
+// Supply finder: while the field light is on and powered, small gold glints mark nearby
+// pickups the player can actually see. Like enemy sight, walls and closed doors block the glint, so
+// pickups behind walls, doors or in closed compartments stay hidden. The look follows
+// the twinkle the game's own pickups and Force effects use.
+#define RPG_FINDER_RANGE 2.5
+
+static int jkRpg_IsVisiblePickup(const SithThing* item)
+{
+    return item->type == SITH_THING_ITEM && item->sector
+        && !(item->flags & (SITH_TF_DISABLED | SITH_TF_10 | SITH_TF_DESTROYED))
+        && item->collide != SITH_COLLIDE_NONE
+        && item->pCog && item->pCog->pScript
+        && !(item->pCog->flags & SITH_COG_DISABLED)
+        && !__strnicmp(item->pCog->pScript->aName, "pow_", 4)
+        && item->renderData.type == RD_THING_MODEL3 && item->renderData.model3
+        && item->renderData.desiredGeoMode != RD_GEOMETRY_NONE
+        && item->sector->renderTick == sithRender_lastRenderTick
+        && item->renderFrame == jkPlayer_currentTickIdx;
+}
+
+static int jkRpg_CanSee(SithCamera* pCam, SithThing* pItem)
+{
+    rdVector3 dir;
+    rdVector_Sub3(&dir, &pItem->position, &pCam->lookPos);
+    flex_t distance = rdVector_Normalize3Acc(&dir);
+    if (distance <= 0)
+        return 1;
+    // A sight ray has no moving thing. Player collision callbacks shorten the search at
+    // nearby actors/pickups, which can leave walls farther along the ray untested.
+    sithCollision_SearchForCollisions(pCam->sector, NULL, &pCam->lookPos, &dir, distance, 0.0,
+                                      RAYCAST_100 | RAYCAST_2);
+    SithCollision* hit;
+    int visible = 1;
+    while ((hit = sithCollision_PopStack())) {
+        if ((hit->type & SITHCOLLISION_THING) && hit->pThingCollided
+            && (hit->pThingCollided == pItem || hit->pThingCollided == sithPlayer_g_pLocalPlayerThing))
+            continue; // Trace all the way to the centre, even if its pickup sphere protrudes through a wall.
+        visible = 0; // World surfaces, closed doors, scenery and intervening actors block sight.
+        break;
+    }
+    sithCollision_DecreaseStackLevel();
+    return visible;
+}
+
+static void jkRpg_DrawSupplyFinder(SithThing* p)
+{
+    SithCamera* pCam = sithCamera_g_pCurCamera;
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (jkRpg_Rank(p, UP_LIGHT) < 1 || !pCam || !pCam->sector || !pCam->rdCamera.pfProject || !world
+        || (p->flags & SITH_TF_DEAD) || sithInventory_GetInventory(p, SITHBIN_BATTERY) <= 0
+        || !sithInventory_IsInventoryActivated(p, SITHBIN_FIELDLIGHT))
+        return;
+    flex_t unit = (flex_t)Video_format.height / 480.0;
+    int thick = (int)(unit + 0.5) > 1 ? (int)(unit + 0.5) : 1;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* item = &world->aThings[i];
+        if (!jkRpg_IsVisiblePickup(item))
+            continue;
+        rdVector3 delta, view, screen;
+        rdVector_Sub3(&delta, &item->position, &pCam->lookPos);
+        flex_t distance = rdVector_Len3(&delta);
+        if (distance > RPG_FINDER_RANGE)
+            continue;
+        rdMatrix_TransformPoint34(&view, &item->position, &pCam->rdCamera.orient);
+        if (view.y < 0.05)
+            continue; // behind the camera
+        pCam->rdCamera.pfProject(&screen, &view);
+        if (screen.x < 0 || screen.y < 0 || screen.x >= Video_format.width || screen.y >= Video_format.height
+            || !jkRpg_CanSee(pCam, item))
+            continue;
+        // A slow twinkle, a little out of step per pickup; nearer pickups glint larger.
+        flex_t pulse = 0.5 + 0.5 * sin(sithTime_g_secGameTime * 3.0 + i * 1.7);
+        flex_t nearness = 1.0 - 0.5 * distance / RPG_FINDER_RANGE;
+        int arm = (int)(unit * (3.0 + 4.0 * pulse) * nearness + 0.5);
+        int cx = (int)screen.x, cy = (int)screen.y;
+        uint8_t alpha = (uint8_t)(110 + 120 * pulse);
+        jkRpg_Rect(cx - arm, cy - thick / 2, 2 * arm + thick, thick, 255, 214, 110, alpha);
+        jkRpg_Rect(cx - thick / 2, cy - arm, thick, 2 * arm + thick, 255, 214, 110, alpha);
+        jkRpg_Rect(cx - thick, cy - thick, 2 * thick, 2 * thick, 255, 250, 225, alpha);
+    }
+}
