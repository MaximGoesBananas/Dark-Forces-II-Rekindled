+// Fraction of the way to the next level, or -1 when the RPG HUD should not show.
+flex_t jkRpg_XpFraction(void)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!jkRpg_IsActive(p))
+        return -1.0;
+    int level = jkRpg_Get(p, RPG_BIN_LEVEL);
+    if (level < 1) level = 1;
+    if (level >= RPG_MAX_LEVEL)
+        return 1.0;
+    int lo = jkRpg_XpForLevel(level), hi = jkRpg_XpForLevel(level + 1);
+    flex_t frac = (flex_t)(jkRpg_Get(p, RPG_BIN_XP) - lo) / (flex_t)(hi - lo);
+    return frac < 0 ? 0 : (frac > 1 ? 1 : frac);
+}
