+// Only the original campaign's solid, one-sided windows need extra UV storage.
+// Reserve it through the surface loader so pooled and separate arrays share its lifetime.
+int jkRpg_IsGlassBackSurface(const SithWorld* world, int index)
+{
+    if (!world || Main_bMotsCompat || sithNet_isMulti) return 0;
+    if (!__strcmpi(world->map_jkl_fname, "10cargo.jkl"))
+        return index == 1748 || index == 1891 || index == 1904 || index == 2811;
+    if (!__strcmpi(world->map_jkl_fname, "12escape.jkl"))
+        return index == 2448 || index == 2460;
+    if (!__strcmpi(world->map_jkl_fname, "16aescapeship.jkl") || !__strcmpi(world->map_jkl_fname, "16bescapeship.jkl"))
+        return index == 5264;
+    if (!__strcmpi(world->map_jkl_fname, "19b.jkl"))
+        return index == 424 || index == 436 || index == 442 || index == 554;
+    return !__strcmpi(world->map_jkl_fname, "19a.jkl") && (index == 65 || index == 66 || index == 299 || index == 305 || index == 2669
+        || index == 5146 || index == 5158 || index == 5164 || index == 5262);
+}
+
+static void jkRpg_TextureGlassBacks(void)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (!world || jkRpg_glassPrepared) return;
+    jkRpg_glassPrepared = 1;
+    // These control-room panes have collision but no material on either side.
+    // Reuse each level's authored glass and UVs; the mirror pass fills their backs.
+    int cargoPane = !__strcmpi(world->map_jkl_fname, "12escape.jkl");
+    int descentPanes = !__strcmpi(world->map_jkl_fname, "19a.jkl");
+    int sourceIndex = cargoPane ? 3735 : 3337;
+    int firstPane = cargoPane ? 2448 : 65;
+    if ((cargoPane || descentPanes) && world->numSurfaces > sourceIndex)
+    for (int i = firstPane; i < firstPane + (cargoPane ? 1 : 2); i++) {
+        SithSurface* pane = &world->surfaces[i];
+        rdFace* face = &pane->surfaceInfo.face;
+        const rdFace* source = &world->surfaces[sourceIndex].surfaceInfo.face;
+        if (pane->pAdjoin && !(pane->pAdjoin->flags & SITHSURF_ADJOIN_ALLOW_MOVEMENT)
+            && source->material && !__strcmpi(source->material->mat_fpath, "00wglas2.mat")
+            && source->geometryMode == RD_GEOMETRY_FULL
+            && source->numVertices == 4 && face->numVertices == 4
+            && source->vertexUVIdx && face->vertexUVIdx
+            && (!face->material || face->material == source->material)) {
+            int v;
+            for (v = 0; v < 4; ++v) {
+                if (source->vertexUVIdx[(v + (cargoPane ? 2 : 0)) % 4] < 0) break;
+                face->vertexUVIdx[v] = source->vertexUVIdx[(v + (cargoPane ? 2 : 0)) % 4];
+            }
+            if (v == 4) {
+                face->material = source->material;
+                face->wallCel = source->wallCel;
+                face->texVertOffset = source->texVertOffset;
+                face->textureMode = source->textureMode;
+                face->geometryMode = RD_GEOMETRY_FULL;
+                face->type |= RD_FF_TEX_TRANSLUCENT;
+            }
+        }
+    }
+    // The lower angled window appears in both descent maps. Its left pane has
+    // an extra collinear vertex; reuse existing level UVs including that midpoint.
+    int descentExit = !__strcmpi(world->map_jkl_fname, "19b.jkl");
+    int lowerFronts[2] = {descentExit ? 424 : 5146, descentExit ? 554 : 5262};
+    const int lowerUV[2][2][5] = {
+        {{116, 267, 680, 3361, 676}, {676, 680, 267, 116, 0}},
+        {{33, 160, 1972, 1753, 1916}, {1916, 1972, 160, 33, 0}}
+    };
+    if ((descentPanes || descentExit) && world == sithWorld_g_pLastLoadedWorld
+        && world->numTexVertices > (descentExit ? 1972 : 3361)) {
+        rdMaterial* glass = sithMaterial_Load("00wglas2.mat", 0, 0);
+        if (glass && !__strcmpi(glass->mat_fpath, "00wglas2.mat"))
+        for (int n = 0; n < 2; ++n) {
+            if (lowerFronts[n] >= world->numSurfaces) continue;
+            SithSurface* pane = &world->surfaces[lowerFronts[n]];
+            rdFace* face = &pane->surfaceInfo.face;
+            int vertices = n ? 4 : 5;
+            if (!pane->pAdjoin || (pane->pAdjoin->flags & SITHSURF_ADJOIN_ALLOW_MOVEMENT)
+                || face->numVertices != vertices || !face->vertexUVIdx
+                || (face->material && face->material != glass)) continue;
+            for (int v = 0; v < vertices; ++v)
+                face->vertexUVIdx[v] = lowerUV[descentExit][n][v];
+            face->material = glass;
+            face->wallCel = 0;
+            memset(&face->texVertOffset, 0, sizeof(face->texVertOffset));
+            face->textureMode = 1;
+            face->geometryMode = RD_GEOMETRY_FULL;
+            face->type |= RD_FF_TEX_TRANSLUCENT;
+        }
+    }
+    for (int i = 0; i < world->numSurfaces; ++i) {
+        if (!jkRpg_IsGlassBackSurface(world, i)
+            || (cargoPane && i == 2448)
+            || (descentPanes && (i == 65 || i == 66))
+            || ((descentPanes || descentExit) && (i == lowerFronts[0] || i == lowerFronts[1]))) continue;
+        SithSurface* surface = &world->surfaces[i];
+        SithSurfaceAdjoin* adjoin = surface->pAdjoin;
+        if (!adjoin || (adjoin->flags & SITHSURF_ADJOIN_ALLOW_MOVEMENT)
+            || !adjoin->mirror || !adjoin->mirror->surface) continue;
+        rdFace* back = &surface->surfaceInfo.face;
+        const rdFace* front = &adjoin->mirror->surface->surfaceInfo.face;
+        // The escape ship's observation window has no inner texture and an opaque outer wall.
+        // Keep that authored outer wall; only the inside receives the game's glass material.
+        int escapeWindow = i == 5264 && (!__strcmpi(world->map_jkl_fname, "16aescapeship.jkl")
+            || !__strcmpi(world->map_jkl_fname, "16bescapeship.jkl"));
+        if (!front->material || __strcmpi(front->material->mat_fpath, escapeWindow ? "00_base3.mat" : "00wglas2.mat")
+            || front->geometryMode != RD_GEOMETRY_FULL
+            || !front->vertexUVIdx || !back->vertexUVIdx
+            || front->numVertices != back->numVertices) continue;
+        rdMaterial* glass = front->material;
+        if (escapeWindow) {
+            if (world != sithWorld_g_pLastLoadedWorld) continue;
+            glass = sithMaterial_Load("00wglas2.mat", 0, 0);
+            if (!glass || __strcmpi(glass->mat_fpath, "00wglas2.mat")) continue;
+        }
+        if (back->material && back->material != glass) continue;
+        // Opposite faces list the same world vertices in reverse order.
+        unsigned v;
+        for (v = 0; v < back->numVertices; ++v) {
+            unsigned j;
+            for (j = 0; j < front->numVertices; ++j)
+                if (back->vertexPosIdx[v] == front->vertexPosIdx[j]) break;
+            if (j == front->numVertices || front->vertexUVIdx[j] < 0) break;
+            back->vertexUVIdx[v] = front->vertexUVIdx[j];
+        }
+        if (v != back->numVertices) continue;
+        back->material = glass;
+        back->wallCel = escapeWindow ? 0 : front->wallCel;
+        back->texVertOffset = front->texVertOffset;
+        back->textureMode = front->textureMode;
+        back->geometryMode = RD_GEOMETRY_FULL;
+        back->type |= RD_FF_TEX_TRANSLUCENT;
+    }
+}
