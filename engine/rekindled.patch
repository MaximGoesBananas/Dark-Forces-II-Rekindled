+}
+
+void sithControl_SetMouseLook(flex_t sensitivity, int bInverted)
+{
+    if (!isfinite(sensitivity) || sensitivity <= 0)
+        return;
+    stdControlKeyInfoEntry* turn = sithControl_FindMouseEntry(INPUT_FUNC_TURN, AXIS_MOUSE_X);
+    if (!turn)
+        turn = sithControl_BindAxis(INPUT_FUNC_TURN, AXIS_MOUSE_X, INPUT_MAPPING_FLAG_AXIS_REVERSED | INPUT_MAPPING_FLAG_RAW_AXIS);
+    if (turn)
+        turn->binaryAxisVal = sensitivity;
+    stdControlKeyInfoEntry* pitch = sithControl_FindMouseEntry(INPUT_FUNC_PITCH, AXIS_MOUSE_Y);
+    if (!pitch)
+        pitch = sithControl_BindAxis(INPUT_FUNC_PITCH, AXIS_MOUSE_Y, INPUT_MAPPING_FLAG_AXIS_REVERSED | INPUT_MAPPING_FLAG_RAW_AXIS);
+    if (pitch)
+        pitch->binaryAxisVal = sensitivity;
+    sithControl_SetMouseInverted(bInverted);
+}
+
+void sithControl_SetMouseInverted(int bInverted)
+{
+    stdControlKeyInfoEntry* pitch = sithControl_FindMouseEntry(INPUT_FUNC_PITCH, AXIS_MOUSE_Y);
+    if (!pitch) {
+        pitch = sithControl_BindAxis(INPUT_FUNC_PITCH, AXIS_MOUSE_Y, INPUT_MAPPING_FLAG_AXIS_REVERSED | INPUT_MAPPING_FLAG_RAW_AXIS);
+        if (pitch) pitch->binaryAxisVal = sithControl_GetMouseSensitivity();
+    }
+    if (pitch) {
+        if (bInverted)
+            pitch->flags &= ~INPUT_MAPPING_FLAG_AXIS_REVERSED;
+        else
+            pitch->flags |= INPUT_MAPPING_FLAG_AXIS_REVERSED;
+    }
+}
