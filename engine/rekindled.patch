+// Menu sounds come from the player's own game files and play on private buffers, so they never
+// touch the level's sound list or the menu sound cache.
+static void jkRpg_PlaySound(int which)
+{
+    // Level-up: the multiplayer score fanfare; buy: an R2-D2 chirp; take back: R2-D2 complaining.
+    static const char* files[3] = {"score2.wav", "r2talk05.wav", "r2gethit01.wav"};
+    static stdSound_buffer_t* buffers[3];
+    static int bTried[3];
+    if (!bTried[which]) {
+        bTried[which] = 1;
+        buffers[which] = sithSound_InitFromPath((char*)files[which]);
+    }
+    if (!buffers[which])
+        return;
+    // Menu feedback plays at twice the effects volume (capped), so it stays clear over game audio.
+    flex_t volume = jkGuiSound_sfxVolume * 2.0;
+    stdSound_BufferReset(buffers[which]);
+    stdSound_BufferSetVolume(buffers[which], volume > 1.0 ? 1.0 : volume);
+    stdSound_BufferPlay(buffers[which], 0);
+}
