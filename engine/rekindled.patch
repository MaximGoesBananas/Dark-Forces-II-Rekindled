+
+// The shield script (item_shields.cog) receives each hit. Blast resistance gives it explosions in
+// shield points, so the same protection costs a quarter fewer shields; its answer converts back.
+// Without shields the hit passes unchanged. Stable protection replaces the script's weakening below
+// 50 shields for blaster fire and explosions: remaining shields absorb the hit fully, the rest reaches
+// health. Saber and other damage keep the script's rules.
+flex_t jkRpg_ShieldHit(sithCog* pCog, SithThing* p, int srcType, int srcIdx, flex_t damage, flex_t type)
+{
+    int rank = jkRpg_IsActive(p) ? jkRpg_Rank(p, UP_SHIELDS) : 0;
+    int covered = (int)type == SITH_DAMAGE_ENERGY || (int)type == SITH_DAMAGE_FIRE;
+    SithThing* pSource = srcType == SENDERTYPE_THING ? sithThing_GetThingByIndex(srcIdx) : NULL;
+    flex_t cost = jkRpg_ShieldCost(rank, covered && pSource && pSource->type == SITH_THING_EXPLOSION);
+    flex_t shields = sithInventory_GetInventory(p, SITHBIN_SHIELDS), units = damage * cost;
+    flex_t through = sithCog_SendMessageEx(pCog, SITH_MESSAGE_DAMAGED, SENDERTYPE_THING, p->idx, srcType, srcIdx, -1,
+                                           units, type, 0.0, 0.0);
+    if (rank >= 3 && covered && shields > 0) {
+        flex_t absorbed = units < shields ? units : shields;
+        sithInventory_SetInventory(p, SITHBIN_SHIELDS, shields - absorbed);
+        through = units - absorbed;
+    }
+    if (jkRpg_IsActive(p) && sithInventory_GetInventory(p, SITHBIN_SHIELDS) < shields)
+        sithInventory_SetInventory(p, RPG_BIN_REGENWAIT, RPG_REGEN_DELAY);
+    return through / cost;
+}
