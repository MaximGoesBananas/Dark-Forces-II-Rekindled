+// Keep smaller custom-map limits; these are carrying ceilings, not extra ammunition.
+static flex_t jkRpg_AmmoCapacity(int bin, flex_t original)
+{
+    flex_t cap;
+    switch (bin) {
+        case SITHBIN_ENERGY: cap = 200; break;
+        case SITHBIN_POWER: cap = 100; break;
+        case SITHBIN_RAILCHARGES: cap = 10; break;
+        case 4: case 8: cap = 10; break; // thermal detonators and sequencer mines
+        default: return original;
+    }
+    return original < cap ? original : cap;
+}
