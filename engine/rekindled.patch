+// What a level script's CreateThing makes: the template to create, or NULL for nothing.
+SithThing* jkRpg_ScriptCreate(sithCog* pCog, SithThing* pTemplate, SithThing* pAt)
+{
+    if (Main_bMotsCompat || sithNet_isMulti || !pCog || !pTemplate)
+        return pTemplate;
+    // The original replacement scripts bring killed enemies back without limit (missions 1, 2, 13
+    // and 17). 00_replaceenemy.cog keeps the one enemy it creates at startup; 14_oopstroop.cog
+    // only ever creates replacements.
+    if (jkRpg_IsScript(pCog, "14_oopstroop.cog")
+        || (jkRpg_IsScript(pCog, "00_replaceenemy.cog") && pCog->trigId != SITH_MESSAGE_STARTUP))
+        return NULL;
+    // That one mission 1 crate bursts like a small fuel tank, so shooting it takes out the brawler
+    // beside it; the neighbouring crates' own small blasts set it off too.
+    if (jkRpg_IsScript(pCog, "actor_cr.cog") && !__strcmpi(pTemplate->aName, "+crate_exp") && jkRpg_IsExplosiveCrate(pAt)) {
+        SithThing* blast = sithTemplate_GetTemplate("+xtank1_exp");
+        if (blast) return blast;
+    }
+    return pTemplate;
+}
