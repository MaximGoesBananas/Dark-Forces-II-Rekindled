+// Fixed Valley guards are authored additions, not replacements. Their per-map counter survives saves.
+static void jkRpg_AddValleyTroopers(SithThing* player)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    int temple = !__strcmpi(world->map_jkl_fname, "19b.jkl");
+    if (!temple && __strcmpi(world->map_jkl_fname, "18ascend.jkl")) return;
+    int total = temple ? 7 : 10;
+    int added = jkRpg_Get(player, RPG_BIN_STARTAMMO);
+    if (added >= total) return;
+    int actors = 0, freeThings = 0;
+    for (int i = 0; i < world->numThingsLoaded; i++) {
+        actors += world->aThings[i].actor != NULL;
+        freeThings += world->aThings[i].type == 0;
+    }
+    static const rdVector3 spots[10] = {
+        {-0.9, -6.5, 9.72}, {0.1, -6.6, 9.72}, {1.2, -6.1, 9.72},
+        {0.7, -5.5, 9.72}, {1.2, -4.9, 9.72}, {-0.4, -4.8, 9.72},
+        {-0.8, 6.3, 9.72}, {0.1, 6.5, 9.72}, {0.7, 5.8, 9.72}, {0.6, 4.9, 9.72}
+    };
+    static const rdVector3 templeSpots[7] = {
+        {-1.75, -0.8, -23.4284}, {-1.45, -1.45, -23.4284}, {-1.8, -1.2, -23.4284},
+        {2.45, -0.35, -24.3784}, {2.1, -0.85, -24.3792},
+        {-0.9, -2.41, -24.8755}, {-0.4, -2.41, -24.8755}
+    };
+    static const char* templeTypes[7] = {
+        "stormtroop2", "stormtroop2", "stormtroop3", "stormtroop4", "icommando",
+        "icommandorpt", "icommandorpt"
+    };
+    for (; added < total && actors < SITHAI_MAX_ACTORS - 32 && freeThings > 32; added++) {
+        SithThing* tpl = sithTemplate_GetTemplate(temple ? templeTypes[added] : "stormtroop2");
+        if (!tpl) return;
+        rdVector3 pos = temple ? templeSpots[added] : spots[added];
+        SithThing anchor = {0};
+        anchor.position = pos;
+        anchor.sector = sithSector_FindSectorAtPos(world, &pos);
+        if (!anchor.sector) return;
+        SithSector* sector = jkRpg_CrowdPosition(&anchor, tpl, &pos, temple ? 0 : 0.14);
+        // Existing saves may leave a body at an authored spot. Try nearby clear floor.
+        static const rdVector3 offsets[] = {{0.3,0,0},{-0.3,0,0},{0,0.3,0},{0,-0.3,0},
+            {0.3,0.3,0},{-0.3,0.3,0},{0.3,-0.3,0},{-0.3,-0.3,0}};
+        for (int attempt = 0; temple && !sector && attempt < 8; ++attempt) {
+            pos = templeSpots[added];
+            pos.x += offsets[attempt].x; pos.y += offsets[attempt].y;
+            sector = jkRpg_CrowdPosition(&anchor, tpl, &pos, temple ? 0 : 0.14);
+        }
+        if (!sector) return;
+        rdVector3 rotation = {0, temple ? (added >= 5 ? -90 : added >= 3 ? 180 : 0) : 90, 0};
+        rdMatrix34 orient;
+        rdMatrix_BuildRotate34(&orient, &rotation);
+        SithThing* trooper = sithThing_CreateThingAtPos(tpl, &pos, &orient, sector, NULL);
+        if (!trooper) return;
+        sithInventory_SetInventory(player, RPG_BIN_STARTAMMO, added + 1);
+        actors++; freeThings--;
+        stdPlatform_Printf("RPG valley guard: %d guid=%d sector=%d %.4f %.4f %.4f\n",
+            added + 1, trooper->guid, sector->id, pos.x, pos.y, pos.z);
+    }
+}
