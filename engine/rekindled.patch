+// Enemies on the mod's single (Medium) difficulty notice the player and fire their first shot
+// sooner: reactions take 60% of the original time. Direct-fire accuracy closes 75% of the
+// gap to always. Hostile direct fire, bursts included, comes 40% more often (smaller hits come
+// from the campaign phases in jkRpg_ModifyDamage). Melee, grenade throws, turrets and enemy health are unchanged;
+// lobbed throws retain their original aim.
+#define RPG_AI_REACTION 0.6
+#define RPG_AI_FIRE_RATE 1.4     // hostile ranged primary fire: shots or bursts this much more often
+#define RPG_AI_ACCURACY 0.75
+#define RPG_AI_MELEE_SPEED 1.1   // enemies that can only fight up close move this much faster
+#define RPG_AI_MELEE_REACH 0.5   // a primary attack reaching no farther than this is melee
+
+void jkRpg_TuneAIClass(SithAIClass* pClass, const char* path)
+{
+    if (!pClass || sithNet_isMulti || Main_bMotsCompat)
+        return;
+    const char* name = path ? path : "";
+    for (const char* p = name; *p; p++)
+        if (*p == '/' || *p == '\\') name = p + 1;
+    int concussion = !__strcmpi(name, "bodefault.ai") || !__strcmpi(name, "bosentry.ai");
+    pClass->accurancy += (1.0 - pClass->accurancy) * RPG_AI_ACCURACY;
+    for (int i = 0; i < pClass->numEntries && i < 16; i++) {
+        SithAIInstinct* entry = &pClass->entries[i];
+        if (entry->func == (sithAICommandFunc_t)sithAICmd_PrimaryFire && pClass->alignment < 0
+            && entry->fltArg[2] > RPG_AI_MELEE_REACH) {
+            // Concussion gunners need time between blasts, including their sentry variant.
+            // PrimaryFire varies this base by +/-20%, giving a 2.8-4.2 second pause.
+            entry->fltArg[0] = concussion ? 3500.0 : entry->fltArg[0] / RPG_AI_FIRE_RATE;
+            entry->intArg[0] = (int32_t)entry->fltArg[0];
+            entry->fltArg[9] /= RPG_AI_FIRE_RATE; // and between the shots of a burst
+            entry->intArg[9] = (int32_t)entry->fltArg[9];
+        }
+        int slot = entry->func == (sithAICommandFunc_t)sithAICmd_LookForTarget ? 0  // how often it looks for the player
+                 : entry->func == (sithAICommandFunc_t)sithAICmd_PrimaryFire ? 5     // delay before the first shot
+                 : -1;
+        if (slot < 0)
+            continue;
+        entry->fltArg[slot] *= RPG_AI_REACTION;
+        entry->intArg[slot] = (int32_t)entry->fltArg[slot];
+    }
+}
+
+// Share of perfectly aimed shots. Thrown grenades and probe droids keep the original game's aim:
+// lobbed throws already land too well with it, and a probe droid's bolt hits two and a half
+// times as hard as a stormtrooper's, so the better aim turned them into snipers.
+flex_t jkRpg_AIAccuracy(SithAIClass* pClass, SithThing* pShooter, int bLobbed)
+{
+    int original = bLobbed || (pShooter && pShooter->pTemplate && !__strcmpi(pShooter->pTemplate->aName, "probedroid"));
+    if (!original || sithNet_isMulti || Main_bMotsCompat)
+        return pClass->accurancy;
+    return (pClass->accurancy - RPG_AI_ACCURACY) / (1.0 - RPG_AI_ACCURACY); // undo jkRpg_TuneAIClass
+}
+
+// Shorten ordinary saber decision delays for the later duelists. Swing recovery,
+// hit reach and damage stay separate, so this cannot interrupt an active attack.
+int jkRpg_BossReactionMs(const SithThing* thing)
+{
+    if (!sithNet_isMulti && !Main_bMotsCompat && thing && thing->pTemplate) {
+        const char* name = thing->pTemplate->aName;
+        if (!__strcmpi(name, "sariss"))
+            return 250;
+        if (!__strcmpi(name, "boc") || !__strcmpi(name, "jerec"))
+            return 375;
+    }
+    return 500;
+}
+
+// Hostile classes whose only attack is a short-range primary attack (no ranged, lobbed, blind or
+// turret fire) move faster, so they can catch up with the player.
+flex_t jkRpg_AIMoveScale(SithAIClass* pClass, const SithThing* thing)
+{
+    if (!pClass || sithNet_isMulti || Main_bMotsCompat || pClass->alignment >= 0)
+        return 1.0;
+    // Scale current pursuit, including loaded saves; never multiply saved movement stats.
+    if (thing && thing->pTemplate) {
+        if (!__strcmpi(thing->pTemplate->aName, "sariss")) return 1.3 * 1.25;
+        if (!__strcmpi(thing->pTemplate->aName, "maw")) return 1.1;
+    }
+    int melee = 0;
+    for (int i = 0; i < pClass->numEntries && i < 16; i++) {
+        sithAICommandFunc_t func = pClass->entries[i].func;
+        if (func == (sithAICommandFunc_t)sithAICmd_PrimaryFire) {
+            if (pClass->entries[i].fltArg[2] > RPG_AI_MELEE_REACH)
+                return 1.0;
+            melee = 1;
+        }
+        else if (func == (sithAICommandFunc_t)sithAICmd_BlindFire || func == (sithAICommandFunc_t)sithAICmd_LobFire
+                 || func == (sithAICommandFunc_t)sithAICmd_TurretFire)
+            return 1.0;
+    }
+    return melee ? RPG_AI_MELEE_SPEED : 1.0;
+}
+
+static int jkRpg_IsOrdinaryGunman(SithThing* thing)
+{
+    if (!thing || !thing->pCog || !thing->pCog->pScript)
+        return 0;
+    const char* script = thing->pCog->pScript->aName;
+    const char* gunmen[] = {"actor_st.cog", "actor_s2.cog", "actor_s3.cog",
+        "actor_tk.cog", "actor_tb.cog", "actor_rb.cog", "actor_ry.cog", "actor_bs.cog"};
+    for (size_t i = 0; i < sizeof(gunmen) / sizeof(gunmen[0]); i++) {
+        if (!__strcmpi(script, gunmen[i]))
+            return 1;
+    }
+    return 0;
+}
+
+// Rodian brawlers and Gamorreans: the ordinary enemies that only fight up close.
+static int jkRpg_IsOrdinaryBrawler(SithThing* thing)
+{
+    if (!thing || !thing->pCog || !thing->pCog->pScript)
+        return 0;
+    const char* script = thing->pCog->pScript->aName;
+    return !__strcmpi(script, "actor_rf.cog") || !__strcmpi(script, "actor_gg.cog");
+}
+
+// Ordinary brawlers back out from directly beneath an unreachable ledge. Follow's
+// unused parameters persist with its existing save state: param1 = stalled since,
+// param2 = backing off. Never set FLEEING: these classes have no Flee instinct.
+int jkRpg_MeleeRetreat(SithAIControlBlock* actor, SithAIInstinctState* state, int event)
+{
+    SithThing* player = sithPlayer_g_pLocalPlayerThing;
+    SithThing* thing = actor->thing;
+    if (Main_bMotsCompat || !jkRpg_IsActive(player) || !actor->pClass
+        || actor->pMoveThing != player || actor->pDistractor != player
+        || !(actor->flags & SITHAI_MODE_ATTACKING)
+        || (actor->flags & (SITHAI_MODE_FLEEING | SITHAI_MODE_DISABLED))
+        || !jkRpg_IsOrdinaryBrawler(thing) || jkRpg_AIMoveScale(actor->pClass, actor->thing) <= 1.0
+        || thing->moveType != SITH_MT_PHYSICS || !thing->attach_flags || !player->attach_flags
+        || !thing->sector || !player->sector
+        || (thing->flags & (SITH_TF_DEAD | SITH_TF_DESTROYED | SITH_TF_DISABLED | SITH_TF_WATER))
+        || (player->flags & (SITH_TF_DEAD | SITH_TF_DESTROYED | SITH_TF_WATER))
+        || (thing->physicsParams.flags & SITH_PF_FLY)
+        || (thing->actorParams.flags & (SITH_AF_BOSS | SITH_AF_CONTROLSDISABLED))) {
+        state->param1 = state->param2 = 0;
+        return 0;
+    }
+    flex_t reach = 0;
+    for (int i = 0; i < actor->pClass->numEntries && i < 16; i++)
+        if (actor->pClass->entries[i].func == (sithAICommandFunc_t)sithAICmd_PrimaryFire)
+            reach = fmax(reach, actor->pClass->entries[i].fltArg[2]);
+    rdVector3 away = {thing->position.x - player->position.x,
+        thing->position.y - player->position.y, 0};
+    flex_t distanceSq = away.x*away.x + away.y*away.y;
+    if (player->position.z - thing->position.z <= fmax(0.35, reach + actor->pClass->maxStep)
+        || distanceSq > (state->param2 ? 9.0 : 0.25)) {
+        state->param1 = state->param2 = 0;
+        return 0;
+    }
+    if (state->param2) {
+        // Keep the chosen retreat, then wait facing the ledge instead of charging
+        // straight back under it. A reachable or departing player ends this above.
+        state->nextUpdate = sithTime_g_msecGameTime + 250;
+        if (!(actor->flags & SITHAI_MODE_MOVING)) sithAI_SetLookFrame(actor, &player->position);
+        return 1;
+    }
+    if (event) return 0;
+    flex_t vx = thing->physicsParams.vel.x, vy = thing->physicsParams.vel.y;
+    if (vx*vx + vy*vy > 0.0004) { // Still approaching/climbing: retain normal pursuit.
+        state->param1 = 0;
+        return 0;
+    }
+    flex_t now = sithTime_g_secGameTime;
+    if (!state->param1 || now < state->param1) {
+        state->param1 = now + 0.001;
+        return 0;
+    }
+    if (now - state->param1 < 2.0) return 0;
+    if (rdVector_Normalize3Acc(&away) < 0.001) {
+        away.x = -thing->orient.lvec.x;
+        away.y = -thing->orient.lvec.y;
+        away.z = 0;
+        if (rdVector_Normalize3Acc(&away) < 0.001) away.x = 1;
+    }
+    const flex_t angles[] = {0, 45, -45, 90, -90, 135, -135, 180};
+    flex_t minimumSeparation = sqrt(distanceSq) + 0.2;
+    const flex_t distances[] = {1.2, 0.6, 0.4};
+    for (int length = 0; length < 3; length++) {
+        flex_t distance = distances[length];
+        for (int direction = 0; direction < 12; direction++) {
+            rdVector3 step;
+            if (direction < 8) {
+                flex_t radians = angles[direction] * M_PI / 180.0;
+                step = (rdVector3){away.x*cos(radians) - away.y*sin(radians),
+                    away.x*sin(radians) + away.y*cos(radians), 0};
+            }
+            else {
+                // Exact tangents can leave a tight axis-aligned lane where even
+                // a slightly diagonal route immediately touches a side wall.
+                const rdVector3 cardinal[] = {{1,0,0}, {-1,0,0}, {0,1,0}, {0,-1,0}};
+                step = cardinal[direction - 8];
+            }
+            rdVector3 destination = thing->position;
+            rdVector_ScaleAdd3Acc(&destination, &step, distance);
+            flex_t px = destination.x - player->position.x, py = destination.y - player->position.y;
+            if (px*px + py*py < minimumSeparation*minimumSeparation) continue;
+            if (!jkRpg_CrowdPath(thing, thing->sector, &thing->position, &destination, thing->moveSize)) continue;
+            // Check the floor along the whole route, not just across a gap at its end.
+            int safe = 1;
+            for (int sample = 1; sample <= 6; sample++) {
+                rdVector3 point = thing->position;
+                rdVector_ScaleAdd3Acc(&point, &step, distance * sample / 6.0);
+                if (sithAI_CanWalk(actor, &point, NULL) != 1) { safe = 0; break; }
+            }
+            if (!safe) continue;
+            sithAI_SetMoveThing(actor, &destination, 2.5);
+            sithAI_SetLookFrame(actor, &destination);
+            state->param2 = 1;
+            state->nextUpdate = sithTime_g_msecGameTime + 250;
+            return 1;
+        }
+    }
+    state->param1 = now; // No safe exit: retry after another bounded wait.
+    return 0;
+}
+
+// Calm ordinary gunmen and brawlers notice the player at half range. Once alerted by hearing,
+// damage or a scripted fire target, retain the original combat and pursuit range.
+flex_t jkRpg_NoticeDistance(SithAIControlBlock* actor)
+{
+    flex_t distance = actor->pClass->sightDistance;
+    if (Main_bMotsCompat || !jkRpg_IsActive(sithPlayer_g_pLocalPlayerThing)
+        || actor->pDistractor != sithPlayer_g_pLocalPlayerThing
+        || actor->pClass->alignment >= 0
+        || !(actor->flags & SITHAI_MODE_SEARCHING)
+        || (actor->flags & (SITHAI_MODE_ACTIVE | SITHAI_MODE_ATTACKING | SITHAI_MODE_TOUGHSKIN)))
+        return distance;
+    for (int i = 0; i < actor->pClass->numEntries && i < 16; i++) {
+        if (actor->pClass->entries[i].func == (sithAICommandFunc_t)sithAICmd_Listen
+            && actor->aInstinctStates[i].param0 > 0)
+            return distance;
+    }
+    return jkRpg_IsOrdinaryGunman(actor->thing) || jkRpg_IsOrdinaryBrawler(actor->thing) ? distance * 0.5 : distance;
+}
+
+// Resolve the projectile/explosion owner before the normal Listen damage response.
+// Only ordinary hostile gunmen may acquire the player this way; explicit script targets stay put.
+SithThing* jkRpg_RetaliationTarget(SithAIControlBlock* actor, SithThing* source)
+{
+    if (Main_bMotsCompat || !jkRpg_IsActive(sithPlayer_g_pLocalPlayerThing)
+        || !actor || !actor->pClass || actor->pClass->alignment >= 0 || !source
+        || !(actor->flags & SITHAI_MODE_SEARCHING)
+        || (actor->flags & SITHAI_MODE_TOUGHSKIN)
+        || !jkRpg_IsOrdinaryGunman(actor->thing))
+        return NULL;
+    SithThing* attacker = sithThing_GetThingParent(source);
+    return attacker == sithPlayer_g_pLocalPlayerThing ? attacker : NULL;
+}
+
+// Timed saves use gameplay time and run after world simulation/COGs.
+static int jkRpg_autosaveMinutes = -1;
+static SithWorld* jkRpg_autosaveWorld;
+static SithThing* jkRpg_autosavePlayer;
+static flex_t jkRpg_autosaveLastTick, jkRpg_autosaveDue;
+
+static void jkRpg_ResetAutosave(void)
+{
+    jkRpg_autosaveWorld = NULL;
+}
+
+int jkRpg_GetAutosaveMinutes(void)
+{
+    if (jkRpg_autosaveMinutes < 0) {
+        jkRpg_autosaveMinutes = wuRegistry_GetInt("rpgAutosaveMinutes", 5);
+        if (jkRpg_autosaveMinutes < 0) jkRpg_autosaveMinutes = 0;
+        if (jkRpg_autosaveMinutes > 15) jkRpg_autosaveMinutes = 15;
+    }
+    return jkRpg_autosaveMinutes;
+}
+
+void jkRpg_SetAutosaveMinutes(int minutes)
+{
+    if (minutes < 0) minutes = 0;
+    if (minutes > 15) minutes = 15;
+    if (minutes != jkRpg_GetAutosaveMinutes()) jkRpg_ResetAutosave();
+    jkRpg_autosaveMinutes = minutes;
+    wuRegistry_SaveInt("rpgAutosaveMinutes", minutes);
+}
+
+void jkRpg_AutosaveTick(void)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    int minutes = jkRpg_GetAutosaveMinutes();
+    if (!minutes || !world || Main_bMotsCompat || !jkRpg_IsActive(p)) {
+        jkRpg_ResetAutosave();
+        return;
+    }
+    flex_t now = sithTime_g_secGameTime;
+    if (world != jkRpg_autosaveWorld || p != jkRpg_autosavePlayer
+        || now < jkRpg_autosaveLastTick) {
+        jkRpg_autosaveWorld = world;
+        jkRpg_autosavePlayer = p;
+        jkRpg_autosaveDue = now + minutes * 60;
+    }
+    jkRpg_autosaveLastTick = now;
+    // These states cannot produce a playable snapshot. Keep an overdue deadline
+    // so saving resumes immediately when normal gameplay returns.
+    if (now < jkRpg_autosaveDue || sithMain_bEndLevel || g_sithMode == 2
+        || (g_submodeFlags & 1) || jkRpg_bMenuOpen || sithGamesave_state != SITH_GS_NONE
+        || (p->flags & (SITH_TF_DEAD | SITH_TF_DESTROYED | SITH_TF_DISABLED))
+        || (p->actorParams.flags & SITH_AF_CONTROLSDISABLED)
+        || p->actorParams.health <= 0 || !p->sector)
+        return;
+    if (sithGamesave_Autosave()) {
+        jkRpg_autosaveDue = now + minutes * 60;
+        sithConsole_PrintString("Autosaved.");
+    }
+    else {
+        jkRpg_autosaveDue = now + 30;
+        sithConsole_PrintString("Autosave failed. Will retry shortly.");
+    }
+}
+
+// Level and load events. A freed world's memory can be reused by the next one, so its address
+// never identifies a new level; these counters and flags do.
+static int jkRpg_glassPrepared;
+static int jkRpg_worldGen;       // worlds freed so far
+static int jkRpg_bRestoring;     // a save is being read
+static int jkRpg_bWorldFromSave; // the current world came from a save, not a fresh level start
+static flex_t jkRpg_aLeftover[SITHBIN_NUMBINS]; // fractional ammo pickups carried to the next pickup
+static void jkRpg_ResetSession(void);
+
+// Saves made before a bin existed do not contain it; clear these before a save loads so such a
+// save reads 0 instead of keeping the value from the session it was loaded in. The player's
+// inventory outlives a closed world (player 0 is never re-initialised), so clear it there too.
+void jkRpg_OnRestoreStart(void)
+{
+    jkRpg_bRestoring = 1;
+    jkRpg_bWorldFromSave = 1;
+    jkRpg_ResetSession();
+    jkRpg_ResetAutosave();
+    jkRpg_bRestorePedCount = 1;
+    jkRpg_crowdTrimStarted = 0;
+    if (Main_bMotsCompat || sithNet_isMulti)
+        return;
+    static const int bins[] = {RPG_BIN_DATAVER, RPG_BIN_LIGHTGAP, RPG_BIN_CROWDS, RPG_BIN_STARTAMMO,
+                               RPG_BIN_CROWDFIX, RPG_BIN_PEDFIX, RPG_BIN_BACTACOOL, RPG_BIN_BACTAHEAL, RPG_BIN_REGENWAIT};
+    for (int i = 0; i < (int)(sizeof(bins) / sizeof(bins[0])); i++)
+        jkPlayer_playerInfos[0].aItems[bins[i]].amount = 0;
+}
+
+void jkRpg_OnRestoreEnd(void)
+{
+    jkRpg_bRestoring = 0;
+}
+
+// sithWorld_FreeEntry: the level is over (or a save of another level is replacing it).
+void jkRpg_OnWorldFreed(void)
+{
+    jkRpg_worldGen++;
+    if (!jkRpg_bRestoring)
+        jkRpg_bWorldFromSave = 0;
+    jkRpg_ResetSession();
+}
+
+// Balance updates retain purchases and locks; a replaced tier refunds only its point.
+// Only the obsolete five-rank layout needs its historical conversion/refund.
+static void jkRpg_Migrate(SithThing* p)
+{
+    if (jkRpg_Get(p, RPG_BIN_DATAVER) >= RPG_DATA_VERSION)
+        return;
+    sithInventory_SetInventory(p, RPG_BIN_LIGHTGAP, 0);
+    if (jkRpg_Get(p, RPG_BIN_DATAVER) >= 4) {
+        if (jkRpg_Rank(p, UP_LIGHT) >= 2) {
+            sithInventory_SetInventory(p, RPG_BIN_LIGHTGAP, 1);
+            sithInventory_ChangeInventory(p, RPG_BIN_POINTS, 1);
+            jkRpg_Print("An upgrade point has been returned. %s", jkRpg_MenuHint());
+        }
+        sithInventory_SetInventory(p, RPG_BIN_DATAVER, RPG_DATA_VERSION);
+        return;
+    }
+    int refund = 0, found = jkRpg_Get(p, RPG_BIN_FOUND);
+    for (int slot = 0; slot < RPG_SLOTS; slot++) {
+        int rank = jkRpg_Get(p, RPG_BIN_RANK0 + slot);
+        refund += rank;
+        // Version 3 kept weapon upgrades in slots 11-18 for weapons 3-10: those weapons were found.
+        for (int up = 0; up < UP_COUNT; up++)
+            if (jkRpg_Get(p, RPG_BIN_DATAVER) < 4 && rank > 0 && slot >= 11 && jkRpg_aUpgrades[up].weapon == slot - 8)
+                found |= 1 << up;
+        sithInventory_SetInventory(p, RPG_BIN_RANK0 + slot, 0);
+        sithInventory_SetInventory(p, RPG_BIN_MISSION0 + slot, 0);
+    }
+    sithInventory_SetInventory(p, RPG_BIN_FOUND, found);
+    sithInventory_SetInventory(p, RPG_BIN_DATAVER, RPG_DATA_VERSION);
+    jkRpg_ApplyStats(p);
+    if (p->actorParams.health > p->actorParams.maxHealth)
+        p->actorParams.health = p->actorParams.maxHealth;
+    int bins[] = {SITHBIN_SHIELDS, SITHBIN_FORCEMANA, SITHBIN_ENERGY, SITHBIN_POWER, SITHBIN_RAILCHARGES, 4, 8};
+    for (size_t i = 0; i < sizeof(bins) / sizeof(bins[0]); i++)
+        if (sithInventory_GetInventory(p, bins[i]) > sithInventory_g_aTypes[bins[i]].max)
+            sithInventory_SetInventory(p, bins[i], sithInventory_g_aTypes[bins[i]].max);
+    if (refund > 0) {
+        sithInventory_ChangeInventory(p, RPG_BIN_POINTS, refund);
+        jkRpg_Print("The RPG mod was updated: your %d upgrade points are back. %s", refund, jkRpg_MenuHint());
+    }
+}
+
+// ---- Skill and item upgrade values. Plain arithmetic, checked by tools/test_skill_upgrades.py. ----
+#define RPG_LOW_SHARE        0.25  // "badly hurt" or "running low": strictly below a quarter of the maximum
+#define RPG_BACTA_COOLDOWN   10.0  // Emergency treatment, game seconds from a successful use
+#define RPG_BACTA_LASTING    20.0  // Lasting recovery: extra health ...
+#define RPG_BACTA_SECONDS    6.0   // ... over this many seconds
+#define RPG_BASE_SPEED       (1.0 / 1.15) // about 13% slower; Quick feet restores the original speed
+#define RPG_GRIP_SPEED       0.85  // Grip boots: share of top running speed when the controls are released
+#define RPG_GRIP_DRAG        2.0   // Grip boots: roughly halves the stopping time
+#define RPG_PUSH_SCALE       0.5   // Stand firm
+#define RPG_LETHAL_LANDING   100.0 // landings this hard took the original full health; Safer landings leaves them
+
+static int jkRpg_IsLow(flex_t amount, flex_t max) { return amount < max * RPG_LOW_SHARE; }
+
+// Health: 100, 125, then 150 maximum; the third upgrade adds regeneration instead.
+static flex_t jkRpg_MaxHealthBonus(int rank) { return 25.0 * (rank < 2 ? rank : 2); }
+
+// Share of the original pickup amount. Ammo: 75%, 100% with Better scavenging; Emergency supplies and
+// Weapon salvage each add 25% of the original amount (added, not multiplied).
+static flex_t jkRpg_AmmoShare(int rank, int low, int salvage)
+{
+    return (rank >= 3 ? 1.0 : 0.75) + (rank >= 1 && low ? 0.25 : 0.0) + (rank >= 2 && salvage ? 0.25 : 0.0);
+}
+
+// Health packs: 15, 18 then 20 of the original 20; Emergency care adds 5 when badly hurt.
+static flex_t jkRpg_HealthPackShare(int rank, int low)
+{
+    return (rank >= 3 ? 1.0 : rank >= 2 ? 0.9 : 0.75) + (rank >= 1 && low ? 0.25 : 0.0);
+}
+
+static flex_t jkRpg_ShieldPackShare(int rank) { return rank >= 2 ? 0.9 : 0.6; } // 12, then 18 of 20 shields
+static flex_t jkRpg_BactaShare(int rank) { return rank >= 1 ? 1.0 : 0.6; }      // 18, then 30 of 30 health
+
+// Blast resistance: explosions cost a quarter fewer shields for the same protection.
+static flex_t jkRpg_ShieldCost(int rank, int explosion) { return rank >= 1 && explosion ? 0.75 : 1.0; }
+
+// Lasting recovery: health restored over `secs` from what remains, at 20 health per 6 seconds.
+static flex_t jkRpg_LastingStep(flex_t pending, flex_t secs)
+{
+    flex_t step = RPG_BACTA_LASTING / RPG_BACTA_SECONDS * secs;
+    return step < pending ? step : pending;
+}
+
+// Emergency treatment: a hit left the player alive but strictly below a quarter of the maximum.
+static int jkRpg_BactaDue(flex_t health, flex_t maxHealth, flex_t cooldown, flex_t tanks)
+{
+    return health >= 1.0 && jkRpg_IsLow(health, maxHealth) && cooldown <= 0 && tanks >= 1;
+}
+
+// Reminder of the bacta key when a tank is picked up: always for the playthrough's first tank, then
+// at a quarter of health or less until the player has used the key, at most once per gap.
+#define RPG_BACTA_NOTICE_GAP 30.0 // game seconds
+static int jkRpg_BactaNotice(int firstTank, int keyUsed, flex_t health, flex_t maxHealth, flex_t sinceLast)
+{
+    return firstTank || (!keyUsed && health <= maxHealth * RPG_LOW_SHARE && sinceLast >= RPG_BACTA_NOTICE_GAP);
+}
+
+// Force Healing restores 40/45/50/60 at its four power ranks; the script asks for 20 per rank.
+static flex_t jkRpg_ForceHealAmount(flex_t amount)
+{
+    static const flex_t heal[5] = {0, 40, 45, 50, 60};
+    int rank = (int)(amount / 20.0 + 0.5);
+    return heal[rank < 1 ? 1 : rank > 4 ? 4 : rank];
+}
+
+// Force powers follow Force Speed: a power's strength stays modest and higher ranks mostly add time.
+// Speed is always 1.5 times running speed; timed powers last 7.5/10/12.5/15 seconds by rank.
+#define RPG_FORCE_SPEED 1.5
+static int jkRpg_ForceRankClamp(int rank) { return rank < 1 ? 1 : rank > 4 ? 4 : rank; }
+static flex_t jkRpg_ForceSeconds(int rank) { return 5.0 + 2.5 * jkRpg_ForceRankClamp(rank); }
+// Destruction's blast radius: 1.2/1.3/1.4/1.5 world units.
+static flex_t jkRpg_ForceStep(int rank) { return 1.1 + 0.1 * jkRpg_ForceRankClamp(rank); }
+// Grip's total damage and Destruction's blast: 40/45/50/60 against a stormtrooper.
+static flex_t jkRpg_ForceDamageScale(int rank)
+{
+    static const flex_t scale[5] = {1, 1, 1.125, 1.25, 1.5};
+    return scale[jkRpg_ForceRankClamp(rank)];
+}
+// The rank a power's own script sees. Absorb then always takes half of Force damage, Grip squeezes
+// four times, Deadly Sight burns for 3 seconds and Protection blocks 75 damage. The real rank still
+// sets timed lengths and Grip's damage.
+static int jkRpg_ForceScriptRank(int bin, int rank)
+{
+    if (rank < 1)
+        return rank;
+    if (bin == SITHBIN_F_ABSORB || bin == SITHBIN_F_GRIP || bin == SITHBIN_F_DEADLYSIGHT)
+        return 2;
+    return bin == SITHBIN_F_PROTECTION ? 1 : rank;
+}
+
+// Force capacity and natural recovery relative to the story's Jedi rank * 50 and rank / 2 per second.
+// Persuasion suspends the recovery bonus while it is active.
+static flex_t jkRpg_ForceCapacityScale(int rank) { return rank >= 1 ? 1.25 : 1.0; }
+static flex_t jkRpg_ForceRegenScale(int rank, int persuasion)
+{
+    return persuasion ? 1.0 : rank >= 3 ? 1.5 : rank >= 2 ? 1.25 : 1.0;
+}
+
+// Safer landings halves ordinary landing damage, but not landings that took the original full health.
+static flex_t jkRpg_LandingDamage(int rank, flex_t damage)
+{
+    return rank >= 1 && damage < RPG_LETHAL_LANDING ? damage * 0.5 : damage;
+}
