+// Use one carried tank through the tank's own script, as the original Use Item did. The script
+// skips it at full health. Returns 1 when a tank was used.
+static int jkRpg_UseBacta(SithThing* p)
+{
+    sithCog* pCog = sithInventory_g_aTypes[SITHBIN_BACTATANK].cog;
+    flex_t tanks = sithInventory_GetInventory(p, SITHBIN_BACTATANK);
+    if (!pCog || tanks < 1)
+        return 0;
+    sithCog_SendMessage(pCog, SITH_MESSAGE_ACTIVATE, SENDERTYPE_SYSTEM, SITHBIN_BACTATANK, SENDERTYPE_THING, p->idx, 0);
+    return sithInventory_GetInventory(p, SITHBIN_BACTATANK) < tanks;
+}
