+void jkRpg_PlayerTick(SithThing* p, flex_t deltaSecs)
+{
+    if (!jkRpg_IsActive(p))
+        return;
+    if (jkRpg_Get(p, RPG_BIN_LEVEL) < 1)
+        sithInventory_SetInventory(p, RPG_BIN_LEVEL, 1);
+
+    jkPlayer_ClampFov();
+    jkRpg_Migrate(p);
+    jkRpg_RemoveGoggles(p);
+    jkRpg_Discover(p);
+    jkRpg_RepairPedCount(p);
+    jkRpg_PopulateCivilians(p);
+    jkRpg_FixOpeningBar(p);
+    jkRpg_FixBaronsPatron(p);
+    jkRpg_FixBaronsCrate();
+    jkRpg_ArmExplosiveCrate();
+    jkRpg_WeakenOpeningRodian();
+    jkRpg_ThinReservoirEncounter();
+    jkRpg_RemoveCargoLiftOfficer();
+    jkRpg_ThinTempleDragons();
+    jkRpg_TextureGlassBacks();
+    jkRpg_RetireCourtyardWalkers();
+    jkRpg_ThinTowerSquad();
+    jkRpg_ThinTowerBacta();
+    jkRpg_YunTaunt();
+    jkRpg_FixPoolGuards();
+    jkRpg_FreeStuckRemotes();
+    jkRpg_FixUnsupportedCivilians(p);
+    jkRpg_ThinDenseCrowds(p);
+    jkRpg_ThinFuelStation(p);
+    jkRpg_ClearCrowdObstructions(p);
+    jkRpg_AddOpeningAmmo(p);
+    jkRpg_AddValleyTroopers(p);
+    jkRpg_CloseValleyTunnel();
+    jkRpg_UpdateSaberColor(p);
+    jkRpg_ApplyStats(p);
+
+    // A fresh level starts the player at the original full health; start at the upgraded full
+    // health instead. A loaded save keeps its own health.
+    static int lastGen = -1;
+    if (lastGen != jkRpg_worldGen) {
+        lastGen = jkRpg_worldGen;
+        if (!jkRpg_bWorldFromSave && p->pTemplate && p->actorParams.health >= p->pTemplate->actorParams.maxHealth)
+            p->actorParams.health = p->actorParams.maxHealth;
+    }
+    jkRpg_WeaponsTick(p, deltaSecs);
+
+    if (jkRpg_MenuPressed() && !(p->flags & SITH_TF_DEAD)) {
+        jkRpg_bMenuOpen = 1;
+        sithTime_Pause();
+        return;
+    }
+    if (jkRpg_BactaPressed() && !(p->flags & SITH_TF_DEAD) && jkRpg_UseBacta(p))
+        sithInventory_SetInventory(p, RPG_BIN_BACTAKEY, 1);
+    jkRpg_VisionTick(p);
+    jkRpg_VisionReminder(p, 0);
+    jkRpg_SkillsTick(p, deltaSecs);
+}
