+// Crosshair styles: 1 classic (the original cross), 2 small cross, 3 dot, 4 circle, in the chosen
+// colour without a dark outline. `unit` is the HUD's crosshair scale in pixels.
+static void jkRpg_CrosshairRect(int x, int y, int w, int h)
+{
+    uint8_t r, g, b;
+    jkRpg_CrosshairRgb(&r, &g, &b);
+    rdRect fill = {x, y, w, h};
+    std3D_DrawUIClearedRectRGBA(r, g, b, 255, &fill);
+}
+
+void jkRpg_DrawCrosshair(int style, int cx, int cy, flex_t unit)
+{
+    if (!isfinite(unit) || unit <= 0) return;
+    // Bound raster work even for manually edited profiles: up to 8K at 200% size.
+    unit = fmin(18.0, fmax(0.5, unit));
+    uint8_t cr, cg, cb;
+    jkRpg_CrosshairRgb(&cr, &cg, &cb);
+    int t = (int)(unit + 0.5) > 1 ? (int)(unit + 0.5) : 1; // line thickness
+    if (style == 1) {
+        // The original cross, same size and line width as the game draws it.
+        int outer = (int)(unit * 18.0 + 0.5), gap = (int)(unit * 6.0 + 0.5);
+        int len = outer - gap + 1, w = (int)jkPlayer_crosshairLineWidth > 0 ? (int)jkPlayer_crosshairLineWidth : 1;
+        rdRect arms[4] = {{cx - outer, cy - w / 2, len, w}, {cx + gap, cy - w / 2, len, w},
+                          {cx - w / 2, cy - outer, w, len}, {cx - w / 2, cy + gap, w, len}};
+        for (int i = 0; i < 4; i++)
+            std3D_DrawUIClearedRectRGBA(cr, cg, cb, 255, &arms[i]);
+    }
+    else if (style == 2) {
+        int gap = (int)(unit * 2.5), len = (int)(unit * 5.0);
+        jkRpg_CrosshairRect(cx - gap - len, cy - t / 2, len, t);
+        jkRpg_CrosshairRect(cx + gap, cy - t / 2, len, t);
+        jkRpg_CrosshairRect(cx - t / 2, cy - gap - len, t, len);
+        jkRpg_CrosshairRect(cx - t / 2, cy + gap, t, len);
+    }
+    else if (style == 3) {
+        int d = (int)(unit * 2.0) > 2 ? (int)(unit * 2.0) : 2;
+        jkRpg_CrosshairRect(cx - d / 2, cy - d / 2, d, d);
+    }
+    else if (style == 4) {
+        // Pixel coverage makes a continuous, antialiased ring. Merge equal pixels into
+        // row spans so larger crosshairs stay within the existing UI vertex budget.
+        flex_t radius = unit * 6.0;
+        int extent = (int)ceil(radius + t * 0.5 + 0.5);
+        for (int y = -extent; y <= extent; y++) {
+            int run = -extent;
+            uint32_t previous = 0;
+            for (int x = -extent; x <= extent + 1; x++) {
+                flex_t distance = fabs(sqrt((flex_t)x * x + (flex_t)y * y) - radius);
+                flex_t alpha = fmin(1.0, fmax(0.0, t * 0.5 + 0.5 - distance));
+                uint32_t color = 0;
+                if (alpha > 0 && x <= extent) {
+                    color = ((uint32_t)(alpha * 255 + 0.5) << 24)
+                          | ((uint32_t)cr << 16)
+                          | ((uint32_t)cg << 8)
+                          | (uint32_t)cb;
+                }
+                if (color != previous) {
+                    if (previous >> 24) {
+                        rdRect span = {cx + run, cy + y, x - run, 1};
+                        std3D_DrawUIClearedRectRGBA((previous >> 16) & 255,
+                            (previous >> 8) & 255, previous & 255, previous >> 24, &span);
+                    }
+                    run = x;
+                    previous = color;
+                }
+            }
+        }
+        jkRpg_CrosshairRect(cx - t / 2, cy - t / 2, t, t);
+    }
+}
+
+// The left gauge's ring image (stShield) has two arcs. The original shows shields 0-100 on the inner
+// arc and 100-200 on the outer arc by dimming them (mips 10 = both dim, 5 = inner bright, 0 = both
+// bright). Both arcs fill along their length: green shields inside, gold XP outside,
+// from the bottom end up and over to the left. Pixels are told apart by their
+// distance from the arcs' centre and placed along the arc by angle (measured on the game's 38x38
+// image), then drawn row by row with filled rectangles like the crosshairs and menu: tinting the ring
+// texture did not reach the screen.
+#define RPG_RING_CX     15.0
+#define RPG_RING_CY     23.0
+#define RPG_RING_SPLIT  18.1    // inner arc ends at 17.7 px, outer arc starts at 18.5 px
+#define RPG_RING_START  41.5    // outer arc's bottom end, degrees (screen y points down)
+#define RPG_RING_END    -133.5  // outer arc's left end
+
+static int jkRpg_IsOuterArc(uint32_t c, uint32_t r)
+{
+    flex_t dx = c + 0.5 - RPG_RING_CX, dy = r + 0.5 - RPG_RING_CY;
+    return dx * dx + dy * dy > RPG_RING_SPLIT * RPG_RING_SPLIT;
+}
+
+// Sources: 0 bright shields, 1 bright XP, 2 dim XP, 3 dim shields.
+static int jkRpg_RingSource(uint32_t c, uint32_t r, flex_t xp, flex_t shields)
+{
+    flex_t deg = atan2(r + 0.5 - RPG_RING_CY, c + 0.5 - RPG_RING_CX) * (180.0 / 3.14159265);
+    if (!jkRpg_IsOuterArc(c, r)) {
+        // The inner arc spans 40 to -130 degrees in the original 38x38 artwork.
+        if (!(shields > 0)) return 3;
+        return shields >= 1 || (40.5 - deg) / 171.0 <= shields ? 0 : 3;
+    }
+    return (RPG_RING_START - deg) / (RPG_RING_START - RPG_RING_END) <= xp ? 1 : 2;
+}
+
+static tVBuffer* jkRpg_RingMip(stdBitmap* pShield, int mip)
+{
+    if (!pShield || mip < 0 || mip >= pShield->numMips)
+        return NULL;
+    tVBuffer* vb = pShield->mipSurfaces[mip];
+    if (!vb || !vb->sdlSurface || !vb->sdlSurface->pixels || !vb->format.format.is16bit)
+        return NULL;
+    return vb;
+}
+
+void jkRpg_DrawGaugeRings(stdBitmap* pShield, flex_t xp, flex_t shields, int x, int y)
+{
+    int last = pShield ? pShield->numMips - 1 : 0;
+    tVBuffer* aVb[4] = {jkRpg_RingMip(pShield, last / 2), jkRpg_RingMip(pShield, 0),
+                      jkRpg_RingMip(pShield, last / 2), jkRpg_RingMip(pShield, last)};
+    for (int i = 0; i < 4; i++)
+        if (!aVb[i] || aVb[i]->format.width != aVb[0]->format.width || aVb[i]->format.height != aVb[0]->format.height)
+            return;
+    rdTexFormat* f = &aVb[0]->format.format;
+    uint32_t rMask = (1u << f->r_bits) - 1, gMask = (1u << f->g_bits) - 1, bMask = (1u << f->b_bits) - 1;
+    uint32_t w = aVb[0]->format.width;
+    flex_t s = jkPlayer_hudScale;
+    for (uint32_t r = 0; r < aVb[0]->format.height; r++) {
+        uint32_t c = 0;
+        while (c < w) {
+            int source = jkRpg_RingSource(c, r, xp, shields), outer = jkRpg_IsOuterArc(c, r);
+            tVBuffer* vb = aVb[source];
+            uint16_t* row = (uint16_t*)((uint8_t*)vb->sdlSurface->pixels + r * vb->format.rowSize);
+            uint16_t v = row[c];
+            uint32_t start = c;
+            while (c < w && row[c] == v && jkRpg_RingSource(c, r, xp, shields) == source)
+                c++;
+            if (v == (uint16_t)vb->transparent_color || !v)
+                continue;
+            flex_t red = (flex_t)((v >> f->r_shift) & rMask) / rMask;
+            flex_t green = (flex_t)((v >> f->g_shift) & gMask) / gMask, blue = (flex_t)((v >> f->b_shift) & bMask) / bMask;
+            int x0 = x + (int)(start * s), x1 = x + (int)(c * s);
+            int y0 = y + (int)(r * s), y1 = y + (int)((r + 1) * s);
+            rdRect rect = {x0, y0, x1 - x0, y1 - y0};
+            if (!outer) {
+                std3D_DrawUIClearedRectRGBA((uint8_t)(255 * red), (uint8_t)(255 * green), (uint8_t)(255 * blue), 255, &rect);
+                continue;
+            }
+            // XP: the brightness of the original pixel becomes the brightness of the gold.
+            flex_t lum = red > green ? red : green;
+            if (blue > lum) lum = blue;
+            std3D_DrawUIClearedRectRGBA((uint8_t)(255 * lum), (uint8_t)(190 * lum), (uint8_t)(45 * lum), 255, &rect);
+        }
+    }
+}
