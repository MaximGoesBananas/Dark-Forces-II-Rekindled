+    {"Gran bounty hunter", "rh.3do rhstr.3do",
+     "rhrtshd.mat rhrback.mat rhrhip.mat rhrarm.mat rhrfarm.mat rhrthigh.mat rhrhand.mat rhrleg.mat rhrtors.mat", NULL,
+     3, {{90, 115, 100, 60, 100}, {130, 100, 80, 60, 100}, {110, 95, 125, 60, 100}}},
+    {"Tusken", "tk.3do tkstr.3do",
+     "tktorsf.mat tkthighf.mat tkhipf.mat tkrthi~1.mat tkllegf.mat tkarm.mat tkforarm.mat tkrlegf.mat "
+     "tktorsb.mat tkbutt.mat tkrlegb.mat tkthighb.mat tkrthi~2.mat tktorssd.mat tkthgsd.mat", NULL,
+     3, {{128, 128, 128, 45, 95}, {170, 120, 75, 30, 100}, {130, 100, 75, 35, 85}}},
+    {"Tusken bounty hunter", "th.3do thstr.3do",
+     "thtors.mat ththigh.mat thhip.mat thleg.mat thback.mat thbutt.mat", NULL,
+     3, {{125, 95, 70, 55, 100}, {90, 100, 125, 55, 100}, {105, 110, 80, 55, 100}}},
+    {"Civilian", "mn.3do m2.3do wm.3do w2.3do",
+     "mn-trsf.mat mn-chf.mat mn-chs.mat mn-trss.mat mn-trst.mat mn-robe.mat mn-rbs.mat mn-bend.mat "
+     "mn-armt.mat mn-trsb.mat mn-chb.mat mn-armb.mat "
+     "m2-chstf.mat m2-chstb.mat m2-chsts.mat m2-boot.mat m2-wst.mat m2-wstf.mat m2-leg.mat "
+     "wm1-chs.mat wm1-chb.mat wm1-chf.mat wm1-wst.mat wm1-wstb.mat wm1-sk.mat wm1-sks.mat wm1-cht.mat "
+     "wm1-armt.mat wm1-armb.mat "
+     "w2-arml.mat w2-armt.mat w2-chb.mat w2-chf.mat w2-chs.mat w2-cht.mat w2-sktb.mat w2-sktf.mat "
+     "w2-skts.mat w2-wstb.mat w2-wstf.mat w2-wsts.mat",
+     "actor_mn.cog actor_fn.cog actor_pm.cog actor_pf.cog actor_mu.cog actor_gd.cog",
+     4, {{150, 80, 65, 35, 100}, {95, 125, 90, 35, 100}, {95, 110, 145, 35, 100}, {160, 135, 85, 30, 100}}},
+    {"Worker", "ugalt.3do u2alt.3do",
+     "ug_arm.mat ug_bd.mat ug_bdf.mat ug_hpb.mat ug_hpf.mat ug_leg.mat", "actor_ug.cog",
+     3, {{128, 128, 128, 45, 100}, {95, 110, 140, 35, 100}, {125, 125, 85, 35, 100}}},
+};
+#define RPG_NUM_OUTFITS ((int)(sizeof(jkRpg_aOutfits) / sizeof(*jkRpg_aOutfits)))
+
+// Case-insensitive whole-word match in a space-separated list.
+static int jkRpg_InList(const char* list, const char* name)
+{
+    size_t len = strlen(name);
+    while (*list) {
+        size_t word = strcspn(list, " ");
+        if (word == len) {
+            size_t i = 0;
+            while (i < len && (list[i] | 0x20) == (name[i] | 0x20)) i++;
+            if (i == len) return 1;
+        }
+        list += word;
+        while (*list == ' ') list++;
+    }
+    return 0;
+}
+
+static int jkRpg_OutfitForModel(const char* model)
+{
+    for (int i = 0; i < RPG_NUM_OUTFITS; i++)
+        if (jkRpg_InList(jkRpg_aOutfits[i].models, model)) return i;
+    return -1;
+}
+
+// 0 keeps the original art; 1..numTints pick a tint. Well mixed, so neighbouring GUIDs differ.
+static int jkRpg_OutfitLook(uint32_t guid, int numTints)
+{
+    guid ^= guid >> 16; guid *= 0x7feb352dU;
+    guid ^= guid >> 15; guid *= 0x846ca68bU;
+    guid ^= guid >> 16;
+    return (int)(guid % (uint32_t)(numTints + 1));
+}
+
+// One palette colour as native RGB565 (the shader swaps B/R after the REV upload). The texel
+// keeps its brightness, so folds, seams and patterns stay; only its colour moves to the tint.
+static uint16_t jkRpg_TintTexel(int r, int g, int b, const jkRpgTint* t)
+{
+    int c[3] = {r, g, b}, tint[3] = {t->r, t->g, t->b}, out[3];
+    int lum = 299 * r + 587 * g + 114 * b;
+    int tintLum = 299 * t->r + 587 * t->g + 114 * t->b;
+    for (int i = 0; i < 3; i++) {
+        int target = tintLum ? tint[i] * lum / tintLum : c[i];
+        int v = ((c[i] * (100 - t->strength) + target * t->strength) * t->brightness + 5000) / 10000;
+        out[i] = v < 0 ? 0 : v > 255 ? 255 : v;
+    }
+    return (uint16_t)((out[0] >> 3) << 11 | (out[1] >> 2) << 5 | (out[2] >> 3));
+}
+
+// ---- End of outfit rules ----
+
+#define RPG_OUTFIT_MAX_MODELS 16
+#define RPG_OUTFIT_MAX_SWAPS 48
+
+static rdMaterialSwap jkRpg_aSwaps[RPG_NUM_OUTFITS][RPG_OUTFIT_MAX_LOOKS - 1][RPG_OUTFIT_MAX_SWAPS];
+static int jkRpg_aNumSwaps[RPG_NUM_OUTFITS][RPG_OUTFIT_MAX_LOOKS - 1];
+static struct { rdModel3* model; int outfit; } jkRpg_aOutfitModels[RPG_OUTFIT_MAX_MODELS];
+static int jkRpg_numOutfitModels;
+static SithWorld* jkRpg_pOutfitWorld;
+static uint32_t jkRpg_outfitBytes;
+static int jkRpg_bOutfitsOff; // development comparison: `outfitinfo off`
+
+void jkRpg_FreeOutfits(void)
+{
+    for (int o = 0; o < RPG_NUM_OUTFITS; o++)
+        for (int l = 0; l < RPG_OUTFIT_MAX_LOOKS - 1; l++) {
+            for (int i = 0; i < jkRpg_aNumSwaps[o][l]; i++) {
+                rdMaterial_FreeEntry(jkRpg_aSwaps[o][l][i].to);
+                RDROID_FREE(jkRpg_aSwaps[o][l][i].to);
+            }
+            jkRpg_aNumSwaps[o][l] = 0;
+        }
+    jkRpg_numOutfitModels = 0;
+    jkRpg_outfitBytes = 0;
+    jkRpg_pOutfitWorld = NULL;
+    rdModel3_numMaterialSwaps = 0;
+}
+
+// A recoloured copy of a loaded clothing material, made in memory from the player's game files.
+static rdMaterial* jkRpg_TintedCopy(const rdMaterial* from, const uint16_t* table)
+{
+#ifdef SDL2_RENDER
+    rdMaterial* pMat = rdMaterial_CopyRecolored(from, table);
+    if (pMat)
+        for (uint32_t t = 0; t < pMat->num_textures; t++)
+            for (uint32_t m = 0; m < pMat->textures[t].num_mipmaps; m++)
+                jkRpg_outfitBytes += pMat->textures[t].texture_struct[m]->format.size;
+    return pMat;
+#else
+    return NULL;
+#endif
+}
+
+static int jkRpg_CmdOutfitInfo(stdDebugConsoleCmd* cmd, const char* arg);
+
+// Built once per loaded world from its preloaded models; a model first loaded
+// mid-level (none in the stock campaign) keeps its original art until the next level.
+static void jkRpg_BuildOutfits(SithWorld* world)
+{
+    static int bCommandRegistered = 0;
+    if (!bCommandRegistered) {
+        sithConsole_RegisterCommand(jkRpg_CmdOutfitInfo, "outfitinfo", 0);
+        bCommandRegistered = 1;
+    }
+    jkRpg_FreeOutfits();
+    jkRpg_pOutfitWorld = world;
+    if (!world->colormaps) return;
+    int started = stdPlatform_GetTimeMsec();
+    int pieces = 0;
+    const rdColor24* palette = world->colormaps[0].colors;
+    SithWorld* worlds[2] = {sithWorld_g_pStaticWorld, world};
+    uint16_t table[256];
+    for (int w = 0; w < 2; w++) {
+        if (!worlds[w] || (w == 0 && worlds[0] == world)) continue;
+        for (uint32_t m = 0; m < worlds[w]->numModels; m++) {
+            rdModel3* model = &worlds[w]->aModels[m];
+            int o = jkRpg_OutfitForModel(model->filename);
+            if (o < 0 || jkRpg_numOutfitModels >= RPG_OUTFIT_MAX_MODELS) continue;
+            jkRpg_aOutfitModels[jkRpg_numOutfitModels].model = model;
+            jkRpg_aOutfitModels[jkRpg_numOutfitModels++].outfit = o;
+            const jkRpgOutfit* outfit = &jkRpg_aOutfits[o];
+            for (int l = 0; l < outfit->numTints; l++) {
+                for (int c = 0; c < 256; c++)
+                    table[c] = jkRpg_TintTexel(palette[c].r, palette[c].g, palette[c].b, &outfit->tints[l]);
+                for (uint32_t i = 0; i < model->sizeMaterials; i++) {
+                    rdMaterial* from = model->aMaterials[i];
+                    if (!from || !jkRpg_InList(outfit->clothes, from->mat_fpath)) continue;
+                    int n = jkRpg_aNumSwaps[o][l], found = 0;
+                    for (int s = 0; s < n; s++) found |= jkRpg_aSwaps[o][l][s].from == from;
+                    if (found || n >= RPG_OUTFIT_MAX_SWAPS) continue;
+                    rdMaterial* to = jkRpg_TintedCopy(from, table);
+                    if (!to) continue; // keeps the original art for this piece
+                    jkRpg_aSwaps[o][l][n].from = from;
+                    jkRpg_aSwaps[o][l][n].to = to;
+                    jkRpg_aNumSwaps[o][l] = n + 1;
+                    pieces++;
+                }
+            }
+        }
+    }
+    stdPlatform_Printf("RPG outfits ready: %d pieces, %u KB, %d ms\n", pieces,
+                       (unsigned)(jkRpg_outfitBytes / 1024), stdPlatform_GetTimeMsec() - started);
+}
+
+// The thing's outfit and look (0 = original), or -1 for things without an outfit.
+static int jkRpg_ThingOutfit(SithThing* pThing, int* pLook)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    *pLook = 0;
+    if (!world || !pThing || pThing->renderData.type != RD_THING_MODEL3 || !pThing->renderData.model3)
+        return -1;
+    if (jkRpg_pOutfitWorld != world)
+        jkRpg_BuildOutfits(world);
+    for (int i = 0; i < jkRpg_numOutfitModels; i++) {
+        if (jkRpg_aOutfitModels[i].model != pThing->renderData.model3) continue;
+        const jkRpgOutfit* outfit = &jkRpg_aOutfits[jkRpg_aOutfitModels[i].outfit];
+        // Bartenders and other story roles share civilian models but keep their own look.
+        if (outfit->scripts && !(pThing->pCog && pThing->pCog->pScript
+                                 && jkRpg_InList(outfit->scripts, pThing->pCog->pScript->aName)))
+            return -1;
+        *pLook = jkRpg_OutfitLook(pThing->guid, outfit->numTints);
+        return jkRpg_aOutfitModels[i].outfit;
+    }
+    return -1;
+}
+
+void jkRpg_BeginOutfit(SithThing* pThing)
+{
+    int look;
+    rdModel3_numMaterialSwaps = 0;
+    if (rdroid_bSoftwareRenderer || jkRpg_bOutfitsOff) return; // software rasterizer expects 8-bit art
+    int o = jkRpg_ThingOutfit(pThing, &look);
+    if (o < 0 || !look) return;
+    rdModel3_pMaterialSwaps = jkRpg_aSwaps[o][look - 1];
+    rdModel3_numMaterialSwaps = jkRpg_aNumSwaps[o][look - 1];
+}
+
+void jkRpg_EndOutfit(void)
+{
+    rdModel3_numMaterialSwaps = 0;
+}
+
+// Development aid: lists every dressed actor and corpse with its look, for save/reload checks.
+// `outfitinfo off` / `on` switches the recolouring for same-scene comparisons (not saved).
+static int jkRpg_CmdOutfitInfo(stdDebugConsoleCmd* cmd, const char* arg)
+{
+    if (arg && (!strncmp(arg, "off", 3) || !strncmp(arg, "on", 2))) {
+        jkRpg_bOutfitsOff = !strncmp(arg, "off", 3);
+        sithConsole_PrintString(jkRpg_bOutfitsOff ? "Outfits off" : "Outfits on");
+        return 1;
+    }
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    int counts[RPG_NUM_OUTFITS][RPG_OUTFIT_MAX_LOOKS] = {{0}};
+    if (!world) return 1;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* thing = &world->aThings[i];
+        int look;
+        if (thing->type != SITH_THING_ACTOR && thing->type != SITH_THING_CORPSE) continue;
+        int o = jkRpg_ThingOutfit(thing, &look);
+        if (o < 0) continue;
+        counts[o][look]++;
+        stdPlatform_Printf("RPG outfit: %d guid=%u %s look=%d %.4f %.4f %.4f\n", i, thing->guid,
+                           jkRpg_aOutfits[o].name, look, thing->position.x, thing->position.y, thing->position.z);
+    }
+    for (int o = 0; o < RPG_NUM_OUTFITS; o++) {
+        int total = 0;
+        for (int l = 0; l < RPG_OUTFIT_MAX_LOOKS; l++) total += counts[o][l];
+        if (total)
+            stdPlatform_Printf("RPG outfits %s: %d original, %d %d %d %d recoloured\n", jkRpg_aOutfits[o].name,
+                               counts[o][0], counts[o][1], counts[o][2], counts[o][3], counts[o][4]);
+    }
+    sithConsole_PrintString("Outfits listed in the log");
+    return 1;
+}
