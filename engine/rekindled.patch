+// Called after the scene and HUD have been composited, before the window swaps.
+int std3D_ScreenshotReport(const char* path, const char* details)
+{
+#ifdef TARGET_CAN_JKGM
+    int w=Window_xSize, h=Window_ySize;
+    if (w<=0 || h<=0) return 0;
+    uint8_t* pixels = malloc((size_t)w*h*3);
+    if (!pixels) return 0;
+    GLint framebuffer, alignment, readBuffer;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &framebuffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, std3D_windowFbo);
+    glGetIntegerv(GL_READ_BUFFER, &readBuffer);
+    glReadBuffer(GL_BACK);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, pixels);
+    glReadBuffer(readBuffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    int ok = jkgm_write_png_report(path, w, h, pixels, details);
+    free(pixels);
+    return ok;
+#else
+    return 0;
+#endif
+}
