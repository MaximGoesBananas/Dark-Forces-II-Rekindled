+                       sithInventory_GetInventory(p, SITHBIN_BACTATANK)) && jkRpg_UseBacta(p))
+        sithInventory_SetInventory(p, RPG_BIN_BACTACOOL, RPG_BACTA_COOLDOWN);
+}
