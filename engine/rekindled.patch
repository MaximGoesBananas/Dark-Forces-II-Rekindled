+
+enum { RPGS_FOV, RPGS_BRIGHTNESS, RPGS_HUD, RPGS_MUSIC, RPGS_EFFECTS, RPGS_MOUSE, RPGS_SABER, RPGS_CROSSHAIR, RPGS_CROSSSIZE, RPGS_CROSSCOLOR, RPGS_AUTOSAVE };
+enum { RPGC_INVERT, RPGC_SUBTITLES, RPGC_AUTOAIM, RPGC_SWAY, RPGC_SABERCAM, RPGC_VSYNC, RPGC_WEAPONSWITCHER, RPGC_COUNT };
+
