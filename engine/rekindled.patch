+int jkRpg_IsActive(SithThing* p)
+{
+    return !sithNet_isMulti && !Main_bMotsCompat && p && p == sithPlayer_g_pLocalPlayerThing
+        && p->type == SITH_THING_PLAYER && p->actorParams.pPlayer;
+}
+
+// Rahn's local narration needs the same gain as music at equal slider settings.
+// Undo the local mixer's 0.75 attenuation, without changing stored assets or other voices.
+flex_t jkRpg_NarrationVolume(const sithSound* sound, flex_t volume)
+{
+    if (!sound || !jkRpg_IsActive(sithPlayer_g_pLocalPlayerThing)) return volume;
+    const char* name = sound->sound_fname;
+    if (_strlen(name) != 12 || __strnicmp(name, "i00ra", 5)
+        || name[5] < '0' || name[5] > '9' || name[6] < '0' || name[6] > '9'
+        || __strcmpi(name + 7, "z.wav")) return volume;
+    return stdMath_Clamp(volume / 0.75, 0.0, 1.5);
+}
+
+int jkRpg_Get(SithThing* p, int bin) { return (int)sithInventory_GetInventory(p, bin); }
+int jkRpg_Rank(SithThing* p, int up) { return jkRpg_Get(p, RPG_BIN_RANK0 + up); }
+
+int jkRpg_OwnsTier(SithThing* p, int up, int tier)
+{
+    return tier >= 1 && tier <= RPG_MAX_RANK && tier <= jkRpg_Rank(p, up)
+        && !(up == UP_LIGHT && tier == 2 && jkRpg_Get(p, RPG_BIN_LIGHTGAP));
+}
+
+int jkRpg_NextTier(SithThing* p, int up)
+{
+    if (up == UP_LIGHT && jkRpg_Get(p, RPG_BIN_LIGHTGAP)) return 2;
+    return jkRpg_Rank(p, up) + 1;
+}
+int jkRpg_Xp(SithThing* p) { return jkRpg_Get(p, RPG_BIN_XP); }
+int jkRpg_Points(SithThing* p) { return jkRpg_Get(p, RPG_BIN_POINTS); }
+int jkRpg_MaxLevel(void) { return RPG_MAX_LEVEL; }
+int jkRpg_Level(SithThing* p)
+{
+    int level = jkRpg_Get(p, RPG_BIN_LEVEL);
+    return level < 1 ? 1 : level;
+}
