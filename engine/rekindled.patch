+    for (uint32_t i = 0; i < weapons->numEntries; i++)
+        if ((weapons->aEntries[i].flags & INPUT_MAPPING_FLAG_DXKEY)
+            && weapons->aEntries[i].dxKeyNum < JK_EXTENDED_KEY_START
+            && weapons->aEntries[i].dxKeyNum != DIK_G)
+            otherWeaponKey = 1;
+    for (int f = 0; f < INPUT_FUNC_MAX; f++)
+        for (uint32_t i = 0; i < sithControl_aInputFuncToKeyinfo[f].numEntries; i++)
+            if ((sithControl_aInputFuncToKeyinfo[f].aEntries[i].flags & INPUT_MAPPING_FLAG_DXKEY)
