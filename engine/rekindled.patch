+flex_t jkRpg_CivilianFleeSpeed(SithThing* thing, flex_t speed)
+{
+    // Only the autonomous panic instinct calls this. Scripted routes keep their speed.
+    if (sithNet_isMulti || !thing || thing->type != SITH_THING_ACTOR
+        || !thing->pCog || !thing->pCog->pScript) return speed;
+    const char* script = thing->pCog->pScript->aName;
+    if (!__strcmpi(script, "actor_mn.cog") || !__strcmpi(script, "actor_fn.cog")
+        || !__strcmpi(script, "actor_pm.cog") || !__strcmpi(script, "actor_pf.cog"))
