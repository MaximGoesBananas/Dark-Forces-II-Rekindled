+// Crowd copies must not stack the same spoken line. Use the live mixer so a line
+// becomes available again when it ends or is stopped, including after loading a save.
+int jkRpg_CivilianVoiceDuplicate(SithThing* thing, sithSound* sound, int flags)
+{
+    return !sithNet_isMulti && (flags & SITHSOUNDFLAG_VOICE)
+        && jkRpg_CivilianKind(thing) && sound
+        && sithSoundMixer_GetThingSoundIdx(NULL, sound) >= 0;
