+        SithSector* sector = sithSector_FindSectorAtPos(world, &pos);
+        if (!sector || !sithThing_CreateThingAtPos(tpl, &pos, &orient, sector, NULL)) return;
+        sithInventory_SetInventory(player, RPG_BIN_STARTAMMO, added + 1);
