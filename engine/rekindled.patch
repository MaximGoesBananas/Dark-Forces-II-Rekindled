+// The game's own menu font (small1.sft: gold capitals on black) and the menu palette from
+// bkMain.bm, both loaded from the player's installation.
+static stdFont* jkRpg_pMenuFont;
+static uint8_t jkRpg_menuPalette[768];
+static int jkRpg_bMenuFontTried;
+static char jkRpg_artPlateText[64];
+
+static stdFont* jkRpg_MenuFont(void)
+{
+    if (jkRpg_bMenuFontTried) return jkRpg_pMenuFont;
+    jkRpg_bMenuFontTried = 1;
+    stdFont* font = stdFont_Load("ui\\sft\\small1.sft", 0, 0);
+    stdBitmap* back = stdBitmap_Load("ui\\bm\\bkMain.bm", 0, 0);
+    stdBitmap* b = font ? font->pBitmap : NULL;
+    if (font && back && back->palette && b && b->mipSurfaces && b->mipSurfaces[0] && b->format.bpp == 8) {
+        memcpy(jkRpg_menuPalette, back->palette, sizeof(jkRpg_menuPalette));
+        jkRpg_pMenuFont = font;
+        font = NULL;
+    }
+    if (font) stdFont_Free(font);
+    if (back) stdBitmap_Free(back);
+    return jkRpg_pMenuFont;
+}
+
+// Width in font pixels; the font's own space is wide for a plate, so words sit a little closer.
+static float jkRpg_MenuTextW(stdFont* f, const char* text)
+{
+    float w = 0;
+    for (; *text; text++) {
+        stdFontEntry* e = *text == ' ' ? NULL : jkRpg_Glyph(f, (uint8_t)*text);
+        w += e ? e->glyphWidth + f->marginY + 1 : f->marginX * 0.6f;
+    }
+    return w;
+}
+
+// Menu-font letters painted into the plate: gold instead of the menu's yellow, one font pixel
+// bolder, with a dark outline. scale: gauge pixels per font pixel.
+static void jkRpg_PaintMenuText(jkRpgCanvas* c, stdFont* f, const char* str, float x, float top, float scale)
+{
+    tVBuffer* v = f->pBitmap->mipSurfaces[0];
+    if (!stdDisplay_VBufferLock(v)) return;
+    int rows = v->format.height;
+    float* mask = (float*)calloc((size_t)c->w * c->h, sizeof(float));
+    float* rgb = (float*)calloc((size_t)c->w * c->h * 3, sizeof(float));
+    for (float at = x; mask && rgb && *str; str++) {
+        stdFontEntry* e = *str == ' ' ? NULL : jkRpg_Glyph(f, (uint8_t)*str);
+        if (!e) { at += f->marginX * 0.6f * scale; continue; }
+        int gw = e->glyphWidth + 1; // one column wider for the bold stroke
+        for (int ty = (int)(top * c->s); ty < (int)((top + rows * scale) * c->s) + 1 && ty < c->h; ty++)
+            for (int tx = (int)(at * c->s); tx < (int)((at + gw * scale) * c->s) + 1 && tx < c->w; tx++) {
+                float cover = 0, sum[3] = {0, 0, 0};
+                for (int n = 0; n < 16 && tx >= 0 && ty >= 0; n++) {
+                    float fx = ((tx + (n % 4 + 0.5f) / 4) / c->s - at) / scale, fy = ((ty + (n / 4 + 0.5f) / 4) / c->s - top) / scale;
+                    int sx = (int)fx, sy = (int)fy;
+                    if (fx < 0 || fy < 0 || sx >= gw || sy >= rows) continue;
+                    const uint8_t* row = (const uint8_t*)v->surface_lock_alloc + sy * v->format.rowSize + e->glyphTexX;
+                    for (int k = 0; k < 2; k++) { // the pixel or its left neighbour: one pixel bolder
+                        int gx = sx - k;
+                        if (gx < 0 || gx >= e->glyphWidth) continue;
+                        const uint8_t* p = &jkRpg_menuPalette[row[gx] * 3];
+                        if (p[0] + p[1] + p[2] < 24) continue;
+                        sum[0] += p[0] / 255.0f; sum[1] += p[1] * 0.8f / 255.0f; sum[2] += p[2] * 0.5f / 255.0f;
+                        cover += 1;
+                        break;
+                    }
+                }
+                if (!cover) continue;
+                int i = ty * c->w + tx;
+                mask[i] = cover / 16;
+                for (int j = 0; j < 3; j++) rgb[i * 3 + j] = sum[j] / cover;
+            }
+        at += (e->glyphWidth + f->marginY + 1) * scale;
+    }
+    int reach = (int)(c->s * 0.5f + 0.5f);
+    if (reach < 1) reach = 1;
+    for (int y = 0; mask && rgb && y < c->h; y++)
+        for (int x2 = 0; x2 < c->w; x2++) {
+            float edge = 0;
+            for (int j = -reach; j <= reach; j++)
+                for (int i = -reach; i <= reach; i++)
+                    if (y + j >= 0 && y + j < c->h && x2 + i >= 0 && x2 + i < c->w && mask[(y + j) * c->w + x2 + i] > edge)
+                        edge = mask[(y + j) * c->w + x2 + i];
+            if (edge > 0) jkRpg_Blend(c, x2, y, 0.08f, 0.04f, 0.01f, edge);
+            int k = y * c->w + x2;
+            if (mask[k] > 0) jkRpg_Blend(c, x2, y, rgb[k * 3], rgb[k * 3 + 1], rgb[k * 3 + 2], mask[k]);
+        }
+    free(mask);
+    free(rgb);
+    stdDisplay_VBufferUnlock(v);
+}
+
+// The generated plate at the screen's resolution for this HUD size, with its text painted into the
+// window: 0.6 gauge pixels per font pixel, smaller only if needed; only
+// a long key name drops "PRESS". With `arrow`, room is left for the pulsing arrow.
+static stdBitmap* jkRpg_ShippedPlate(const char* text, int arrow, flex_t s)
+{
+    const jkRpgCanvas* art = jkRpg_ShippedArt(ARTFILE_PLATE);
+    stdFont* f = art ? jkRpg_MenuFont() : NULL;
+    if (!art || !f) return NULL;
+    if (jkRpg_pArtPlate && jkRpg_artPlateScale == s && !strcmp(jkRpg_artPlateText, text)) return jkRpg_pArtPlate;
+    if (jkRpg_pArtPlate) stdBitmap_Free(jkRpg_pArtPlate);
+    jkRpg_pArtPlate = NULL;
+    jkRpg_artPlateScale = s;
+    stdString_snprintf(jkRpg_artPlateText, sizeof(jkRpg_artPlateText), "%s", text);
+    jkRpgCanvas c;
+    float w = art->w / PLATE_TEXELS, h = art->h / PLATE_TEXELS;
+    if (!jkRpg_NewCanvas(&c, w, h, s)) return NULL;
+    jkRpg_Stretch(art, 0, 0, (float)art->w, (float)art->h, &c, 0, 0, (int)(w * s + 0.5f), (int)(h * s + 0.5f));
+    float gap = arrow ? ARROW_W + 1.5f : 0, room = WINDOW_X1 - WINDOW_X0 - 3.0f - gap;
+    float tw = jkRpg_MenuTextW(f, text);
+    if (room / tw < 0.36f && !strncmp(text, "PRESS ", 6)) { // painted letters stay clean down to about 3/4 size
+        text += 6;
+        tw = jkRpg_MenuTextW(f, text);
+    }
+    float scale = tw * 0.6f > room ? room / tw : 0.6f;
+    float rows = (float)f->pBitmap->mipSurfaces[0]->format.height;
+    float x = (WINDOW_X0 + WINDOW_X1) / 2 - (tw * scale + gap) / 2;
+    jkRpg_plateArrowX = x;
+    jkRpg_PaintMenuText(&c, f, text, x + gap, (WINDOW_Y0 + WINDOW_Y1) / 2 - rows * scale / 2 + scale, scale);
+    jkRpg_Pixelate(&c, (float)jkPlayer_hudScale);
+    jkRpg_pArtPlate = jkRpg_CanvasBitmap(&c);
+    free(c.px);
+    return jkRpg_pArtPlate;
+}
+
+static void jkRpg_FreeShippedArt(void)
+{
+    if (jkRpg_pWeaponArt) stdBitmap_Free(jkRpg_pWeaponArt);
+    jkRpg_pWeaponArt = NULL;
+    jkRpg_weaponArtMask = 0;
+    if (jkRpg_pFrame) stdBitmap_Free(jkRpg_pFrame);
+    if (jkRpg_pBar) stdBitmap_Free(jkRpg_pBar);
+    if (jkRpg_pArtPlate) stdBitmap_Free(jkRpg_pArtPlate);
+    if (jkRpg_pMenuFont) stdFont_Free(jkRpg_pMenuFont);
+    for (int i = 0; i < 2; i++) {
+        if (jkRpg_aHudPanels[i]) stdBitmap_Free(jkRpg_aHudPanels[i]);
+        jkRpg_aHudPanels[i] = NULL;
+    }
+    if (jkRpg_pBactaIcon) stdBitmap_Free(jkRpg_pBactaIcon);
+    jkRpg_pBactaIcon = NULL;
+    jkRpg_pFrame = jkRpg_pBar = jkRpg_pArtPlate = NULL;
+    jkRpg_pMenuFont = NULL;
+    jkRpg_bMenuFontTried = 0;
+    jkRpg_artPlateText[0] = 0;
+    for (int i = 0; i < ARTFILE_COUNT; i++) {
+        free(jkRpg_aArt2[i].px);
+        jkRpg_aArt2[i].px = NULL;
+    }
+    jkRpg_bArtTried = 0; // read the files again next session, e.g. after an update
+}
+
+// The two supplied panels share scaling and cache lifetime, but keep their own artwork.
+static stdBitmap* jkRpg_ShippedHudPanel(int force, flex_t s)
+{
+    const jkRpgCanvas* art = jkRpg_ShippedArt(force ? ARTFILE_FORCE : ARTFILE_BACTA);
+    if (!art) return NULL;
+    if (jkRpg_aHudPanels[force] && jkRpg_aHudPanelScales[force] == s) return jkRpg_aHudPanels[force];
+    if (jkRpg_aHudPanels[force]) stdBitmap_Free(jkRpg_aHudPanels[force]);
+    jkRpg_aHudPanels[force] = NULL;
+    jkRpg_aHudPanelScales[force] = s;
+    jkRpgCanvas c;
+    float w = art->w / PLATE_TEXELS, h = art->h / PLATE_TEXELS;
+    if (!jkRpg_NewCanvas(&c, w, h, s)) return NULL;
+    jkRpg_Stretch(art, 0, 0, (float)art->w, (float)art->h, &c, 0, 0, (int)(w * s + 0.5f), (int)(h * s + 0.5f));
+    jkRpg_Pixelate(&c, (float)jkPlayer_hudScale); // the gauge's pixel, also on these 3/4-size panels
+    jkRpg_aHudPanels[force] = jkRpg_CanvasBitmap(&c);
+    free(c.px);
+    return jkRpg_aHudPanels[force];
+}
+
+// Carried bacta tanks as shown beside the gauge; 0 draws the icon dimmed as empty.
+static int jkRpg_BactaShown(flex_t tanks)
+{
+    return tanks >= 1 ? (int)tanks : 0;
+}
+
+// The game's bacta item icon without its item frame and with its black background made
+// transparent, so the tank sits directly in the panel's window. NULL keeps the plain icon.
+#define BACTA_INSET 3   // the item frame, icon pixels
+static stdBitmap* jkRpg_BactaIcon(stdBitmap* icon)
+{
+    static stdBitmap* failedFor;
+    if (jkRpg_pBactaIcon || failedFor == icon) return jkRpg_pBactaIcon;
+    failedFor = icon; // cleared below once built; a new icon (HUD reload) is tried again
+    tVBuffer* v = icon->mipSurfaces[0];
+    const rdTexFormat* f = &v->format.format;
+    int w = v->format.width - 2 * BACTA_INSET, h = v->format.height - 2 * BACTA_INSET;
+    if (f->bpp != 16 || w <= 0 || h <= 0 || !f->r_bits || !f->g_bits || !f->b_bits || !stdDisplay_VBufferLock(v))
+        return NULL;
+    jkRpgCanvas c = {(float*)calloc((size_t)w * h * 4, sizeof(float)), w, h, 1};
+    for (int y = 0; c.px && y < h; y++) {
+        const uint16_t* row = (const uint16_t*)((const uint8_t*)v->surface_lock_alloc + (y + BACTA_INSET) * v->format.rowSize);
+        for (int x = 0; x < w; x++) {
+            uint16_t texel = row[x + BACTA_INSET];
+            float* p = &c.px[((size_t)y * w + x) * 4];
+            p[0] = ((texel >> f->r_shift) & ((1u << f->r_bits) - 1)) / (float)((1u << f->r_bits) - 1);
+            p[1] = ((texel >> f->g_shift) & ((1u << f->g_bits) - 1)) / (float)((1u << f->g_bits) - 1);
+            p[2] = ((texel >> f->b_shift) & ((1u << f->b_bits) - 1)) / (float)((1u << f->b_bits) - 1);
+            p[3] = fmaxf(p[0], fmaxf(p[1], p[2])) > 0.08f; // the icon's black background
+        }
+    }
+    stdDisplay_VBufferUnlock(v);
+    if (c.px) jkRpg_pBactaIcon = jkRpg_CanvasBitmap(&c);
+    free(c.px);
+    if (jkRpg_pBactaIcon) failedFor = NULL;
+    return jkRpg_pBactaIcon;
+}
+
+// The bacta panel to the right of the left gauge, level with its bottom: the game's own bacta item
+// icon (from the player's install) and the count side by side in the panel's window. Empty dims
+// the icon and count and slightly darkens the panel. Without bacta.bmp a copper-edged box is drawn.
+#define BACTA_DIM    80     // empty: icon and count shade
+#define BACTA_SCALE  0.75   // the panel's size relative to the HUD scale
+#define BACTA_TANK_W 0.6    // the upright tank's width as a share of its picture's height
+
+stdBitmap* jkRpg_BactaModelIcon(void); // jkRpg.c: the textured bacta pickup, 192x96
+
+// A colourless copy of the bacta tank picture for the empty panel, built once per HUD session.
+static stdBitmap* jkRpg_pBactaGray;
+static stdBitmap* jkRpg_pBactaGraySource;
+static stdBitmap* jkRpg_BactaGray(stdBitmap* source)
+{
+    if (source == jkRpg_pBactaGraySource) return jkRpg_pBactaGray;
+    if (jkRpg_pBactaGray) stdBitmap_Free(jkRpg_pBactaGray);
+    jkRpg_pBactaGray = NULL;
+    jkRpg_pBactaGraySource = source;
+    tVBuffer* from = source->mipSurfaces[0];
+    int w = from->format.width, h = from->format.height;
+    stdBitmap* gray = jkRpg_NewBitmap(w, h);
+    tVBuffer* to = gray ? gray->mipSurfaces[0] : NULL;
+    if (to && stdDisplay_VBufferLock(from)) {
+        if (stdDisplay_VBufferLock(to)) {
+            for (int y = 0; y < h; y++)
+                for (int x = 0; x < w; x++)
+                    ((uint16_t*)to->surface_lock_alloc)[y * (to->format.rowSize / 2) + x] =
+                        jkRpg_GrayPixel(((uint16_t*)from->surface_lock_alloc)[y * (from->format.rowSize / 2) + x]);
+            stdDisplay_VBufferUnlock(to);
+            jkRpg_pBactaGray = gray;
+        }
+        stdDisplay_VBufferUnlock(from);
+    }
+    if (!jkRpg_pBactaGray && gray) stdBitmap_Free(gray);
+    return jkRpg_pBactaGray;
+}
+
+// A `w` x `h` copy of a source rectangle, sampling each block's centre, so the rendered tank
+// is drawn enlarged in gauge pixels like the game's own HUD art. Two cached (colour, grey).
+static stdBitmap* jkRpg_aLowRes[2];
+static stdBitmap* jkRpg_aLowResSource[2];
+static int jkRpg_aLowResSize[2][2];
+static stdBitmap* jkRpg_LowRes(int slot, stdBitmap* source, const rdRect* r, int w, int h)
+{
+    if (w < 1 || h < 1) return NULL;
+    if (jkRpg_aLowRes[slot] && jkRpg_aLowResSource[slot] == source
+        && jkRpg_aLowResSize[slot][0] == w && jkRpg_aLowResSize[slot][1] == h)
+        return jkRpg_aLowRes[slot];
+    if (jkRpg_aLowRes[slot]) stdBitmap_Free(jkRpg_aLowRes[slot]);
+    jkRpg_aLowRes[slot] = NULL;
+    jkRpg_aLowResSource[slot] = source;
+    jkRpg_aLowResSize[slot][0] = w;
+    jkRpg_aLowResSize[slot][1] = h;
+    tVBuffer* from = source->mipSurfaces[0];
+    stdBitmap* low = jkRpg_NewBitmap(w, h);
+    tVBuffer* to = low ? low->mipSurfaces[0] : NULL;
+    if (to && stdDisplay_VBufferLock(from)) {
+        if (stdDisplay_VBufferLock(to)) {
+            for (int y = 0; y < h; y++)
+                for (int x = 0; x < w; x++) {
+                    int sx = r->x + (int)((x + 0.5f) * r->width / w), sy = r->y + (int)((y + 0.5f) * r->height / h);
+                    if (sx >= from->format.width) sx = from->format.width - 1;
+                    if (sy >= from->format.height) sy = from->format.height - 1;
+                    ((uint16_t*)to->surface_lock_alloc)[y * (to->format.rowSize / 2) + x] =
+                        ((uint16_t*)from->surface_lock_alloc)[sy * (from->format.rowSize / 2) + sx];
+                }
+            stdDisplay_VBufferUnlock(to);
+            jkRpg_aLowRes[slot] = low;
+        }
+        stdDisplay_VBufferUnlock(from);
+    }
+    if (!jkRpg_aLowRes[slot] && low) stdBitmap_Free(low);
+    return jkRpg_aLowRes[slot];
+}
+
+static void jkRpg_FreeForceGray(void);
+static void jkRpg_FreeBactaGray(void)
+{
+    if (jkRpg_pBactaGray) stdBitmap_Free(jkRpg_pBactaGray);
+    jkRpg_pBactaGray = NULL;
+    jkRpg_pBactaGraySource = NULL;
+    jkRpg_FreeForceGray();
+    for (int i = 0; i < 2; i++) {
+        if (jkRpg_aLowRes[i]) stdBitmap_Free(jkRpg_aLowRes[i]);
+        jkRpg_aLowRes[i] = jkRpg_aLowResSource[i] = NULL;
+    }
+}
+
+void jkRpg_DrawBactaHud(SithThing* p, stdFont* pFont, int gaugeX, int gaugeW)
+{
+    flex_t s = jkPlayer_hudScale * BACTA_SCALE;
+    int count = jkRpg_BactaShown(sithInventory_GetInventory(p, SITHBIN_BACTATANK));
+    uint8_t shade = count ? 255 : BACTA_DIM;
+    char text[8];
+    stdString_snprintf(text, sizeof(text), "%d", count);
+    int pad = (int)(3 * s + 0.5);
+    stdBitmap* panel = jkRpg_ShippedHudPanel(0, s);
+    float wx0, wy0, wx1, wy1; // the window for icon and count, screen pixels
+    int x = gaugeX + gaugeW + pad;
+    if (panel) {
+        int y = Video_format.height - panel->mipSurfaces[0]->format.height - pad / 2;
+        uint8_t frame = count ? 255 : 170;
+        std3D_DrawUIBitmapRGBA(panel, 0, x, y, NULL, 1, 1, 1, frame, frame, frame, 255);
+        wx0 = x + BACTA_WIN_X0 * s; wy0 = y + BACTA_WIN_Y0 * s;
+        wx1 = x + BACTA_WIN_X1 * s; wy1 = y + BACTA_WIN_Y1 * s;
+    } else {
+        int w = (int)(34 * s), h = (int)(30 * s), y = Video_format.height - h - pad, t = s >= 2 ? (int)(s / 2) : 1;
+        jkRpg_Rect(x, y, w, h, 12, 9, 7, 200);
+        jkRpg_Box(x, y, w, h, t, count ? 150 : 70, count ? 78 : 50, count ? 34 : 40);
+        wx0 = x + 2 * s; wy0 = y + 2 * s; wx1 = x + w - 2 * s; wy1 = y + h - 2 * s;
+    }
+    // Icon at most 80% of the window's height, count at 1.5x the HUD font; shrunk together to fit.
+    flex_t ts = s * 1.5f, gap = s;
+    int tw = pFont ? jkRpg_TintText(pFont, 0, 0, ts, text, 0, 0) : 0;
+    // The tank pickup in its own colours (grey when empty): the middle of its side view, as wide
+    // as the upright tank so tank and count are centred together. Without the model, the game's
+    // item icon is used as before.
+    stdBitmap* model = jkRpg_BactaModelIcon();
+    stdBitmap* icon = sithInventory_g_aTypes[SITHBIN_BACTATANK].hudBitmap;
+    flex_t size = (wy1 - wy0) * 0.8f, iconW = model ? size * BACTA_TANK_W : size;
+    flex_t fit = (wx1 - wx0) * 0.94f / (iconW + gap + tw);
+    if (fit < 1) { size *= fit; iconW *= fit; gap *= fit; ts *= fit; tw = pFont ? jkRpg_TintText(pFont, 0, 0, ts, text, 0, 0) : 0; }
+    flex_t left = (wx0 + wx1 - (iconW + gap + tw)) / 2, mid = (wy0 + wy1) / 2;
+    if (model) {
+        stdBitmap* gray = count ? NULL : jkRpg_BactaGray(model);
+        int side = model->mipSurfaces[0]->format.height, w = model->mipSurfaces[0]->format.width;
+        int cut = (int)(side * BACTA_TANK_W);
+        rdRect src = {(w - cut) / 2, 0, cut, side};
+        stdBitmap* from = gray ? gray : model;
+        int lh = (int)(size / jkPlayer_hudScale + 0.5f), lw = (int)(cut * (float)lh / side + 0.5f);
+        stdBitmap* low = jkRpg_LowRes(gray ? 1 : 0, from, &src, lw, lh);
+        if (low)
+            std3D_DrawUIBitmapRGBA(low, 0, left, mid - size / 2, NULL, size / lh, size / lh, 1, shade, shade, shade, 255);
+        else
+            std3D_DrawUIBitmapRGBA(from, 0, left, mid - size / 2, &src, size / side, size / side, 1, shade, shade, shade, 255);
+    }
+    else if (icon && icon->mipSurfaces && icon->mipSurfaces[0] && icon->mipSurfaces[0]->format.height > 2 * BACTA_INSET) {
+        stdBitmap* tank = jkRpg_BactaIcon(icon);
+        stdBitmap* draw = tank ? tank : icon;
+        flex_t is = size / draw->mipSurfaces[0]->format.height;
+        std3D_DrawUIBitmapRGBA(draw, 0, left, mid - size / 2, NULL, is, is, 1, shade, shade, shade, 255);
+    }
+    if (pFont)
+        jkRpg_TintText(pFont, (int)(left + iconW + gap), (int)(mid - stdFont_GetHeight(pFont) * ts / 2), ts, text, shade, 1);
+}
+
+// Borrow the inventory's current icon each frame; selection and HUD reloads cannot leave a stale copy.
+static stdBitmap* jkRpg_SelectedForceIcon(SithThing* p)
+{
+    if (!p || !p->actorParams.pPlayer || sithInventory_GetInventory(p, SITHBIN_JEDI_RANK) <= 0)
+        return NULL;
+    int bin = sithInventory_GetCurPower(p);
+    if (bin < 0 || bin >= SITHBIN_NUMBINS
+        || !(sithInventory_g_aTypes[bin].flags & SITHINVENTORY_TYPE_AUTOAIM)
+        || !sithInventory_IsInventoryAvailable(p, bin)
+        || sithInventory_GetInventory(p, bin) <= 0)
+        return NULL;
+    stdBitmap* icon = sithInventory_g_aTypes[bin].hudBitmap;
+    if (!icon || !icon->mipSurfaces || !icon->mipSurfaces[0]
+        || icon->mipSurfaces[0]->format.width <= 2 * BACTA_INSET
+        || icon->mipSurfaces[0]->format.height <= 2 * BACTA_INSET)
+        return NULL;
+    return icon;
+}
+
+// The Force energy each power needs to be used, from the game's own force_*.cog scripts (their
+// `cost`; every power checks energy >= cost before it starts). Unknown costs do not grey icons.
+static flex_t jkRpg_ForceCost(int bin)
+{
+    static const struct { const char* script; flex_t cost; } costs[] = {
+        {"force_jump.cog", 20}, {"force_speed.cog", 20}, {"force_pull.cog", 20}, {"force_seeing.cog", 30},
+        {"force_throw.cog", 30}, {"force_lightning.cog", 40}, {"force_grip.cog", 50}, {"force_blinding.cog", 100},
+        {"force_heal.cog", 200}, {"force_absorb.cog", 200}, {"force_destruction.cog", 200},
+        {"force_persuasion.cog", 250}, {"force_protection.cog", 300}, {"force_deadlysight.cog", 300}};
+    sithCog* cog = sithInventory_g_aTypes[bin].cog;
+    if (!cog || !cog->pScript) return 0;
+    for (int i = 0; i < (int)(sizeof(costs) / sizeof(costs[0])); i++)
+        if (!__strcmpi(cog->pScript->aName, costs[i].script)) return costs[i].cost;
+    return 0;
+}
+
+// A colourless copy of the selected power's icon, for a power the player cannot afford right now;
+// rebuilt when another power's icon is shown.
+static stdBitmap* jkRpg_pForceGray;
+static stdBitmap* jkRpg_pForceGraySource;
+// Inventory icons use their own color format and color key, not the atlas's RGB1555 alpha.
+// Keep saturated powers readable by retaining their brightest channel.
+static uint16_t jkRpg_ForceGrayPixel(uint16_t pixel, const rdTexFormat* f, uint16_t transparent)
+{
+    if (pixel == transparent) return 0;
+    int r = ((pixel >> f->r_shift) & ((1 << f->r_bits) - 1)) * 31 / ((1 << f->r_bits) - 1);
+    int g = ((pixel >> f->g_shift) & ((1 << f->g_bits) - 1)) * 31 / ((1 << f->g_bits) - 1);
+    int b = ((pixel >> f->b_shift) & ((1 << f->b_bits) - 1)) * 31 / ((1 << f->b_bits) - 1);
+    int v = r > g ? r : g;
+    if (b > v) v = b;
+    return 0x8000 | (v << 10) | (v << 5) | v;
+}
+
+static stdBitmap* jkRpg_ForceGray(stdBitmap* source)
+{
+    if (source == jkRpg_pForceGraySource) return jkRpg_pForceGray;
+    if (jkRpg_pForceGray) stdBitmap_Free(jkRpg_pForceGray);
+    jkRpg_pForceGray = NULL;
+    jkRpg_pForceGraySource = source;
+    tVBuffer* from = source->mipSurfaces[0];
+    int w = from->format.width, h = from->format.height;
+    stdBitmap* gray = jkRpg_NewBitmap(w, h);
+    tVBuffer* to = gray ? gray->mipSurfaces[0] : NULL;
+    if (to && from->format.format.bpp == 16 && stdDisplay_VBufferLock(from)) {
+        if (stdDisplay_VBufferLock(to)) {
+            for (int y = 0; y < h; y++)
+                for (int x = 0; x < w; x++)
+                    ((uint16_t*)to->surface_lock_alloc)[y * (to->format.rowSize / 2) + x] =
+                        jkRpg_ForceGrayPixel(((uint16_t*)from->surface_lock_alloc)[y * (from->format.rowSize / 2) + x],
+                            &from->format.format, (uint16_t)from->transparent_color);
+            stdDisplay_VBufferUnlock(to);
+            jkRpg_pForceGray = gray;
+        }
+        stdDisplay_VBufferUnlock(from);
+    }
+    if (!jkRpg_pForceGray && gray) stdBitmap_Free(gray);
+    return jkRpg_pForceGray;
+}
+
+static void jkRpg_FreeForceGray(void)
+{
+    if (jkRpg_pForceGray) stdBitmap_Free(jkRpg_pForceGray);
+    jkRpg_pForceGray = NULL;
+    jkRpg_pForceGraySource = NULL;
+}
+
+// Inside the right gauge, mirroring the Bacta panel's spacing and bottom alignment. A power that
+// cannot be used right now (not enough Force energy, or already running, like Speed) is shown
+// in grayscale at full brightness, with the frame retaining its normal appearance.
+void jkRpg_DrawForceHud(SithThing* p, int gaugeX)
+{
+    stdBitmap* icon = jkRpg_SelectedForceIcon(p);
+    if (!icon) return;
+    flex_t s = jkPlayer_hudScale * BACTA_SCALE;
+    int pad = (int)(3 * s + 0.5);
+    int bin = sithInventory_GetCurPower(p);
+    int usable = !sithInventory_IsInventoryActivated(p, bin)
+        && sithInventory_GetInventory(p, SITHBIN_FORCEMANA) >= jkRpg_ForceCost(bin);
+    stdBitmap* panel = jkRpg_ShippedHudPanel(1, s);
+    float wx0, wy0, wx1, wy1;
+    if (panel) {
+        int x = gaugeX - pad - panel->mipSurfaces[0]->format.width;
+        int y = Video_format.height - panel->mipSurfaces[0]->format.height - pad / 2;
+        std3D_DrawUIBitmapRGBA(panel, 0, x, y, NULL, 1, 1, 1, 255, 255, 255, 255);
+        wx0 = x + 21.0f / PLATE_TEXELS * s; wy0 = y + 19.0f / PLATE_TEXELS * s;
+        wx1 = x + 115.0f / PLATE_TEXELS * s; wy1 = y + 111.0f / PLATE_TEXELS * s;
+    } else {
+        int w = (int)(34 * s), h = (int)(30 * s), x = gaugeX - pad - w;
+        int y = Video_format.height - h - pad, t = s >= 2 ? (int)(s / 2) : 1;
+        jkRpg_Rect(x, y, w, h, 12, 9, 7, 200);
+        jkRpg_Box(x, y, w, h, t, 150, 78, 34);
+        wx0 = x + 2 * s; wy0 = y + 2 * s; wx1 = x + w - 2 * s; wy1 = y + h - 2 * s;
+    }
+    rdRect src = {BACTA_INSET, BACTA_INSET,
+        icon->mipSurfaces[0]->format.width - 2 * BACTA_INSET,
+        icon->mipSurfaces[0]->format.height - 2 * BACTA_INSET};
+    flex_t scale = fminf((wx1 - wx0) / src.width, (wy1 - wy0) / src.height) * 0.8f;
+    stdBitmap* gray = usable ? NULL : jkRpg_ForceGray(icon);
+    std3D_DrawUIBitmapRGBA(gray ? gray : icon, 0, (wx0 + wx1 - src.width * scale) / 2,
+        (wy0 + wy1 - src.height * scale) / 2, &src, scale, scale, 1, 255, 255, 255, 255);
+}
