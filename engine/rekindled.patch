+// Boss duels pay fixed amounts: the XP for the matching boss, otherwise 0. Without a victim,
+// whether the current map is a boss duel.
+static int jkRpg_BossXp(const SithThing* victim)
+{
+    static const struct { const char* map; const char* boss; int xp; } bosses[] = {
+        {"07yun.jkl", "yun", 200}, {"11gorc.jkl", "gorc", 300}, {"11gorc.jkl", "pic", 200},
+        {"15maw.jkl", "maw", 400}, {"17asarris.jkl", "sariss", 600}, {"17bsarris.jkl", "yun2", 600},
+        {"20aboc.jkl", "boc", 500}, {"20bboc.jkl", "boc", 500}};
+    const char* map = sithWorld_g_pCurrentWorld ? sithWorld_g_pCurrentWorld->map_jkl_fname : "";
+    for (int i = 0; i < (int)(sizeof(bosses) / sizeof(bosses[0])); i++) {
+        if (__strcmpi(map, bosses[i].map)) continue;
+        if (!victim) return 1;
+        if (victim->pTemplate && !__strcmpi(victim->pTemplate->aName, bosses[i].boss)) return bosses[i].xp;
+    }
+    return 0;
+}
