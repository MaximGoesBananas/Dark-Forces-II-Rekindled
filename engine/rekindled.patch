+// RPG weapon upgrades: firing, projectiles, explosions and the damage they deal or prevent.
+// docs/UPGRADES.md ("Agreed upgrades") is the design; the values below implement it.
+
+// ---- Upgrade rules: pure calculations, compiled by tools/test_weapon_upgrades.py. ----
+
+#define RPG_SUSTAIN_RAMP    1.0     // repeater: seconds of held trigger to reach the full sustained bonus
+#define RPG_BOW_STAGE       0.6     // bowcaster: original charge time per extra pair of bolts
+// Keep the stock 0/+/-6/+/-12-degree row; Full spread adds +/-18-degree outer bolts.
+#define RPG_BOW_OUTER_YAW   18.0
+#define RPG_BOW_AIM_ERROR   2.0     // each bolt varies in pitch/yaw to limit long-range precision
+#define RPG_CONC_AIM_ERROR  2.5     // concussion primary shots vary in pitch/yaw
+#define RPG_CLUSTER_DAMAGE  0.3     // rail follow-up blast damage, share of the main blast
+#define RPG_CLUSTER_RANGE   0.6     // rail follow-up blast radius, share of the main blast
+#define RPG_CLUSTER_SPREAD  0.3     // rail follow-up distance from the main blast, world units
+#define RPG_CLUSTER_DELAY   0.15    // first rail follow-up after the main blast, seconds
+#define RPG_CLUSTER_STEP    0.1     // between rail follow-ups, seconds
+#define RPG_TWIN_SPREAD     3.0     // thermal double throw: degrees each detonator turns aside
+
+// What a weapon's upgrades add up to. Base values also carry the mod's rebalancing.
+typedef struct {
+    flex_t damage;      // the player's hits
+    flex_t fireWait;    // delay between shots (1 / firing rate)
+    flex_t spread;      // aim error
+    flex_t speed;       // projectile speed
+    flex_t blast;       // blast radius; peak damage stays the same
+    flex_t falloff;     // share of the original damage loss over flight distance
+    flex_t ammo;        // ammo per shot
+    flex_t charge;      // how fast charging counts (2 = thresholds reached in half the time)
+    flex_t sustained;   // extra firing rate reached by holding the trigger
+    flex_t selfBlast;   // damage the player takes from their own blasts of this weapon
+    flex_t mineBlast;   // damage the player takes from any sequencer explosion
+    flex_t guard;       // blaster damage the player takes while the weapon is drawn
+    flex_t block;       // delay before the guard returns after a swing
+    int freeEvery;      // every Nth projectile costs no ammo
+    int bolts;          // most bolts in a charged volley
+    int cluster;        // follow-up blasts after each detonation
+    int twin;           // throw two at once
+    int recover;        // proximity mines ignore the player and can be picked up
+    int deflect;        // a longer timed-block window that returns bolts to their shooter
+} jkRpgMods;
+
+static void jkRpg_Mods(int weapon, int r, jkRpgMods* m)
+{
+    m->damage = m->fireWait = m->spread = m->speed = m->blast = m->falloff = m->ammo = m->charge = 1.0;
+    m->selfBlast = m->mineBlast = m->guard = m->block = 1.0;
+    m->sustained = 0.0;
+    m->freeEvery = m->cluster = m->twin = m->recover = m->deflect = 0;
+    m->bolts = 5;
+
+    switch (weapon) {
+    case 2: // Bryar pistol: the unlimited fallback weapon, so it hits weakly
+        m->damage = 0.6;
+        if (r >= 1) m->damage *= 1.25;
+        if (r >= 2) m->falloff = 0.5;
+        if (r >= 3) m->fireWait /= 1.25;
+        break;
+    case 3: // stormtrooper rifle: fires 25% slower and hits 25% weaker than the original
+        m->fireWait = 1.0 / 0.75;
+        m->damage = 0.75;
+        if (r >= 1) m->speed *= 1.25;
+        if (r >= 2) m->spread *= 0.5;
+        if (r >= 3) {
+            m->fireWait /= 1.25;
+            m->damage *= 0.9; // Rapid cycler: the faster rate gives a net 12.5% damage per second gain.
+        }
+        break;
+    case 4: // thermal detonators
+        if (r >= 1) m->selfBlast = 0.5;
+        if (r >= 2) m->blast *= 1.25;
+        if (r >= 3) m->twin = 1;
+        break;
+    case 5: // bowcaster: every bolt hits 25% weaker than the original
+        m->damage = 0.75;
+        if (r >= 1) m->damage *= 1.25;
+        if (r >= 2) m->charge = 2.0;
+        if (r >= 3) m->bolts = 7;
+        break;
+    case 6: // Imperial repeater: slower and a little weaker than the original
+        m->fireWait = 1.5;
+        m->damage = 0.85;
+        if (r >= 1) m->freeEvery = 4;
+        if (r >= 2) m->speed *= 1.25;
+        if (r >= 3) m->sustained = 1.0;
+        break;
+    case 7: // rail detonator: slower to fire than the original
+        m->fireWait = 1.6;
+        if (r >= 1) m->speed *= 1.25;
+        if (r >= 2) m->fireWait /= 1.25;
+        if (r >= 3) m->cluster = 4;
+        break;
+    case 8: // sequencer charges: protection before faster placement
+        if (r >= 1) m->mineBlast = 0.35;
+        if (r >= 2) m->fireWait /= 1.5;
+        if (r >= 3) m->recover = 1;
+        break;
+    case 9: // concussion rifle: slower to fire than the original
+        m->fireWait = 1.25;
+        if (r >= 1) m->selfBlast = 0.5;
+        if (r >= 2) m->ammo = 0.75;
+        if (r >= 3) m->blast *= 1.25;
+        break;
+    case 10: // lightsaber: defence and recovery, never faster strikes
+        if (r >= 1) m->guard = 0.75;
+        if (r >= 2) m->deflect = 1;
+        if (r >= 3) m->block = 0.5;
+        break;
+    }
+}
+
+// Damage-decay bolts lose `rate` per second down to a minimum. Keep only `keep` of every loss,
+// including the largest one at long range.
+static void jkRpg_FocusBolt(flex_t damage, flex_t* pMinDamage, flex_t* pRate, flex_t keep)
+{
+    *pMinDamage = damage - (damage - *pMinDamage) * keep;
+    *pRate *= keep;
+}
+
+// Holding the trigger raises the firing rate linearly from normal to (1 + bonus) over the ramp.
+static flex_t jkRpg_SustainedWait(flex_t wait, flex_t held, flex_t bonus)
+{
+    if (held < 0) held = 0;
+    if (held > RPG_SUSTAIN_RAMP) held = RPG_SUSTAIN_RAMP;
+    return wait / (1.0 + bonus * held / RPG_SUSTAIN_RAMP);
+}
+
+// Counts projectiles: returns how many of the next `shots` are free, one in every `every`.
+static int jkRpg_FreeShots(int* pCount, int shots, int every)
+{
+    if (every <= 0 || shots <= 0)
+        return 0;
+    int total = *pCount + shots;
+    *pCount = total % every;
+    return total / every;
+}
+
+// Concussion rifle cells per shot: primary 8, alternate 4 in the original.
+static flex_t jkRpg_ConcussionCost(int mode, flex_t share)
+{
+    return (mode == 1 ? 4.0 : 8.0) * share;
+}
+
+// Extra pairs of bolts a charge has reached (charge already counts upgrade speed), up to the volley size.
+static int jkRpg_BowStages(flex_t charge, int bolts)
+{
+    int stages = 0;
+    while (stages < (bolts - 1) / 2 && charge > RPG_BOW_STAGE * (stages + 1))
+        stages++;
+    return stages;
+}
+
+// Follow-up blasts only come from a detonating projectile, never from another blast.
+static int jkRpg_ClusterSize(const jkRpgMods* m, int bFromProjectile)
+{
+    return bFromProjectile ? m->cluster : 0;
+}
+
+// ---- End of upgrade rules. ----
+
+// ---- Lightsaber controls: pure rules, compiled by tools/test_saber_guard.py. ----
+
+#define RPG_SABER_CHARGE    1.0     // seconds an attack is held before its release is the heavy swing
+#define RPG_SABER_POSE      0.15    // a held attack starts drawing the saber back after this
+#define RPG_SABER_RECOVERY  0.5     // the guard returns this long after a swing starts (Quicker recovery: half)
+#define RPG_SABER_BUFFER    0.5     // a click released during recovery still swings if recovery ends by then
+#define RPG_GUARD_LIMIT     100.0   // blocked saber damage that breaks the guard
+#define RPG_GUARD_DECAY     10.0    // blocked saber damage the guard recovers per second
+#define RPG_GUARD_BROKEN    1.5     // seconds without a guard after it breaks
+#define RPG_GUARD_CONE      0.25    // facing dot product a raised guard covers (about 75 degrees)
+#define RPG_PARRY_WINDOW    0.5     // a guard raised this recently sends a blocked bolt straight back
+#define RPG_PARRY_UPGRADED  0.8     // the same window with Accurate deflection
+#define RPG_PARRY_DAMAGE    1.5     // a bolt sent straight back hits this much harder
+#define RPG_GLANCE_MIN      20.0    // an untimed block turns the bolt this many degrees aside, at least
+#define RPG_GLANCE_MAX      45.0    // and at most
+#define RPG_GLANCE_PITCH    10.0    // with up to this much up or down
+
+enum { RPG_SWING_NONE, RPG_SWING_NORMAL, RPG_SWING_HEAVY };
+
+typedef struct {
+    flex_t pressed;     // when the held attack started counting toward a heavy swing; -1 when not held
+    flex_t released;    // when a click was released during recovery; -1 when none waits
+    flex_t swung;       // when the last swing started
+    flex_t broken;      // the guard is unavailable until then
+    flex_t strain;      // blocked saber damage not yet recovered
+    flex_t strainAt;    // when strain was last updated
+    flex_t raised;      // when the guard was last raised
+    int latched;        // ignore the attack button until it is released
+    int charging;       // the saber is being drawn back
+    int charged;        // releasing now swings heavy
+    int guard;          // the guard is raised
+} jkRpgSaber;
+
+static void jkRpg_SaberReset(jkRpgSaber* s)
+{
+    *s = (jkRpgSaber){-1, -1, -100, -100, 0, 0, -100, 1, 0, 0, 0};
+}
+
+// One control update; returns the swing to start now. `ready` means the saber may start a swing.
+// Every swing starts on release: after a full charge it is the heavy swing, otherwise a normal one.
+// Attacking, charging and recovering keep the guard down.
+static int jkRpg_SaberStep(jkRpgSaber* s, int attack, int block, int ready, flex_t now, flex_t recovery)
+{
+    int swing = RPG_SWING_NONE;
+    if (!attack)
+        s->latched = 0;
+    if (attack && !s->latched) {
+        if (s->pressed < 0 || !ready)
+            s->pressed = now; // the charge counts once the previous swing has recovered
+    }
+    else if (s->pressed >= 0) {
+        if (ready && now - s->pressed >= RPG_SABER_CHARGE)
+            swing = RPG_SWING_HEAVY;
+        else
+            s->released = now;
+        s->pressed = -1;
+    }
+    if (s->released >= 0 && now - s->released > RPG_SABER_BUFFER)
+        s->released = -1;
+    if (s->released >= 0 && ready) {
+        swing = RPG_SWING_NORMAL;
+        s->released = -1;
+    }
+    if (swing)
+        s->swung = now;
+    s->charging = s->pressed >= 0 && ready && now - s->pressed >= RPG_SABER_POSE;
+    s->charged = s->pressed >= 0 && ready && now - s->pressed >= RPG_SABER_CHARGE;
+    int guard = block && s->pressed < 0 && s->released < 0
+        && now >= s->swung + recovery && now >= s->broken;
+    if (guard && !s->guard)
+        s->raised = now;
+    s->guard = guard;
+    return swing;
+}
+
+// A guard raised just before a bolt arrives returns it straight to its shooter.
+static int jkRpg_TimedBlock(const jkRpgSaber* s, flex_t now, int upgraded)
+{
+    return s->guard && now >= s->raised && now - s->raised <= (upgraded ? RPG_PARRY_UPGRADED : RPG_PARRY_WINDOW);
+}
+
+// A blocked enemy saber blow strains the guard; enough of them in quick succession break it.
+static int jkRpg_GuardStrain(jkRpgSaber* s, flex_t damage, flex_t now)
+{
+    flex_t recovered = now > s->strainAt ? (now - s->strainAt) * RPG_GUARD_DECAY : 0;
+    s->strain = (s->strain > recovered ? s->strain - recovered : 0) + damage;
+    s->strainAt = now;
+    if (s->strain < RPG_GUARD_LIMIT)
+        return 0;
+    s->strain = 0;
+    s->broken = now + RPG_GUARD_BROKEN;
+    s->guard = 0;
+    return 1;
+}
+
+// ---- End of lightsaber control rules. ----
+
+#define RPG_TAGS 8192
+
+// Weapon inventory bins.
+#define RPG_THERMAL     4
+#define RPG_RIFLE       3
+#define RPG_BOWCASTER   5
+#define RPG_SEQUENCER   8
+#define RPG_CONCUSSION  9
+
+static flex_t jkRpg_rifleShot = -1; // game time of the player's last rifle shot (its muzzle flash)
+
+// Which weapon fired a projectile or explosion, keyed by thing index and checked by signature.
+static uint32_t jkRpg_aTagSig[RPG_TAGS];
+static uint8_t jkRpg_aTagWeapon[RPG_TAGS];
+
+// Follow-up blasts, created a moment after an explosion.
+typedef struct {
+    SithThing* pTemplate;
+    rdVector3 pos;
+    SithSector* pSector;
+    flex_t time, range, damage, offset;
+    int weapon;
+} jkRpgPendingBlast;
+static jkRpgPendingBlast jkRpg_aPending[32];
+static int jkRpg_numPending = 0;
+
+static int jkRpg_repeaterShots = 0;     // projectiles since the last free repeater round
+static flex_t jkRpg_bowCharge = 0;      // last bowcaster charge, in original-speed seconds
+static int jkRpg_bowSides = 0;          // side bolts fired in the current bowcaster volley
+static rdVector3 jkRpg_bowDir, jkRpg_bowPos;
+
+static int jkRpg_WeaponRank(SithThing* p, int weapon)
+{
+    for (int i = 0; i < UP_COUNT; i++)
+        if (jkRpg_aUpgrades[i].weapon == weapon)
+            return jkRpg_Rank(p, i);
+    return 0; // fists have no upgrades
+}
+
+static void jkRpg_GetMods(SithThing* p, int weapon, jkRpgMods* m)
+{
+    jkRpg_Mods(weapon, jkRpg_WeaponRank(p, weapon), m);
+}
+
+static int jkRpg_CurWeapon(SithThing* p)
+{
+    return sithInventory_GetCurrentWeapon(p);
+}
+
+// Exactly this template, not one based on it (+crossbowbolt2 is based on +crossbowbolt).
+static int jkRpg_IsTemplate(SithThing* pTemplate, const char* pName)
+{
+    return pTemplate && pTemplate == sithTemplate_GetTemplate(pName);
+}
+
+// The projectiles each weapon fires, so Force powers cast while holding it are left alone.
+static const char* jkRpg_aShots[11][3] = {
+    {0}, {0}, {"+bryarbolt"}, {"+stlaser"}, {"+grenade1", "+grenade2"},
+    {"+crossbowbolt", "+crossbowbolt2", "+crossbowbolt3"}, {"+repeaterball"},
+    {"+raildet", "+raildet2"}, {"+seqchrg", "+seqchrg2"}, {"+concbullet", "+concblast2"}, {0}
+};
+
+// A blast one of the weapon's own projectiles makes, on impact or on a body.
+static int jkRpg_IsWeaponBlast(int weapon, SithThing* pTemplate)
+{
+    if (weapon < 2 || weapon > 9 || !pTemplate)
+        return 0;
+    for (int i = 0; i < 3 && jkRpg_aShots[weapon][i]; i++) {
+        SithThing* shot = sithTemplate_GetTemplate(jkRpg_aShots[weapon][i]);
+        if (shot && (shot->weaponParams.pExplosionTemplate == pTemplate || shot->weaponParams.fleshHitTemplate == pTemplate))
+            return 1;
+    }
+    return 0;
+}
+
+static int jkRpg_IsWeaponShot(int weapon, SithThing* pTemplate)
+{
+    const char* (*shots)[3] = jkRpg_aShots;
+    if (weapon < 2 || weapon > 9)
+        return 0;
+    for (int i = 0; i < 3 && shots[weapon][i]; i++)
+        if (jkRpg_IsTemplate(pTemplate, shots[weapon][i]))
+            return 1;
+    return 0;
+}
+
+static void jkRpg_Tag(SithThing* pThing, int weapon)
+{
+    if (!pThing || pThing->idx < 0 || pThing->idx >= RPG_TAGS)
+        return;
+    jkRpg_aTagSig[pThing->idx] = pThing->signature;
+    jkRpg_aTagWeapon[pThing->idx] = (uint8_t)weapon;
+}
+
+static int jkRpg_TagOf(SithThing* pThing)
+{
+    if (!pThing || pThing->idx < 0 || pThing->idx >= RPG_TAGS || jkRpg_aTagSig[pThing->idx] != pThing->signature)
+        return 0;
+    return jkRpg_aTagWeapon[pThing->idx];
+}
+
+// Sequencer explosions: the player's charges and the levels' enemy mines.
+static int jkRpg_IsSequencerBlast(SithThing* pTemplate)
+{
+    return jkRpg_IsTemplate(pTemplate, "+sequencer_exp") || jkRpg_IsTemplate(pTemplate, "+esequencer_exp");
+}
+
+// Force powers' projectiles (Destruction's +force_dest_p1-4 carry energy damage) are not blaster fire.
+static int jkRpg_IsForceShot(const SithThing* t)
+{
+    return t && t->pTemplate && !__strnicmp(t->pTemplate->aName, "+force", 6);
+}
+
+// Enemy detonators: the rail detonator's direct hit and the enemies' rail and thermal blasts.
+#define RPG_ENEMY_DETONATOR 0.75 // their damage before shields, shields and health alike
+static int jkRpg_IsEnemyDetonator(SithThing* pDamager, SithThing* p)
+{
+    return pDamager && sithThing_GetThingParent(pDamager) != p
+        && (jkRpg_IsTemplate(pDamager->pTemplate, "+eraildet") || jkRpg_IsTemplate(pDamager->pTemplate, "+eraildet_exp")
+            || jkRpg_IsTemplate(pDamager->pTemplate, "+egrenade_exp"));
+}
+
+// Create a damaging blast from any explosion template, credited to the player and the weapon.
+static void jkRpg_Blast(SithThing* pTemplate, rdVector3* pPos, SithSector* pSector, int weapon, flex_t range, flex_t damage, flex_t offset)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!pTemplate || !pSector || !p)
+        return;
+    SithThing* e = sithThing_CreateThingAtPos(pTemplate, pPos, &rdroid_identMatrix34, pSector, p);
+    if (!e)
+        return;
+    if (offset > 0) {
+        // Mostly sideways, a little upward; walls stop the move so blasts stay on this side of cover.
+        rdVector3 dir = {(flex_t)(_frand() * 2.0 - 1.0), (flex_t)(_frand() * 2.0 - 1.0), (flex_t)(_frand() * 0.5)};
+        rdVector_Normalize3Acc(&dir);
+        sithCollision_MoveThing(e, &dir, offset, 0);
+    }
+    if (e->type == SITH_THING_EXPLOSION) {
+        if (range > 0) e->explosionParams.range = range;
+        if (damage > 0) e->explosionParams.damage = damage;
+        e->explosionParams.flags |= SITHEXPLOSION_FLAG_HAS_BLAST_PHASE | SITHEXPLOSION_FLAG_NO_DAMAGE_TO_SHOOTER;
+        e->explosionParams.msecBlastTime = e->msecLifeLeft;
+    }
+    jkRpg_Tag(e, weapon);
+}
+
+static void jkRpg_QueueBlast(SithThing* pTemplate, SithThing* pAt, int weapon, flex_t delay, flex_t range, flex_t damage, flex_t offset)
+{
+    if (jkRpg_numPending >= (int)(sizeof(jkRpg_aPending) / sizeof(jkRpg_aPending[0])) || !pTemplate)
+        return;
+    jkRpgPendingBlast* b = &jkRpg_aPending[jkRpg_numPending++];
+    b->pTemplate = pTemplate;
+    b->pos = pAt->position;
+    b->pSector = pAt->sector;
+    b->time = sithTime_g_secGameTime + delay;
+    b->range = range;
+    b->damage = damage;
+    b->offset = offset;
+    b->weapon = weapon;
+}
+
+static void jkRpg_RunPendingBlasts(void)
+{
+    for (int i = 0; i < jkRpg_numPending; ) {
+        jkRpgPendingBlast* b = &jkRpg_aPending[i];
+        if (sithTime_g_secGameTime < b->time) {
+            i++;
+            continue;
+        }
+        jkRpgPendingBlast blast = *b;
+        jkRpg_aPending[i] = jkRpg_aPending[--jkRpg_numPending];
+        jkRpg_Blast(blast.pTemplate, &blast.pos, blast.pSector, blast.weapon, blast.range, blast.damage, blast.offset);
+    }
+}
+
+flex_t jkRpg_FireWait(SithThing* pThing, flex_t wait)
+{
+    if (wait <= 0 || !jkRpg_IsActive(pThing))
+        return wait;
+    jkRpgMods m;
+    jkRpg_GetMods(pThing, jkRpg_CurWeapon(pThing), &m);
+    wait *= m.fireWait;
+    // Sustained fire: only the primary stream, measured from when the trigger went down.
+    if (m.sustained > 0 && sithWeapon_CurWeaponMode == 0 && sithWeapon_8BD0A0[0] >= 0)
+        wait = jkRpg_SustainedWait(wait, sithTime_g_secGameTime - sithWeapon_8BD0A0[0], m.sustained);
+    return wait;
+}
+
+// How long a charged weapon was held. The bowcaster's primary charge counts faster when upgraded.
+flex_t jkRpg_ChargeTime(SithThing* pThing, int mode, flex_t held)
+{
+    if (!jkRpg_IsActive(pThing) || jkRpg_CurWeapon(pThing) != RPG_BOWCASTER || mode != 0)
+        return held;
+    jkRpgMods m;
+    jkRpg_GetMods(pThing, RPG_BOWCASTER, &m);
+    jkRpg_bowCharge = held * m.charge;
+    return jkRpg_bowCharge;
+}
+
+void jkRpg_AdjustAim(SithThing* pShooter, SithThing* pProjectile, rdVector3* pAimError)
+{
+    if (!jkRpg_IsActive(pShooter) || !pAimError)
+        return;
+    jkRpgMods m;
+    jkRpg_GetMods(pShooter, jkRpg_CurWeapon(pShooter), &m);
+    rdVector_Scale3Acc(pAimError, m.spread);
+    if (jkRpg_CurWeapon(pShooter) == RPG_CONCUSSION
+        && jkRpg_IsTemplate(pProjectile, "+concbullet")) {
+        pAimError->x += (_frand() * 2.0 - 1.0) * RPG_CONC_AIM_ERROR;
+        pAimError->y += (_frand() * 2.0 - 1.0) * RPG_CONC_AIM_ERROR;
+    }
+}
+
+// Converge the Bryar muzzle on the first solid point under the first-person crosshair.
+// Keep the normal muzzle collision sweep, so nearby cover still blocks the shot.
+void jkRpg_AimBryar(SithThing* shooter, SithThing* projectile, rdVector3* direction, rdVector3* muzzle)
+{
+    SithCamera* camera = sithCamera_g_pCurCamera;
+    if (!jkRpg_IsActive(shooter) || jkRpg_CurWeapon(shooter) != 2 || !projectile || !camera
+        || camera != &sithCamera_g_aCameras[0] || camera->pPrimaryFocusThing != shooter || !camera->sector
+        || projectile != sithTemplate_GetTemplate("+bryarbolt"))
+        return;
+    rdVector3 ray = camera->orient.lvec;
+    if (rdVector_Normalize3Acc(&ray) <= 0) return;
+    flex_t distance = 100.0;
+    // Use projectile collision rules: pickups that the player can collect do not stop bolts.
+    SithThing probe = *projectile;
+    probe.pParent = shooter;
+    probe.parentSignature = shooter->signature;
+    sithCollision_SearchForCollisions(camera->sector, &probe, &camera->lookPos, &ray, distance, 0, 0);
+    SithCollision* hit;
+    while ((hit = sithCollision_PopStack())) {
+        if (!(hit->type & (SITHCOLLISION_WORLD | SITHCOLLISION_THING))) continue;
+        distance = hit->distance;
+        break;
+    }
+    sithCollision_DecreaseStackLevel();
+    rdVector3 target = camera->lookPos;
+    rdVector_ScaleAdd3Acc(&target, &ray, distance);
+    rdVector3 aimed;
+    rdVector_Sub3(&aimed, &target, muzzle);
+    // A surface closer than the muzzle must not make the bolt turn back toward the player.
+    // Start on the camera ray in this case; WeaponFireProjectile still sweeps from the body.
+    if (rdVector_Dot3(&aimed, &ray) <= 0.001) {
+        *muzzle = camera->lookPos;
+        *direction = ray;
+    }
+    else if (rdVector_Normalize3Acc(&aimed) > 0) *direction = aimed;
+}
+
+// Stock thermals add 36.87 degrees of local lift, which sends steep upward throws backward.
+// Aim the launch itself; gravity supplies the arc. Run before the muzzle collision sweep so
+// nearby walls can still stop or bounce the throw, including the second Double throw grenade.
+void jkRpg_AimThermal(SithThing* shooter, SithThing* projectile, SithThing* fired, const rdVector3* direction)
+{
+    if (Main_bMotsCompat || !jkRpg_IsActive(shooter) || jkRpg_CurWeapon(shooter) != RPG_THERMAL
+        || !jkRpg_IsWeaponShot(RPG_THERMAL, projectile) || !fired || fired->moveType != SITH_MT_PHYSICS)
+        return;
+    rdVector3 aim = *direction;
+    if (rdVector_Normalize3Acc(&aim) > 0)
+        rdVector_Scale3(&fired->physicsParams.vel, &aim, rdVector_Len3(&fired->physicsParams.vel));
+}
+
+static void jkRpg_PrepareProjectile(SithThing* pProj, int weapon, const jkRpgMods* m)
+{
+    if (!pProj)
+        return;
+    jkRpg_Tag(pProj, weapon);
+    if (weapon == RPG_BOWCASTER && pProj->moveType == SITH_MT_PHYSICS) {
+        rdVector3 error = {(_frand() * 2.0 - 1.0) * RPG_BOW_AIM_ERROR,
+            (_frand() * 2.0 - 1.0) * RPG_BOW_AIM_ERROR, 0.0};
+        rdVector_Rotate3Acc(&pProj->physicsParams.vel, &error);
+        rdVector3 direction = pProj->physicsParams.vel;
+        if (rdVector_Normalize3Acc(&direction) > 0)
+            rdMatrix_BuildFromLook34(&pProj->orient, &direction);
+    }
+    if (m->speed != 1.0 && pProj->moveType == SITH_MT_PHYSICS)
+        rdVector_Scale3Acc(&pProj->physicsParams.vel, m->speed);
+    if (m->falloff != 1.0 && pProj->type == SITH_THING_WEAPON && (pProj->weaponParams.flags & SITH_WF_DAMAGE_DECAY))
+        jkRpg_FocusBolt(pProj->weaponParams.damage, &pProj->weaponParams.minDamage, &pProj->weaponParams.rate, m->falloff);
+}
+
+// An extra projectile fired by an upgrade: aimed `pyr` degrees from `pDir`, from the same muzzle.
+static SithThing* jkRpg_FireExtra(SithThing* pShooter, SithThing* pTemplate, const rdVector3* pDir, rdVector3* pPos, rdVector3 pyr, flex_t scale, int flags, int extra, int weapon, const jkRpgMods* m)
+{
+    rdMatrix34 orient;
+    rdMatrix_BuildFromLook34(&orient, pDir);
+    rdMatrix_PreRotate34(&orient, &pyr);
+    rdVector3 dir = orient.lvec;
+    SithThing* pExtra = sithWeapon_WeaponFireProjectile(pShooter, pTemplate, &dir, pPos, NULL, -1, scale, (char)flags, 0.0, extra);
+    jkRpg_PrepareProjectile(pExtra, weapon, m);
+    return pExtra;
+}
+
+// Preserve the script's five-bolt horizontal row. A third charge stage adds one
+// bolt outside each edge for one more cell (seven in total).
+static void jkRpg_BowcasterVolley(SithThing* pShooter, SithThing* pTemplate, SithThing* pFired, rdVector3* pFireDir, rdVector3* pFirePos, const jkRpgMods* m)
+{
+    if (jkRpg_IsTemplate(pTemplate, "+crossbowbolt")) {
+        jkRpg_bowSides = 0;
+        jkRpg_bowDir = *pFireDir;
+        jkRpg_bowPos = *pFirePos;
+        return;
+    }
+    if (!jkRpg_IsTemplate(pTemplate, "+crossbowbolt2") || ++jkRpg_bowSides < 3)
+        return;
+    if (jkRpg_bowSides != 4 || jkRpg_BowStages(jkRpg_bowCharge, m->bolts) < 3)
+        return;
+    // The script takes two cells for its outer pair after this bolt; reserve one for the extra pair.
+    if (sithInventory_GetInventory(pShooter, SITHBIN_POWER) - 2.0 < 1.0)
+        return;
+    for (int i = -1; i <= 1; i += 2) {
+        rdVector3 pyr = {0.0, (flex_t)(i * RPG_BOW_OUTER_YAW), 0.0};
+        jkRpg_FireExtra(pShooter, pTemplate, &jkRpg_bowDir, &jkRpg_bowPos, pyr, 1.0, 0, 0, RPG_BOWCASTER, m);
+    }
+    sithInventory_ChangeInventory(pShooter, SITHBIN_POWER, -1.0);
+}
+
+// Thermal detonators: a second real detonator with the same throw strength and fuse mode. Both turn
+// a little aside so they land apart. The last detonator is thrown normally.
+static void jkRpg_TwinThrow(SithThing* pShooter, SithThing* pTemplate, SithThing* pFired, rdVector3* pFireDir, rdVector3* pFirePos, flex_t scale, int flags, int extra, const jkRpgMods* m)
+{
+    // The script takes its own detonator after this throw.
+    if (sithInventory_GetInventory(pShooter, RPG_THERMAL) < 2.0)
+        return;
+    SithThing* pSecond = jkRpg_FireExtra(pShooter, pTemplate, pFireDir, pFirePos, (rdVector3){0, 0, 0}, scale, flags, extra, RPG_THERMAL, m);
+    if (!pSecond)
+        return;
+    rdVector3 left = {0.0, RPG_TWIN_SPREAD, 0.0}, right = {0.0, -RPG_TWIN_SPREAD, 0.0};
+    rdVector_Rotate3Acc(&pFired->physicsParams.vel, &right);
+    rdVector_Rotate3Acc(&pSecond->physicsParams.vel, &left);
+    sithInventory_ChangeInventory(pShooter, RPG_THERMAL, -1.0);
+}
+
+void jkRpg_OnFire(SithThing* pShooter, SithThing* pTemplate, SithThing* pFired, rdVector3* pFireDir, rdVector3* pFirePos, flex_t scale, int16_t flags, int extra)
+{
+    if (!jkRpg_IsActive(pShooter) || !pFired)
+        return;
+    int weapon = jkRpg_CurWeapon(pShooter);
+    if (!jkRpg_IsWeaponShot(weapon, pTemplate))
+        return;
+    if (weapon == RPG_RIFLE)
+        jkRpg_rifleShot = sithTime_g_secGameTime; // the muzzle flash
+    jkRpgMods m;
+    jkRpg_GetMods(pShooter, weapon, &m);
+    jkRpg_PrepareProjectile(pFired, weapon, &m);
+    if (weapon == RPG_BOWCASTER && m.bolts > 5)
+        jkRpg_BowcasterVolley(pShooter, pTemplate, pFired, pFireDir, pFirePos, &m);
+    if (weapon == RPG_THERMAL && m.twin)
+        jkRpg_TwinThrow(pShooter, pTemplate, pFired, pFireDir, pFirePos, scale, flags, extra, &m);
+}
+
+void jkRpg_OnWeaponExplosion(SithThing* pWeapon, SithThing* pExplosion)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!jkRpg_IsActive(p) || !pExplosion || pExplosion->type != SITH_THING_EXPLOSION)
+        return;
+    jkRpg_ForceBlast(pWeapon, pExplosion);
+    int weapon = jkRpg_TagOf(pWeapon);
+    // A point-blank shot can explode while it is being created, before jkRpg_OnFire tags it.
+    if (!weapon && sithThing_GetThingParent(pWeapon) == p && jkRpg_IsWeaponShot(jkRpg_CurWeapon(p), pWeapon->pTemplate))
+        weapon = jkRpg_CurWeapon(p);
+    if (!weapon)
+        return;
+    jkRpg_Tag(pExplosion, weapon);
+    jkRpgMods m;
+    jkRpg_GetMods(p, weapon, &m);
+    if (m.blast != 1.0)
+        pExplosion->explosionParams.range *= m.blast;
+
+    // Rail cluster: small blasts around the detonation shortly afterwards. Prefer the game's small
+    // debris explosion for the look; fall back to the main blast's own effect.
+    int count = jkRpg_ClusterSize(&m, pWeapon->type == SITH_THING_WEAPON);
+    SithThing* pSmall = sithTemplate_GetTemplate("+debris_exp");
+    for (int i = 0; i < count; i++)
+        jkRpg_QueueBlast(pSmall ? pSmall : pExplosion->pTemplate, pExplosion, weapon,
+            RPG_CLUSTER_DELAY + RPG_CLUSTER_STEP * i, pExplosion->explosionParams.range * RPG_CLUSTER_RANGE,
+            pExplosion->explosionParams.damage * RPG_CLUSTER_DAMAGE, RPG_CLUSTER_SPREAD);
+}
+
+void jkRpg_WeaponTick(SithThing* pWeapon)
+{
+}
+
+// A proximity mine's sphere was touched. With mine recovery the player never sets one off: an armed
+// sequencer mine becomes a carried charge, or stays where it is when no more fit.
+int jkRpg_MineTouched(SithThing* pMine, SithThing* pThing)
+{
+    if (!jkRpg_IsActive(pThing) || pMine->type != SITH_THING_WEAPON || !(pMine->weaponParams.flags & SITH_WF_PROXIMITY)
+        || (pMine->flags & (SITH_TF_DESTROYED | SITH_TF_DEAD)) || !jkRpg_IsSequencerBlast(pMine->weaponParams.pExplosionTemplate))
+        return 0;
+    jkRpgMods m;
+    jkRpg_GetMods(pThing, RPG_SEQUENCER, &m);
+    if (!m.recover)
+        return 0;
+    if (sithInventory_GetInventory(pThing, RPG_SEQUENCER) >= sithInventory_g_aTypes[RPG_SEQUENCER].max)
+        return 1;
+    pMine->weaponParams.flags &= ~(SITH_WF_PROXIMITY | SITH_WF_EXPLODE);
+    sithThing_DestroyThing(pMine);
+    // Added directly, never through a pickup script, so Scavenger bonuses cannot recycle mines into ammo.
+    sithInventory_ChangeInventory(pThing, RPG_SEQUENCER, 1.0);
+    sithSound* pSound = sithSound_Load("thrmlpu2.wav", 0);
+    if (pSound)
+        sithSoundMixer_PlaySoundThing(pSound, pThing, 1.0, 0.5, 2.5, SITHSOUNDFLAG_FOLLOWSTHING);
+    sithPlayer_AddDynamicTint(0.0, 0.0, 0.2);
+    sithConsole_PrintString("Sequencer charge recovered");
+    return 1;
+}
+
+static jkRpgSaber jkRpg_saber = {-1, -1, -100, -100, 0, 0, -100, 1, 0, 0, 0};
+static flex_t jkRpg_saberUpdated = -1;          // game time of the last control update
+static int jkRpg_aSaberTrack[4] = {-1, -1, -1, -1}; // wind-up, then guard: first-person and body
+
+// The heavy swing's first-person and body animations, named as the stock saber script loads
+// them so both share one loaded keyframe. At frame 1 the blade is raised high in front of the
+// player; frames 2-5 swing it out of first-person view before it sweeps across.
+static const char* const jkRpg_aHeavyKey[2] = {"SabVch.key", "KYcharge.key"};
+#define RPG_HEAVY_APEX 1.0
+#define RPG_GUARD_FRAME 5.0
+
+// A timed block sends the bolt straight back to its shooter, half as hard again; Accurate deflection widens the timing.
+// A guard that was already up glances the bolt aside instead, so it no longer flies back, and
+// the bolt wears the guard like a saber blow: sustained fire eventually breaks a held guard.
+void jkRpg_OnDeflect(SithThing* pBolt, SithThing* pBlocker)
+{
+    if (!jkRpg_IsActive(pBlocker) || jkRpg_CurWeapon(pBlocker) != SITHBIN_LIGHTSABER)
+        return;
+    jkRpgMods m;
+    jkRpg_GetMods(pBlocker, SITHBIN_LIGHTSABER, &m);
+    SithThing* pShooter = pBolt->pParent;
+    rdVector3 aim;
+    flex_t speed = rdVector_Len3(&pBolt->physicsParams.vel);
+    int timed = jkRpg_TimedBlock(&jkRpg_saber, sithTime_g_secGameTime, m.deflect);
+    if (!timed && pBolt->type == SITH_THING_WEAPON)
+        jkRpg_OnGuardBlow(pBlocker, pBolt->weaponParams.damage);
+    if (timed
+        && pShooter && pShooter != pBlocker && pShooter->signature == pBolt->parentSignature
+        && (pShooter->type == SITH_THING_ACTOR || pShooter->type == SITH_THING_PLAYER)
+        && !(pShooter->flags & (SITH_TF_DEAD | SITH_TF_DESTROYED))) {
+        rdVector_Sub3(&aim, &pShooter->position, &pBolt->position);
+        if (rdVector_Normalize3Acc(&aim) > 0 && speed > 0)
+            rdVector_Scale3(&pBolt->physicsParams.vel, &aim, speed);
+        // The bolt returns with its original damage plus the bonus and stops losing damage over
+        // distance, so the bonus still applies when it arrives. Setting it (not multiplying) means a
+        // bolt parried twice keeps the same bonus.
+        if (pBolt->type == SITH_THING_WEAPON && pBolt->pTemplate) {
+            pBolt->weaponParams.damage = pBolt->pTemplate->weaponParams.damage * RPG_PARRY_DAMAGE;
+            pBolt->weaponParams.rate = 0;
+        }
+        return;
+    }
+    flex_t side = _frand() < 0.5 ? -1.0 : 1.0;
+    rdVector3 glance = {(flex_t)((_frand() - 0.5) * 2.0 * RPG_GLANCE_PITCH),
+                        (flex_t)(side * (RPG_GLANCE_MIN + _frand() * (RPG_GLANCE_MAX - RPG_GLANCE_MIN))), 0.0};
+    rdVector_Rotate3Acc(&pBolt->physicsParams.vel, &glance);
+}
+
+static int jkRpg_SaberFresh(void)
+{
+    flex_t now = sithTime_g_secGameTime;
+    return jkRpg_saberUpdated >= 0 && now >= jkRpg_saberUpdated && now - jkRpg_saberUpdated < 0.25;
+}
+
+// Held RPG poses use reserved priorities and belong to live input, not a saved animation.
+// Call only for the local player's body or first-person puppet.
+int jkRpg_IsSaberPoseTrack(const rdPuppetTrack* track)
+{
+    return !Main_bMotsCompat && !sithNet_isMulti && track->lowPri == 3 && track->highPri == 5;
+}
+
+static rdPuppet* jkRpg_SaberPuppet(SithThing* p, int view)
+{
+    return view ? p->renderData.puppet : p->playerInfo ? p->playerInfo->povModel.puppet : NULL;
+}
+
+// The stock block reaction, held mid-way for the guard: the blade crosses the body.
+static const char* const jkRpg_aGuardKey[2] = {"SabVblk2.key", "KYblock2.key"};
+
+static rdKeyframe* jkRpg_PoseKey(int pose, int view)
+{
+    return sithKeyFrame_LoadEntry(pose ? jkRpg_aGuardKey[view] : jkRpg_aHeavyKey[view]);
+}
+
+// Whether a pose still plays on its track. kyle.cog stops first-person tracks by slot numbers
+// it never clears, so a slot can be stopped under the pose or reused by another animation.
+static int jkRpg_PoseHeld(rdPuppet* puppet, int track, int pose, int view)
+{
+    return puppet && track >= 0 && track < RDPUPPET_MAX_TRACKS && (puppet->aTracks[track].status & 2)
+        && puppet->aTracks[track].keyframe == jkRpg_PoseKey(pose, view);
+}
+
+// Blend a saber pose in or out in one camera view: the first-person model (0) or the body (1).
+// Pose 0 is the wind-up: the heavy swing played slowly to its raised frame as the charge
+// completes, then held. Pose 1 is the guard, held on one frame of the block reaction.
+// Poses outrank the stock block reaction (priority 2/4), which would otherwise cover them after
+// every blocked bolt; when a pose fades out, the stock swing beneath it takes over.
+static void jkRpg_SaberPoseView(SithThing* p, int pose, int view, int on)
+{
+    rdPuppet* puppet = jkRpg_SaberPuppet(p, view);
+    int* track = &jkRpg_aSaberTrack[pose * 2 + view];
+    if (jkRpg_PoseHeld(puppet, *track, pose, view))
+        sithPuppet_StopKey(puppet, *track, 0.15);
+    *track = -1;
+    rdKeyframe* key = on && puppet ? jkRpg_PoseKey(pose, view) : NULL;
+    if (!key || (*track = sithPuppet_PlayKey(puppet, key, 3, 5, 0x14, 0)) < 0)
+        return;
+    puppet->aTracks[*track].playSpeed = 0.0; // fade in from the current pose
+    rdPuppet_FadeInTrack(puppet, *track, 0.15);
+    if (pose) {
+        puppet->aTracks[*track].speed = 0.0;
+        rdPuppet_AdvanceTrack(puppet, *track, RPG_GUARD_FRAME);
+    }
+    else
+        puppet->aTracks[*track].speed = RPG_HEAVY_APEX / (RPG_SABER_CHARGE - RPG_SABER_POSE);
+}
+
+static void jkRpg_SaberPose(SithThing* p, int pose, int on)
+{
+    for (int view = 0; view < 2; view++)
+        jkRpg_SaberPoseView(p, pose, view, on);
+}
+
+// Restore a held pose that a stock script stopped or took over; the wind-up resumes where the
+// charge has reached (frames along the raised swing), the guard on its held frame.
+static void jkRpg_KeepPose(SithThing* p, int pose, flex_t frames)
+{
+    for (int view = 0; view < 2; view++) {
+        rdPuppet* puppet = jkRpg_SaberPuppet(p, view);
+        int track = jkRpg_aSaberTrack[pose * 2 + view];
+        if (!puppet || jkRpg_PoseHeld(puppet, track, pose, view))
+            continue;
+        jkRpg_SaberPoseView(p, pose, view, 1);
+        track = jkRpg_aSaberTrack[pose * 2 + view];
+        if (!pose && track >= 0 && frames > 0)
+            rdPuppet_AdvanceTrack(puppet, track, frames < RPG_HEAVY_APEX ? frames : RPG_HEAVY_APEX);
+    }
+}
+
+// Hold the wind-up on its raised frame until the attack is released.
+static void jkRpg_HoldWindup(SithThing* p)
+{
+    for (int view = 0; view < 2; view++) {
+        rdPuppet* puppet = jkRpg_SaberPuppet(p, view);
+        int track = jkRpg_aSaberTrack[view];
+        if (jkRpg_PoseHeld(puppet, track, 0, view) && puppet->aTracks[track].field_124 >= RPG_HEAVY_APEX)
+            puppet->aTracks[track].status |= 0x10;
+    }
+}
+
+// The stock heavy swing starts its own copy of these animations (the saber script's keyframes
+// belong to the static world, ours to the level); continue them from the raised frame
+// instead, and shorten its recovery by the time skipped.
+static void jkRpg_ContinueHeavy(SithThing* p)
+{
+    flex_t skipped = 0.0;
+    for (int view = 0; view < 2; view++) {
+        rdPuppet* puppet = jkRpg_SaberPuppet(p, view);
+        rdKeyframe* key = puppet ? sithKeyFrame_LoadEntry(jkRpg_aHeavyKey[view]) : NULL;
+        for (int i = 0; key && i < 4; i++) {
+            rdPuppetTrack* t = &puppet->aTracks[i];
+            if (i == jkRpg_aSaberTrack[view] || !t->status || !t->keyframe || t->field_124 >= RPG_HEAVY_APEX
+                || t->keyframe->numFrames != key->numFrames || t->keyframe->numJoints != key->numJoints)
+                continue;
+            if (!view && key->fps > 0) skipped = (RPG_HEAVY_APEX - t->field_124) / key->fps;
+            rdPuppet_AdvanceTrack(puppet, i, RPG_HEAVY_APEX - t->field_124);
+        }
+    }
+    sithWeapon_fireWait -= skipped;
+    sithWeapon_secMountWait -= skipped;
+}
+
+static void jkRpg_SaberSound(SithThing* p, const char* pName, flex_t volume)
+{
+    sithSound* pSound = sithSound_Load((char*)pName, 0);
+    if (pSound)
+        sithSoundMixer_PlaySoundThing(pSound, p, volume, 0.5, 2.5, SITHSOUNDFLAG_FOLLOWSTHING);
+}
+
+// Until the player has both guarded and swung heavy, drawing the saber explains the controls once
+// per launch. The registry keeps what was learned (1 guard, 2 heavy swing).
+static void jkRpg_SaberLearned(int bit)
+{
+    static int learned = -1;
+    if (learned < 0)
+        learned = wuRegistry_GetInt("rpgSaberControls", 0);
+    if (bit && !(learned & bit))
+        wuRegistry_SaveInt("rpgSaberControls", learned |= bit);
+    static int hinted;
+    if (bit || hinted || (learned & 3) == 3)
+        return;
+    hinted = 1;
+    const char* attack = jkRpg_BindingName(INPUT_FUNC_FIRE1);
+    char attackName[64];
+    stdString_snprintf(attackName, sizeof(attackName), "%s", attack ? attack : "Fire");
+    const char* guard = jkRpg_BindingName(INPUT_FUNC_FIRE2);
+    char line[160];
+    stdString_snprintf(line, sizeof(line), "Saber: click %s to swing; hold, then release, for a heavy swing. Hold %s to block.",
+        attackName, guard ? guard : "Alt Fire");
+    sithConsole_PrintString(line);
+}
+
+// Lightsaber controls for the local JK single player, on every weapon control update.
+// Returns 1 while they own the selected saber's fire buttons.
+int jkRpg_SaberControls(SithThing* p)
+{
+    static SithWorld* pWorld;
+    static uint32_t lastMs;
+    jkRpgSaber* s = &jkRpg_saber;
+    flex_t now = sithTime_g_secGameTime;
+    uint32_t ms = stdPlatform_GetTimeMsec();
+    int manual = !Main_bMotsCompat && jkRpg_IsActive(p) && jkRpg_CurWeapon(p) == SITHBIN_LIGHTSABER
+        && !(p->flags & SITH_TF_DEAD) && !(p->weaponParams.flags & SITH_WF_EMITAITARGETEDEVENT);
+    // Loading, menus, cutscenes and other weapons interrupt the saber: a held button must be
+    // pressed again, so closing a menu never releases a swing.
+    int sameWorld = pWorld == sithWorld_g_pCurrentWorld && now >= jkRpg_saberUpdated;
+    if (!manual || !sameWorld || !jkRpg_SaberFresh() || ms - lastMs > 250) {
+        for (int pose = 0; pose < 2; pose++)
+            if (sameWorld) jkRpg_SaberPose(p, pose, 0);
+        for (int i = 0; i < 4; i++)
+            jkRpg_aSaberTrack[i] = -1; // a loaded world has new animation tracks
+        jkRpg_SaberReset(s);
+    }
+    pWorld = sithWorld_g_pCurrentWorld;
+    lastMs = ms;
+    jkRpg_saberUpdated = now;
+    if (!manual)
+        return 0;
+    jkRpg_SaberLearned(0);
+
+    int unused;
+    int attack = sithControl_GetKey(INPUT_FUNC_FIRE1, &unused);
+    int block = sithControl_GetKey(INPUT_FUNC_FIRE2, &unused) && sithWeapon_8BD024 == -1; // not while switching
+    int ready = now >= sithWeapon_secMountWait && sithWeapon_8BD024 == -1 && now >= sithWeapon_fireWait;
+    jkRpgMods m;
+    jkRpg_GetMods(p, SITHBIN_LIGHTSABER, &m);
+    int charging = s->charging, guard = s->guard;
+    int swing = jkRpg_SaberStep(s, attack, block, ready, now, RPG_SABER_RECOVERY * m.block);
+    sithCog* pCog = sithInventory_g_aTypes[SITHBIN_LIGHTSABER].cog;
+    if (swing && pCog) {
+        // The stock script's own press and release: one swing with its sounds and recovery.
+        // Levels start with an unset wait (-1), which the stock weapon update treats as ready on
+        // its next physics tick; let the press itself start the swing instead.
+        int mode = swing == RPG_SWING_HEAVY;
+        if (sithWeapon_fireWait < 0) sithWeapon_fireWait = 0;
+        sithCog_SendMessage(pCog, SITH_MESSAGE_ACTIVATE, SENDERTYPE_SYSTEM, mode, SENDERTYPE_THING, p->idx, 0);
+        sithCog_SendMessage(pCog, SITH_MESSAGE_DEACTIVATED, SENDERTYPE_SYSTEM, mode, SENDERTYPE_THING, p->idx, 0);
+        if (mode) {
+            jkRpg_ContinueHeavy(p);
+            jkRpg_SaberLearned(2);
+        }
+    }
+    if (s->charging != charging)
+        jkRpg_SaberPose(p, 0, s->charging);
+    else if (s->charging) {
+        jkRpg_KeepPose(p, 0, (now - s->pressed - RPG_SABER_POSE) * RPG_HEAVY_APEX / (RPG_SABER_CHARGE - RPG_SABER_POSE));
+        jkRpg_HoldWindup(p);
+    }
+    if (s->guard == guard && s->guard)
+        jkRpg_KeepPose(p, 1, 0);
+    if (s->guard != guard) {
+        jkRpg_SaberPose(p, 1, s->guard);
+        if (s->guard) {
+            jkRpg_SaberSound(p, "ltsaberswing03.wav", 0.4);
+            jkRpg_SaberLearned(1);
+        }
+    }
+    return 1;
+}
