+
+// Build a gold, shaded side view from the player's original weapon mesh, once per HUD session.
+// Only the pickup meshes (and the fist view model's hand mesh) are used; no game art is bundled.
+// Slot 11 is the bacta tank pickup in its own textured colours, for the bacta panel.
+#define RPG_ICON_W 192
+#define RPG_ICON_H 96
+#define RPG_ICON_BACTA 11
+static stdBitmap* jkRpg_weaponIcons[12];
+static char jkRpg_aWeaponIconFailed[12]; // retried after the HUD is rebuilt
+
+void jkRpg_FreeWeaponIcons(void)
+{
+    for (int i = 1; i <= RPG_ICON_BACTA; i++) {
+        if (jkRpg_weaponIcons[i]) stdBitmap_Free(jkRpg_weaponIcons[i]);
+        jkRpg_weaponIcons[i] = NULL;
+        jkRpg_aWeaponIconFailed[i] = 0;
+    }
+}
+
+static rdVector3 jkRpg_IconProject(rdVector3 v)
+{
+    rdVector3 p = {v.y + 0.18 * v.x, -v.z + 0.18 * v.x, v.x + 0.18 * v.z - 0.18 * v.y};
+    return p;
+}
+
+static stdBitmap* jkRpg_WeaponIcon(int weapon)
+{
+    if (weapon < 1 || weapon > RPG_ICON_BACTA) return NULL;
+    if (jkRpg_weaponIcons[weapon] || jkRpg_aWeaponIconFailed[weapon]) return jkRpg_weaponIcons[weapon];
+    jkRpg_aWeaponIconFailed[weapon] = 1; // until the icon below is built
+    static const char* models[] = {"", "fistv.3do", "bryp.3do", "strp.3do", "detp_1.3do",
+        "bowp.3do", "rptp.3do", "rldp.3do", "seqp_1.3do", "conp.3do", "sabp.3do", "bact.3do"};
+    rdModel3* model = sithModel_Load(models[weapon], 1);
+    if (!model || !model->numGeos || !model->aGeos[0].numMeshes) return NULL;
+    rdMesh* mesh = &model->aGeos[0].aMeshes[0];
+    if (mesh->numVertices < 3 || mesh->numVertices > 4096) return NULL;
+    // The fist has no official website picture: retain the game's own textured hand.
+    // The other model icons remain available if the shipped artwork cannot be read.
+    rdColor24* palette = sithWorld_g_pCurrentWorld && sithWorld_g_pCurrentWorld->colormaps
+        ? sithWorld_g_pCurrentWorld->colormaps[0].colors : NULL;
+    rdVector3* vertices = STD_ALLOC(sizeof(rdVector3) * mesh->numVertices);
+    if (!vertices) return NULL;
+    flex_t loX = 1e9, loY = 1e9, hiX = -1e9, hiY = -1e9;
+    for (int i = 0; i < mesh->numVertices; i++) {
+        vertices[i] = jkRpg_IconProject(mesh->aVertices[i]);
+        if (weapon == 5) vertices[i].x = -vertices[i].x; // the bowcaster model faces the other way: point every gun right
+        loX = fmin(loX, vertices[i].x); hiX = fmax(hiX, vertices[i].x);
+        loY = fmin(loY, vertices[i].y); hiY = fmax(hiY, vertices[i].y);
+    }
+    flex_t scale = fmin((RPG_ICON_W - 8) / fmax(hiX - loX, 0.0001),
+                       (RPG_ICON_H - 8) / fmax(hiY - loY, 0.0001));
+    for (int i = 0; i < mesh->numVertices; i++) {
+        vertices[i].x = (vertices[i].x - (loX + hiX) * 0.5) * scale + RPG_ICON_W * 0.5;
+        vertices[i].y = (vertices[i].y - (loY + hiY) * 0.5) * scale + RPG_ICON_H * 0.5;
+    }
+    tRasterInfo format = {0};
+    format.width = RPG_ICON_W; format.height = RPG_ICON_H;
+    format.format = (rdTexFormat){.bpp=16, .is16bit=1, .r_bits=5, .g_bits=5, .b_bits=5,
+        .r_shift=10, .g_shift=5, .b_shift=0, .r_bitdiff=3, .g_bitdiff=3, .b_bitdiff=3};
+    stdBitmap* bitmap = stdBitmap_New(1, 0, 0, 0, &format.format);
+    flex_t* depth = STD_ALLOC(sizeof(flex_t) * RPG_ICON_W * RPG_ICON_H);
+    if (!bitmap || !depth) {
+        if (bitmap) stdBitmap_Free(bitmap);
+        STD_FREE(depth); STD_FREE(vertices); return NULL;
+    }
+    bitmap->mipSurfaces[0] = stdDisplay_VBufferNew(&format, 0, 0, NULL);
+#ifdef SDL2_RENDER
+    bitmap->aTextureIds = STD_ALLOC(sizeof(uint32_t));
+    bitmap->abLoadedToGPU = STD_ALLOC(sizeof(int));
+    bitmap->paDataDepthConverted = STD_ALLOC(sizeof(void*));
+    if (bitmap->aTextureIds) bitmap->aTextureIds[0] = 0;
+    if (bitmap->abLoadedToGPU) bitmap->abLoadedToGPU[0] = 0;
+    if (bitmap->paDataDepthConverted) bitmap->paDataDepthConverted[0] = NULL;
+    if (!bitmap->aTextureIds || !bitmap->abLoadedToGPU || !bitmap->paDataDepthConverted) {
+        stdBitmap_Free(bitmap); STD_FREE(depth); STD_FREE(vertices); return NULL;
+    }
+#endif
+#ifdef STDBITMAP_PARTIAL_LOAD
+    bitmap->bLoaded = 1;
+#endif
+    tVBuffer* buffer = bitmap->mipSurfaces[0];
+    if (!buffer || !stdDisplay_VBufferLock(buffer)) {
+        stdBitmap_Free(bitmap); STD_FREE(depth); STD_FREE(vertices); return NULL;
+    }
+    memset(buffer->surface_lock_alloc, 0, buffer->format.rowSize * RPG_ICON_H);
+    for (int i = 0; i < RPG_ICON_W * RPG_ICON_H; i++) depth[i] = -1e9;
+    for (int f = 0; f < mesh->numFaces; f++) {
+        rdFace* face = &mesh->faces[f];
+        if (face->numVertices < 3) continue;
+        flex_t light = fmin(1.0, fmax(0.35, 0.65 + 0.25 * face->normal.z + 0.20 * face->normal.x));
+        uint16_t color = 0x8000 | ((int)(31 * light) << 10) | ((int)(24 * light) << 5) | (int)(7 * light);
+        tVBuffer* texture = NULL;
+        rdMaterial* material = face->material;
+        if ((weapon == 1 || weapon == RPG_ICON_BACTA) && material && mesh->aTexVerticies && face->vertexUVIdx
+            && rdMaterial_EnsureData(material) && material->num_texinfo && material->texinfos[0]
+            && material->texinfos[0]->texture_ptr) {
+            texture = material->texinfos[0]->texture_ptr->texture_struct[0];
+            if (texture && (!palette || texture->format.format.bpp != 8
+                || texture->format.width <= 0 || texture->format.height <= 0 || !stdDisplay_VBufferLock(texture)))
+                texture = NULL;
+        }
+        for (uint32_t t = 1; t + 1 < face->numVertices; t++) {
+            int ia = face->vertexPosIdx[0], ib = face->vertexPosIdx[t], ic = face->vertexPosIdx[t+1];
+            if (ia < 0 || ib < 0 || ic < 0 || ia >= mesh->numVertices || ib >= mesh->numVertices || ic >= mesh->numVertices) continue;
+            int ta = texture ? face->vertexUVIdx[0] : -1, tb = texture ? face->vertexUVIdx[t] : -1,
+                tc = texture ? face->vertexUVIdx[t+1] : -1;
+            int textured = texture && ta >= 0 && tb >= 0 && tc >= 0
+                && ta < mesh->numUVs && tb < mesh->numUVs && tc < mesh->numUVs;
+            rdVector3 a = vertices[ia], b = vertices[ib], c = vertices[ic];
+            flex_t area = (b.y-c.y)*(a.x-c.x) + (c.x-b.x)*(a.y-c.y);
+            if (fabs(area) < 0.0001) continue;
+            int x0 = fmax(0, floor(fmin(a.x, fmin(b.x,c.x))));
+            int x1 = fmin(RPG_ICON_W-1, ceil(fmax(a.x, fmax(b.x,c.x))));
+            int y0 = fmax(0, floor(fmin(a.y, fmin(b.y,c.y))));
+            int y1 = fmin(RPG_ICON_H-1, ceil(fmax(a.y, fmax(b.y,c.y))));
+            for (int y = y0; y <= y1; y++) for (int x = x0; x <= x1; x++) {
+                flex_t u = ((b.y-c.y)*(x+0.5-c.x)+(c.x-b.x)*(y+0.5-c.y))/area;
+                flex_t v = ((c.y-a.y)*(x+0.5-c.x)+(a.x-c.x)*(y+0.5-c.y))/area;
+                if (u < 0 || v < 0 || u+v > 1) continue;
+                flex_t z = u*a.z + v*b.z + (1-u-v)*c.z;
+                int index = y*RPG_ICON_W+x;
+                if (z <= depth[index]) continue;
+                depth[index] = z;
+                uint16_t* row = (uint16_t*)((uint8_t*)buffer->surface_lock_alloc + y*buffer->format.rowSize);
+                uint16_t pixel = color;
+                if (textured) {
+                    rdVector2 a = mesh->aTexVerticies[ta], b = mesh->aTexVerticies[tb], c = mesh->aTexVerticies[tc];
+                    int tx = (int)floor(u*a.x + v*b.x + (1-u-v)*c.x + face->texVertOffset.x);
+                    int ty = (int)floor(u*a.y + v*b.y + (1-u-v)*c.y + face->texVertOffset.y);
+                    tx = (tx % texture->format.width + texture->format.width) % texture->format.width;
+                    ty = (ty % texture->format.height + texture->format.height) % texture->format.height;
+                    uint8_t index = ((uint8_t*)texture->surface_lock_alloc)[ty*texture->format.rowSize+tx];
+                    rdColor24 rgb = (material->palette_alloc ? material->palette_alloc : palette)[index];
+                    pixel = 0x8000 | ((int)(rgb.r * light / 8) << 10) | ((int)(rgb.g * light / 8) << 5) | (int)(rgb.b * light / 8);
+                }
+                row[x] = pixel;
+            }
+        }
+        if (texture) stdDisplay_VBufferUnlock(texture);
+    }
+    stdDisplay_VBufferUnlock(buffer);
+    STD_FREE(depth); STD_FREE(vertices);
+    jkRpg_weaponIcons[weapon] = bitmap;
+    jkRpg_aWeaponIconFailed[weapon] = !bitmap;
+    return bitmap;
+}
+
+// The textured bacta tank pickup, centred in a 192x96 side view (NULL if unavailable).
+stdBitmap* jkRpg_BactaModelIcon(void)
+{
+    return jkRpg_WeaponIcon(RPG_ICON_BACTA);
+}
+
+void jkRpg_DrawWeaponIcon(int weapon, int x, int y, int width, int height)
+{
+    if (jkRpg_DrawShippedWeaponIcon(weapon, x, y, width, height)) return;
+    stdBitmap* bitmap = jkRpg_WeaponIcon(weapon);
+    if (!bitmap) return;
+    flex_t scale = fmin((flex_t)width / RPG_ICON_W, (flex_t)height / RPG_ICON_H);
+    std3D_DrawUIBitmap(bitmap, 0, x + (width-RPG_ICON_W*scale)*0.5,
+        y + (height-RPG_ICON_H*scale)*0.5, NULL, scale, 1);
+}
+
+
+static int jkRpg_weaponSwitcher = -1;
+
+int jkRpg_GetWeaponSwitcher(void)
+{
+    if (jkRpg_weaponSwitcher < 0)
+        jkRpg_weaponSwitcher = wuRegistry_GetInt("rpgWeaponSwitcher", 1) != 0;
+    return jkRpg_weaponSwitcher;
+}
+
+void jkRpg_SetWeaponSwitcher(int enabled)
+{
+    jkRpg_weaponSwitcher = enabled != 0;
+    wuRegistry_SaveInt("rpgWeaponSwitcher", jkRpg_weaponSwitcher);
+}
+
+// A short, non-interactive reminder; weapon selection still uses the normal controls.
+static void jkRpg_DrawWeapons(SithThing* p, stdFont* font)
+{
+    static int previous = -1;
+    static uint32_t changedAt;
+    int weapon = sithInventory_GetCurrentWeapon(p);
+    uint32_t now = sithTime_g_msecGameTime;
+    if (weapon != previous) {
+        previous = weapon;
+        changedAt = now;
+    }
+    if (!jkRpg_GetWeaponSwitcher() || (uint32_t)(now - changedAt) >= 2200 || weapon < 1 || weapon > 10)
+        return;
+
+    int owned[10], count = 0;
+    for (int bin = 1; bin <= 10; bin++) {
+        if (sithInventory_IsInventoryAvailable(p, bin) && sithInventory_GetInventory(p, bin) > 0)
+            owned[count++] = bin;
+    }
+    if (!count) return;
+    flex_t scale = (flex_t)Video_format.height / 480.0 * 0.8; // 80% of the original strip size
+    flex_t fit = (flex_t)Video_format.width * 0.8 / (count * 54);
+    if (scale > fit) scale = fit;
+    int cell = (int)(54 * scale), size = (int)(28 * scale);
+    int fontH = (int)(stdFont_GetHeight(font) * scale);
+    int height = size + 2 * fontH + (int)(14 * scale);
+    int x = (Video_format.width - count * cell) / 2, y = (int)(58 * scale);
+    static const char* names[] = {"", "Fists", "Bryar pistol", "Stormtrooper rifle",
+        "Thermal detonators", "Bowcaster", "Repeater", "Rail detonator",
+        "Sequencer charges", "Concussion rifle", "Lightsaber"};
+    for (int i = 0; i < count; i++) {
+        int bin = owned[i], cx = x + i * cell;
+        jkRpg_Rect(cx, y, cell - 2, height, 12, 10, 5, 190);
+        if (bin == weapon) {
+            jkRpg_Rect(cx, y, cell - 2, 2, 240, 180, 40, 255);
+            jkRpg_Rect(cx, y + height - 2, cell - 2, 2, 240, 180, 40, 255);
+        }
+        jkRpg_DrawWeaponIcon(bin, cx + (int)(4 * scale), y + (int)(4 * scale),
+            cell - (int)(8 * scale), size);
+        const char* key = jkRpg_BindingName(bin == SITHBIN_LIGHTSABER
+            ? INPUT_FUNC_SELECT1 : INPUT_FUNC_SELECT1 + bin - 1);
+        if (!key && bin == SITHBIN_LIGHTSABER) key = jkRpg_BindingName(INPUT_FUNC_SELECT0);
+        if (!key) key = "-";
+        flex_t keyScale = scale;
+        int width = jkRpg_TextWidth(font, keyScale, key);
+        if (width > cell - 4) keyScale *= (flex_t)(cell - 4) / width;
+        width = jkRpg_TextWidth(font, keyScale, key);
+        jkRpg_Text(font, cx + (cell - width) / 2, y + size + (int)(6 * scale), keyScale, key);
+        char ammo[32];
+        int ammoBin = jkRpg_aAmmoBin[bin];
+        if (bin == 1 || bin == 10) stdString_snprintf(ammo, sizeof(ammo), "Melee");
+        else if (bin == 2) stdString_snprintf(ammo, sizeof(ammo), "Unlimited");
+        else stdString_snprintf(ammo, sizeof(ammo), "%d", (int)sithInventory_GetInventory(p, ammoBin));
+        flex_t ammoScale = scale * 0.85;
+        width = jkRpg_TextWidth(font, ammoScale, ammo);
+        if (width > cell - 4) ammoScale *= (flex_t)(cell - 4) / width;
+        width = jkRpg_TextWidth(font, ammoScale, ammo);
+        jkRpg_Text(font, cx + (cell-width)/2, y + size + fontH + (int)(8*scale), ammoScale, ammo);
+
+    }
+    int width = jkRpg_TextWidth(font, scale, names[weapon]);
+    jkRpg_Text(font, (Video_format.width - width) / 2, y + height + (int)(4 * scale), scale, names[weapon]);
+}
+
+void jkRpg_DrawHud(stdFont* pFont, int leftX, int leftY, int leftW, int rightX)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!jkRpg_IsActive(p) || !pFont)
+        return;
+
+    if (Main_bNoHUD) {
+        if (jkRpg_bMenuOpen) jkRpg_DrawMenu(p, pFont);
+        return;
+    }
+
+    // The XP bar is the outer ring of the left HUD gauge (drawn in jkHud.c); the level and any
+    // waiting points sit on a plate attached to that gauge (jkRpgMenu.c).
+    jkRpg_DrawLevelBadge(p, pFont, leftX, leftY);
+    jkRpg_DrawBactaHud(p, pFont, leftX, leftW);
+    jkRpg_DrawForceHud(p, rightX);
+
+    if (jkRpg_bMenuOpen)
+        jkRpg_DrawMenu(p, pFont);
+    else {
+        jkRpg_DrawSupplyFinder(p);
+        jkRpg_DrawWeapons(p, pFont);
+    }
+}
