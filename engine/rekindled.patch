+static void jkRpg_RepairPedCount(SithThing* player)
+{
+    if (!jkRpg_Get(player, RPG_BIN_PEDFIX)) {
+        // Old saves never registered these civilians. Repair the actors still present,
+        // including corpses; removed actors cannot be reconstructed from a save.
+        if (jkRpg_bRestorePedCount) {
+            SithWorld* world = sithWorld_g_pCurrentWorld;
+            int missing = 0;
+            for (int i = 0; i <= world->numThings; i++) {
+                SithThing* actor = &world->aThings[i];
+                if ((actor->type != SITH_THING_ACTOR && actor->type != SITH_THING_CORPSE)
+                    || !actor->pCog || !actor->pCog->pScript) continue;
+                const char* script = actor->pCog->pScript->aName;
+                if (!__strcmpi(script, "actor_fn.cog") || !__strcmpi(script, "actor_gd.cog")) missing++;
+            }
+            sithInventory_ChangeInventory(player, SITHBIN_PEDS_TOTAL, missing);
+        }
+        sithInventory_SetInventory(player, RPG_BIN_PEDFIX, 1);
+    }
+    jkRpg_bRestorePedCount = 0;
+}
+
+// Only ordinary pedestrians/workers seed crowds. Story characters and droids keep their roles.
+static int jkRpg_CivilianKind(SithThing* p)
+{
+    if (!p || p->type != SITH_THING_ACTOR || !p->pCog || !p->pCog->pScript)
+        return 0;
+    const char* script = p->pCog->pScript->aName;
+    if (!__strcmpi(script, "actor_ug.cog")) return 2;
+    if (!__strcmpi(script, "actor_bt.cog")) return 3;
+    const char* scripts[] = {"actor_mn.cog", "actor_fn.cog", "actor_pm.cog", "actor_pf.cog", "actor_mu.cog", "actor_gd.cog"};
+    for (int i = 0; i < 6; i++)
+        if (!__strcmpi(script, scripts[i])) return 1;
+    return 0;
+}
