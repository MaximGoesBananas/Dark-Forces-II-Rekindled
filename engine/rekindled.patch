+// RPG clothing variety: repeated copies of the common enemies and civilians wear slightly
+// different colours. Only clothing materials change; faces, skin, hair, gear and weapons keep
+// their art. Recoloured textures are made at load time from the player's own game files.
+// A thing's look follows its saved GUID, so it survives save/load and level restarts.
+
+// ---- Outfit rules: pure data and colour maths, compiled by tools/test_outfits.py. ----
+
+#define RPG_OUTFIT_MAX_LOOKS 5      // the original plus up to four recoloured looks
+
+typedef struct {
+    uint8_t r, g, b;                // colour the clothing moves towards, at the texel's own brightness
+    uint8_t strength;               // percent of the way from the original colour to that tint
+    uint8_t brightness;             // percent of the original brightness
+} jkRpgTint;
+
+typedef struct {
+    const char* name;
+    const char* models;             // space-separated model files
+    const char* clothes;            // space-separated materials that are only clothing
+    const char* scripts;            // required class scripts, or NULL for any
+    int numTints;
+    jkRpgTint tints[RPG_OUTFIT_MAX_LOOKS - 1];
+} jkRpgOutfit;
+
+// Enemy looks stay within each type's own colours: ordinary Gran keep a warm leather
+// tunic, bounty hunters stay dark, Tuskens keep their sand or dark wraps. Stormtroopers,
+// officers and other Imperial types are deliberately absent.
+static const jkRpgOutfit jkRpg_aOutfits[] = {
