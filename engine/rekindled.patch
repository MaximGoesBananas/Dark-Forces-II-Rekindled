+static int jkRpg_KillXp(const SithThing* victim)
+{
+    const char* map = sithWorld_g_pCurrentWorld ? sithWorld_g_pCurrentWorld->map_jkl_fname : "";
+    // The timed escape rewards getting out, not stopping to hunt. Both routes, including saved/spawned enemies.
+    // Its baseline XP is preserved in later campaign rewards.
+    if (!__strcmpi(map, "16aescapeship.jkl") || !__strcmpi(map, "16bescapeship.jkl"))
+        return 0;
+    int boss = jkRpg_BossXp(victim);
+    if (boss) return boss;
+    // Jerec's duel ends the game, so he gives nothing.
+    if ((!__strcmpi(map, "21ajerec.jkl") || !__strcmpi(map, "21bjerec.jkl"))
+        && victim->pTemplate && !__strcmpi(victim->pTemplate->aName, "jerec"))
+        return 0;
+    if (jkRpg_IsScript(victim->pCog, "actor_mailoc.cog")) return 5;
+    int gain = (int)(victim->actorParams.maxHealth / 5.0);
+    if (!__strcmpi(map, RPG_MISSION6_MAP) && victim->pTemplate && !__strcmpi(victim->pTemplate->aName, "iatst"))
+        gain = jkRpg_WalkerXp(gain, victim->guid);
+    // Both bowcaster Tusken variants share this death script; rifle variants do not.
+    if (victim->pCog && victim->pCog->pScript
+        && !__strcmpi(victim->pCog->pScript->aName, "actor_tk.cog") && gain < 15)
+        gain = 15;
+    // The first two missions pay 60%, including scripted reinforcements, before the minimum.
+    if (!__strcmpi(map, "01narshadda.jkl") || !__strcmpi(map, "02narshadda.jkl"))
+        gain = gain * 60 / 100;
+    gain = gain < 5 ? 5 : gain;
+    // Spread the duel's removed 306 XP over the 153 placed troopers of missions 17-19.
+    // The same reward applies to any scripted troopers there, including enemies in older saves.
+    if ((!__strcmpi(map, "18ascend.jkl") || !__strcmpi(map, "19a.jkl") || !__strcmpi(map, "19b.jkl"))
+        && victim->pTemplate) {
+        const char* name = victim->pTemplate->aName;
+        if (!__strcmpi(name, "stormtroop") || !__strcmpi(name, "stormtroop2")
+            || !__strcmpi(name, "stormtroop3") || !__strcmpi(name, "stormtroop4"))
+            gain += 2;
+    }
+    return gain;
+}
+
+// Things the player set off, such as an exploding tank and the blast it creates, keyed by thing
+// index and checked by signature. Their kills are the player's.
+#define RPG_CAUSE_TAGS 8192
+static uint32_t jkRpg_aCauseSig[RPG_CAUSE_TAGS];
+
+static int jkRpg_SetOffByPlayer(SithThing* pThing)
+{
+    return pThing && pThing->idx >= 0 && pThing->idx < RPG_CAUSE_TAGS && pThing->signature
+        && jkRpg_aCauseSig[pThing->idx] == pThing->signature;
+}
+
+static int jkRpg_CausedByPlayer(SithThing* pThing)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!pThing || !p)
+        return 0;
+    SithThing* pRoot = sithThing_GetThingParent(pThing);
+    return pRoot == p || jkRpg_SetOffByPlayer(pThing) || jkRpg_SetOffByPlayer(pRoot);
+}
+
+// A destructible (not a character or projectile) damaged by the player or something the player set off.
+void jkRpg_OnThingDamaged(SithThing* pThing, SithThing* pDamager, int damageType)
+{
+    if (!pThing || pThing->type == SITH_THING_ACTOR || pThing->type == SITH_THING_PLAYER
+        || (pThing->type == SITH_THING_WEAPON && pThing->pParent) // a placed mine has no owner
+        || pThing->idx < 0 || pThing->idx >= RPG_CAUSE_TAGS || damageType == SITH_DAMAGE_IMPACT
+        || !jkRpg_IsActive(sithPlayer_g_pLocalPlayerThing) || !jkRpg_CausedByPlayer(pDamager))
+        return;
+    jkRpg_aCauseSig[pThing->idx] = pThing->signature;
+}
+
+// A script created a thing, such as a tank's explosion, at a thing the player set off.
+void jkRpg_OnThingCreated(SithThing* pThing, SithThing* pMarker)
+{
+    if (pThing && pThing->idx >= 0 && pThing->idx < RPG_CAUSE_TAGS && jkRpg_SetOffByPlayer(pMarker))
+        jkRpg_aCauseSig[pThing->idx] = pThing->signature;
+}
+
+void jkRpg_OnKill(SithThing* pVictim, SithThing* pKiller, flex_t pedsBefore)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!jkRpg_IsActive(p) || pVictim == p || pVictim->type != SITH_THING_ACTOR || !pKiller)
+        return;
+    if (!jkRpg_CausedByPlayer(pKiller))
+        return;
+    // The game's own scripts count civilians the player kills; those give no XP.
+    if (sithInventory_GetInventory(p, SITHBIN_PEDS_KILLED) > pedsBefore)
+        return;
+
+    int gain = jkRpg_KillXp(pVictim);
+    if (gain > 0) {
+        jkRpg_AddXp(p, gain);
+    }
+}
