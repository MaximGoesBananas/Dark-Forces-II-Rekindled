+// Damage to the player before the shield script absorbs it, so reductions protect shields too.
+flex_t jkRpg_DamageBeforeShields(SithThing* pVictim, SithThing* pDamager, flex_t damage, int damageType)
+{
+    if (!jkRpg_IsActive(pVictim) || damage <= 0)
+        return damage;
+    if (damageType == SITH_DAMAGE_DROWN && jkRpg_Rank(pVictim, UP_ENDURANCE) >= 2)
+        damage *= 0.5;
+    damage = jkRpg_WeaponProtection(pVictim, pDamager, damage, damageType);
+    return jkRpg_SkillProtection(pVictim, pDamager, damage, damageType);
+}
