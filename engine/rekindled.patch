+// Apply every upgrade's stat change. Safe to repeat: values are recomputed from the originals.
+static void jkRpg_ApplyStats(SithThing* p)
+{
+    SithThing* t = p->pTemplate;
+    if (t) {
+        int athletics = jkRpg_Rank(p, UP_ATHLETICS);
+        p->actorParams.maxHealth = t->actorParams.maxHealth + jkRpg_MaxHealthBonus(jkRpg_Rank(p, UP_HEALTH));
+        p->actorParams.maxThrust = t->actorParams.maxThrust * (athletics >= 1 ? 1.0 : RPG_BASE_SPEED);
+        p->actorParams.jumpSpeed = t->actorParams.jumpSpeed;
+    }
+    // Modern mouse look: up and down reach almost straight up and down (the original stops at 80).
+    // 89, not 90: looking exactly vertical makes the view direction undefined.
+    p->actorParams.minHeadPitch = -89.0;
+    p->actorParams.maxHeadPitch = 89.0;
+
+    for (size_t i = 0; i < sizeof(jkRpg_aCapacityBins) / sizeof(jkRpg_aCapacityBins[0]); i++) {
+        int bin = jkRpg_aCapacityBins[i];
+        if (jkRpg_aBaseMax[bin] > 0) {
+            sithInventory_g_aTypes[bin].max = jkRpg_aBaseMax[bin];
+            // Saved inventory can bypass SetInventory; bring old saves under the same ceiling.
+            if (sithInventory_GetInventory(p, bin) > jkRpg_aBaseMax[bin])
+                sithInventory_SetInventory(p, bin, jkRpg_aBaseMax[bin]);
+        }
+    }
+    if (jkRpg_aBaseMax[SITHBIN_SHIELDS] > 0)
+        sithInventory_g_aTypes[SITHBIN_SHIELDS].max = jkRpg_aBaseMax[SITHBIN_SHIELDS];
+    if (jkRpg_aBaseMax[SITHBIN_FORCEMANA] > 0)
+        sithInventory_g_aTypes[SITHBIN_FORCEMANA].max = jkRpg_aBaseMax[SITHBIN_FORCEMANA]
+            * jkRpg_ForceCapacityScale(jkRpg_Rank(p, UP_FORCE));
+
+    jkPlayerInfo* pInfo = p->playerInfo;
+    if (pInfo && jkRpg_saberBaseLen > 0) {
+        pInfo->length = jkRpg_saberBaseLen;
+        pInfo->polyline.baseRadius = jkRpg_saberBaseRad;
+        pInfo->polyline.tipRadius = jkRpg_saberTipRad;
+    }
+}
