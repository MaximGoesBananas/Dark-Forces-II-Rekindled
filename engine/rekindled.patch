+    sithCamera_SetPOVShake(&pos, &angle, 0.05, 40.0);
+}
+
+// Quick draw: keep switching animations, their timers and input lockouts on the same, faster clock.
+flex_t jkRpg_WeaponSwitchScale(sithCog* cog)
+{
+    if (!cog || !jkRpg_IsActive(sithPlayer_g_pLocalPlayerThing)
+        || jkRpg_Rank(sithPlayer_g_pLocalPlayerThing, UP_ATHLETICS) < 2
+        || (cog->trigId != SITH_MESSAGE_SELECTED && cog->trigId != SITH_MESSAGE_DESELECTED))
+        return 1.0;
+    for (int bin = SITHBIN_FISTS; bin <= SITHBIN_LIGHTSABER; ++bin)
+        if (sithInventory_g_aTypes[bin].cog == cog) return 0.5;
+    return 1.0;
+}
+
+// Script timers: selection/holstering stay synchronized with Quick draw.
+flex_t jkRpg_ScriptTimer(sithCog* pCog, int id, flex_t delay)
+{
+    flex_t switching = jkRpg_WeaponSwitchScale(pCog);
+    return switching != 1.0 && delay >= 0.0 ? delay * switching : delay;
+}
+
+// Ammo a weapon script takes: the Bryar's are free, the concussion rifle's cheaper and every fourth
+// repeater round free. Only spending from the held weapon's own ammo is changed.
+flex_t jkRpg_AmmoCost(SithThing* pThing, int bin, flex_t amount)
+{
+    if (amount >= 0 || !jkRpg_IsActive(pThing))
+        return amount;
+    int weapon = jkRpg_CurWeapon(pThing);
+    if (weapon < 1 || weapon > 10 || jkRpg_aAmmoBin[weapon] != bin)
+        return amount;
+    if (weapon == 2)
+        return 0.0; // the Bryar pistol never uses the rifle's energy cells
+    jkRpgMods m;
+    jkRpg_GetMods(pThing, weapon, &m);
+    if (m.freeEvery)
+        amount += jkRpg_FreeShots(&jkRpg_repeaterShots, (int)(-amount + 0.5), m.freeEvery);
+    return amount * m.ammo;
+}
+
+flex_t jkRpg_ScriptAmmo(sithCog* pCog, SithThing* pThing, int bin, flex_t amount)
+{
+    if (!pCog || !jkRpg_IsActive(pThing))
+        return amount;
+    if (bin == SITHBIN_ENERGY && pCog == sithInventory_g_aTypes[SITHBIN_BRYARPISTOL].cog && amount < 1.0)
+        return 1.0;
+    // The concussion script wants 8 cells for either mode. With the cheaper chamber, show it the
+    // cells as a share of the actual cost: firing checks the firing mode's cost. Choosing the rifle,
+    // or keeping it when primary runs dry, checks the cheaper alternate mode, so alternate fire
+    // stays usable; automatic switching from another weapon still needs a primary shot.
+    // Before that upgrade the original rule stays.
+    jkRpgMods m;
+    jkRpg_GetMods(pThing, RPG_CONCUSSION, &m);
+    if (bin == SITHBIN_POWER && pCog == sithInventory_g_aTypes[RPG_CONCUSSION].cog && m.ammo != 1.0) {
+        int mode = 0;
+        if (pCog->trigId == SITH_MESSAGE_FIRE)
+            mode = (int)pCog->senderRef == 1;
+        else if (pCog->trigId == SITH_MESSAGE_AUTOSELECT)
+            mode = (int)pCog->senderRef == -1 || jkRpg_CurWeapon(pThing) == RPG_CONCUSSION;
+        return amount * 8.0 / jkRpg_ConcussionCost(mode, m.ammo);
+    }
+    return amount;
+}
