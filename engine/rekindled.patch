+static void jkRpg_PopulateCivilians(SithThing* player)
+{
+    if (jkRpg_Get(player, RPG_BIN_CROWDS)) return;
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    int fuelStation = !__strcmpi(world->map_jkl_fname, "09fuelstation.jkl");
+    int copies = fuelStation ? 1 : 2;
+    sithInventory_SetInventory(player, RPG_BIN_CROWDS, fuelStation ? 2 : 1);
+    jkRpg_crowdTrimStarted = 0;
+    // Snapshot the original actors: newly created civilians must never seed more civilians.
+    int seeds[SITHAI_MAX_ACTORS], numSeeds = 0, actors = 0, freeThings = 0;
+    for (int i = 0; i < world->numThingsLoaded; i++) {
+        SithThing* thing = &world->aThings[i];
+        if (!thing->type) freeThings++;
+        if (thing->actor) actors++;
+        if (numSeeds < SITHAI_MAX_ACTORS && jkRpg_CivilianKind(thing) && thing->sector
+            && !(thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))) seeds[numSeeds++] = i;
+    }
+    int unsupported = 0;
+    for (int n = 0; n < numSeeds; n++)
+        unsupported += !jkRpg_StandsSupported(&world->aThings[seeds[n]]);
+    const char* names[] = {"nman1", "nman2", "nwoman1", "nwoman2", "man1", "man2", "woman1", "woman2", "ug", "u2"};
+    SithThing* variants[10];
+    int numVariants = 0;
+    for (int i = 0; i < 10; i++) {
+        SithThing* tpl = sithTemplate_GetTemplate(names[i]);
+        if (!tpl || !jkRpg_CivilianKind(tpl)) continue;
+        int duplicate = 0;
+        for (int j = 0; j < numVariants; j++)
+            if (variants[j]->renderData.model3 == tpl->renderData.model3) duplicate = 1;
+        if (!duplicate) variants[numVariants++] = tpl;
+    }
+    int added = 0, requested = numSeeds * copies;
+    int nextAttempt[SITHAI_MAX_ACTORS] = {0}, madeBySeed[SITHAI_MAX_ACTORS] = {0};
+    for (int n = 0; n < numSeeds; n++)
+        if (jkRpg_CivilianKind(&world->aThings[seeds[n]]) == 3) requested += 6;
+    // If a ledge or booth is too small, use spare room around other civilians in this mission.
+    // Bounded local search; distant groups need authored positions.
+    for (int pass = 0; pass < 4 && added < requested; pass++) {
+        for (int n = 0; n < numSeeds && added < requested; n++) {
+            SithThing* seed = &world->aThings[seeds[n]];
+            int kind = jkRpg_CivilianKind(seed);
+            int wanted = pass == 0 && kind == 3 ? 8 : copies;
+            SithThing barAnchor;
+            if (kind == 3 && !__strcmpi(world->map_jkl_fname, "01narshadda.jkl")) {
+                // Patron floor in front of the bar, not the bartender's space behind the counter.
+                barAnchor = *seed;
+                barAnchor.position.x += 0.45;
+                barAnchor.position.y -= 0.50;
+                barAnchor.sector = sithSector_FindSectorAtPos(world, &barAnchor.position);
+                if (!barAnchor.sector) continue;
+                seed = &barAnchor;
+            }
+            int made = 0;
+            // Bounded one-time search. Keep 32 actor/object slots free for scripted reinforcements.
+            for (int attempt = nextAttempt[n]; attempt < (pass == 0 ? 320 : 640) && made < wanted && added < requested; attempt++) {
+                nextAttempt[n] = attempt + 1;
+                if (actors >= SITHAI_MAX_ACTORS - 32 || freeThings <= 32 || !numVariants) break;
+                SithThing* tpl = NULL;
+                for (int v = 0; v < numVariants; v++) {
+                    SithThing* candidate = variants[(n + madeBySeed[n] + 1 + v) % numVariants];
+                    if ((jkRpg_CivilianKind(candidate) == 2) == (kind == 2)) { tpl = candidate; break; }
+                }
+                if (!tpl) break;
+                flex_t angle = (attempt % 16) * (2.0 * M_PI / 16.0) + n * 0.7;
+                flex_t distance = 0.28 + (attempt / 16) * 0.085;
+                rdVector3 pos = seed->position;
+                pos.x += cos(angle) * distance;
+                pos.y += sin(angle) * distance;
+                SithSector* sector = jkRpg_CrowdPosition(seed, tpl, &pos, 0.14);
+                if (!sector) continue;
+                rdVector3 rotation = {0, (n * 71 + madeBySeed[n] * 137) % 360, 0};
+                rdMatrix34 orient;
+                rdMatrix_BuildRotate34(&orient, &rotation);
+                SithThing* citizen = sithThing_CreateThingAtPos(tpl, &pos, &orient, sector, NULL);
+                if (!citizen) break;
+                made++; madeBySeed[n]++; added++; actors++; freeThings--;
+            }
+        }
+    }
+    stdPlatform_Printf("RPG crowds: %s originals=%d unsupported=%d requested=%d added=%d\n", world->map_jkl_fname,
+        numSeeds, unsupported, requested, added);
+}
+
+// Authored opening-bar positions override generic crowd scatter. Move existing actors so
+// their scripts, health and civilian accounting survive, including in older saves.
+static void jkRpg_MoveActor(SithThing* thing, rdVector3 pos, SithSector* sector)
+{
+    sithThing_DetachThing(thing);
+    thing->position = pos;
+    rdVector_Zero3(&thing->physicsParams.vel);
+    sithThing_SetSector(thing, sector, 1);
+    sithPhysics_FindFloor(thing, 1);
+    stdPlatform_Printf("RPG crowd move: %d %.4f %.4f %.4f\n", thing->idx, pos.x, pos.y, pos.z);
+}
+
+static int jkRpg_PlaceBarActor(SithThing* thing, rdVector3 pos, flex_t yaw)
+{
+    SithThing anchor = *thing;
+    anchor.position = pos;
+    anchor.sector = sithSector_FindSectorAtPos(sithWorld_g_pCurrentWorld, &pos);
+    if (!anchor.sector) return 0;
+    SithSector* sector = jkRpg_CrowdPosition(&anchor, thing, &pos, 0.0);
+    if (!sector) return 0;
+    rdVector3 rotation = {0, yaw, 0};
+    rdMatrix_BuildRotate34(&thing->orient, &rotation);
+    jkRpg_MoveActor(thing, pos, sector);
+    return 1;
+}
+
+static void jkRpg_FixOpeningBar(SithThing* player)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (__strcmpi(world->map_jkl_fname, "01narshadda.jkl") || jkRpg_Get(player, RPG_BIN_CROWDS) != 1)
+        return;
+    // Retry occupied destinations at most once a second, without redoing completed moves.
+    static uint32_t lastAttempt;
+    uint32_t now = stdPlatform_GetTimeMsec();
+    if (lastAttempt && (uint32_t)(now - lastAttempt) < 1000) return;
+    lastAttempt = now;
+    static const rdVector3 booths[] = {
+        {-10.83, -5.18, -1.10}, {-10.67, -5.18, -1.10},
+        {-10.03, -5.18, -1.10}, { -9.87, -5.18, -1.10}
+    };
+    int complete = 1;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* thing = &world->aThings[i];
+        if (thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED)) continue;
+        rdVector3 pos = thing->position;
+        if (jkRpg_CivilianKind(thing) != 1 || pos.x <= -9.30 || pos.x >= -8.20
+            || pos.y <= -6.10 || pos.y >= -4.80 || pos.z < -1.40 || pos.z > -0.85
+            || (pos.y <= -5.10 && pos.y >= -5.85)) continue;
+        int moved = 0;
+        for (int spot = 0; spot < 4 && !moved; spot++)
+            moved = jkRpg_PlaceBarActor(thing, booths[spot], spot % 2 ? 150 : 210);
+        if (!moved) complete = 0;
+    }
+    if (world->numThingsLoaded > 208) {
+        SithThing* enemy = &world->aThings[208];
+        rdVector3 pos = enemy->position;
+        if (enemy->type == SITH_THING_ACTOR && enemy->guid == 208 && enemy->pTemplate == sithTemplate_GetTemplate("reeyeesbhfist")
+            && !(enemy->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))
+            && pos.x > -9.30 && pos.x < -8.20 && pos.y > -6.0 && pos.y < -5.10 && pos.z < -0.85) {
+            rdVector3 outside = {-8.0, -5.20, -1.10};
+            if (!jkRpg_PlaceBarActor(enemy, outside, 180)) complete = 0;
+        }
+    }
+    if (complete) sithInventory_SetInventory(player, RPG_BIN_CROWDS, 2);
+}
+
+static int jkRpg_IsCrowdMap(const char* map)
+{
+    const char* maps[] = {"01narshadda.jkl", "02narshadda.jkl", "06abarons.jkl",
+                         "09fuelstation.jkl", "16aescapeship.jkl", "16bescapeship.jkl"};
+    int campaign = 0;
+    for (int n = 0; n < 6; n++)
+        if (!__strcmpi(map, maps[n])) campaign = 1;
+    return campaign;
+}
+
+// Saves from before the whole-body floor test can hold added people standing on thin ledges or half
+// over a drop. Once per mission, move ordinary people and workers failing the test to the nearest
+// supported spot reachable from where they stand (the crowd search and spacing rules), keeping
+// identity, scripts and facing. Anyone without such a spot stays. Bartenders, story characters
+// and everyone the level's designers placed are never moved.
+static void jkRpg_FixUnsupportedCivilians(SithThing* player)
+{
+    if (jkRpg_Get(player, RPG_BIN_CROWDFIX)) return;
+    sithInventory_SetInventory(player, RPG_BIN_CROWDFIX, 1);
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    // Old saves have no dedicated crowd tag. Only repair the stock campaign maps
+    // whose scripts never create ordinary civilians; custom scripted actors stay put.
+    if (!jkRpg_IsCrowdMap(world->map_jkl_fname)) return;
+    int unsupported = 0, moved = 0;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* thing = &world->aThings[i];
+        int kind = jkRpg_CivilianKind(thing);
+        if ((kind != 1 && kind != 2) || !thing->sector || jkRpg_IsAuthored(thing)
+            || (thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED)) || jkRpg_StandsSupported(thing))
+            continue;
+        unsupported++;
+        for (int attempt = 0; attempt < 160; attempt++) {
+            flex_t angle = (attempt % 16) * (2.0 * M_PI / 16.0);
+            flex_t distance = 0.3 + (attempt / 16) * 0.085;
+            rdVector3 pos = thing->position;
+            pos.x += cos(angle) * distance;
+            pos.y += sin(angle) * distance;
+            SithSector* sector = jkRpg_CrowdPosition(thing, thing, &pos, 0.14);
+            if (!sector) continue;
+            jkRpg_MoveActor(thing, pos, sector);
+            moved++;
+            break;
+        }
+    }
+    stdPlatform_Printf("RPG crowd support: %s unsupported=%d moved=%d\n", world->map_jkl_fname, unsupported, moved);
+}
+
+// Remove only added civilians from the booth and cargo-walkway obstructions.
+// Saved world slots are reused, so match template and location instead of an index.
+static void jkRpg_ClearCrowdObstructions(SithThing* player)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    int booth = !__strcmpi(world->map_jkl_fname, "01narshadda.jkl");
+    int walkway = !__strcmpi(world->map_jkl_fname, "02narshadda.jkl");
+    if ((!booth && !walkway)
+        || jkRpg_Get(player, RPG_BIN_CROWDS) != (booth ? 2 : 1)
+        || jkRpg_Get(player, RPG_BIN_CROWDFIX) < 2) return;
+    // Density repair waits for civilian COGs to register their population first.
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* thing = &world->aThings[i];
+        if (thing->type != SITH_THING_ACTOR || jkRpg_IsAuthored(thing)
+            || !thing->pTemplate || __strcmpi(thing->pTemplate->aName, booth ? "nman1" : "nwoman2")
+            || (thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))) continue;
+        rdVector3 pos = thing->position;
+        // Includes the initial placement and its small floor/collision settling.
+        if (booth) {
+            if (pos.x < -10.71 || pos.x > -10.59 || pos.y < -5.50 || pos.y > -5.08
+                || pos.z < -1.25 || pos.z > -1.0) continue;
+        }
+        else if (pos.x < -0.30 || pos.x > 0.30 || pos.y < -0.30 || pos.y > 0.20
+            || pos.z < -4.90 || pos.z > -4.60) continue;
+        sithThing_DestroyThing(thing);
+        sithInventory_ChangeInventory(player, SITHBIN_PEDS_TOTAL, -1);
+        break;
+    }
+    // If the civilian has died or left, do not remove a later visitor.
+    sithInventory_SetInventory(player, RPG_BIN_CROWDS, 3);
+}
