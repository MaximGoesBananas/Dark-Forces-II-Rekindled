+flex_t jkRpg_ForceScriptInv(sithCog* pCog, int bin, flex_t amount)
+{
+    if (bin < SITHBIN_F_ABSORB || bin > SITHBIN_F_DEADLYSIGHT || !jkRpg_IsPowerScript(pCog, bin))
