+
+// Equal proportional steps give low sensitivities the same precision as high ones.
+static flex_t jkGuiSetup_MouseFromStep(int step)
+{
+    if (step < 0) step = 0;
+    if (step > RPGSETUP_MOUSE_STEPS) step = RPGSETUP_MOUSE_STEPS;
+    return 0.0025 * pow(2.0, step / 10.0);
+}
+
+static int jkGuiSetup_MouseToStep(flex_t sensitivity)
+{
+    if (!(sensitivity > 0.0025)) return 0;
+    if (sensitivity >= 1.28) return RPGSETUP_MOUSE_STEPS;
+    return (int)(10.0 * log2(sensitivity / 0.0025) + 0.5);
+}
+
