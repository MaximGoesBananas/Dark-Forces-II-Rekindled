+// ------------------------------------------------------------------------------------------------
+// Build the fallback atlas once per HUD session, then overlay shipped BMP tiles.
+// Game item icons and rendered weapon models supply the remaining headings.
+
+#define TILE 24                              // tile size in pixels, like the game's item icons
+#define TILE_CELL (TILE + 2)                 // atlas cell with a spacer so tiles never bleed together
+#define TILES_PER_BRANCH (1 + RPG_MAX_RANK)  // the heading, then one per upgrade
+#define TILE_LOCK (UP_COUNT * TILES_PER_BRANCH)
+#define TILE_COUNT (TILE_LOCK + 1)
+#define ATLAS_COLS 8
+#define ATLAS_ROWS ((TILE_COUNT + ATLAS_COLS - 1) / ATLAS_COLS)
+
+static const uint8_t jkRpg_aFixedColors[][4] = {
+    {'e', 96, 64, 8}, {'f', 168, 112, 16}, {'g', 240, 180, 40}, {'h', 255, 236, 150},  // gold
+    {'s', 56, 60, 72}, {'t', 112, 116, 132}, {'u', 180, 184, 200},                     // steel
+    {'w', 255, 255, 255}, {'x', 150, 24, 16}, {'y', 240, 72, 40},                      // white, red
+    {'k', 6, 5, 4},                                                                    // outline
+};
+
+static stdBitmap* jkRpg_pMenuArt;
+static int jkRpg_bMenuArtFailed;
+
+static int jkRpg_ArtColor(int accent, char ch, uint8_t rgb[3])
+{
+    if (ch >= 'a' && ch <= 'd') {
+        memcpy(rgb, jkRpg_aAccents[accent][ch - 'a'], 3);
+        return 1;
+    }
+    for (size_t i = 0; i < sizeof(jkRpg_aFixedColors) / sizeof(jkRpg_aFixedColors[0]); i++)
+        if (jkRpg_aFixedColors[i][0] == ch) {
+            memcpy(rgb, &jkRpg_aFixedColors[i][1], 3);
+            return 1;
+        }
+    return 0;
+}
+
+static uint16_t jkRpg_Pixel(const uint8_t rgb[3])
+{
+    return 0x8000 | ((rgb[0] >> 3) << 10) | ((rgb[1] >> 3) << 5) | (rgb[2] >> 3);
+}
+
+// The same RGB1555 pixel without colour (its brightness), keeping transparency.
+static uint16_t jkRpg_GrayPixel(uint16_t pixel)
+{
+    int r = (pixel >> 10) & 31, g = (pixel >> 5) & 31, b = pixel & 31;
+    int v = (r * 77 + g * 150 + b * 29) >> 8;
+    return (pixel & 0x8000) | (v << 10) | (v << 5) | v;
+}
+
+// Drawing state: when set, menu tiles and text use their colourless copies, all equally dim.
+static int jkRpg_bGray;
+#define RPG_GRAY_TILE 150
+#define RPG_GRAY_TEXT 150
+
+static void jkRpg_PaintArt(uint16_t* px, int stride, int x, int y, int art, int accent)
+{
+    for (int r = 0; jkRpg_aArt[art][r]; r++)
+        for (int c = 0; jkRpg_aArt[art][r][c]; c++) {
+            uint8_t rgb[3];
+            if (jkRpg_ArtColor(accent, jkRpg_aArt[art][r][c], rgb))
+                px[(y + r) * stride + x + c] = jkRpg_Pixel(rgb);
+        }
+}
+
+// A 7x7 badge in the tile's lower right corner, cut out of the picture by a dark outline.
+static void jkRpg_PaintBadge(uint16_t* px, int stride, int badge, int accent)
+{
+    const int at = TILE - 2 - 7;
+    const uint8_t outline[3] = {6, 5, 4};
+    for (int r = -1; r <= 7; r++)
+        for (int c = -1; c <= 7; c++)
+            for (int n = 0; n < 9; n++) {
+                int br = r + n / 3 - 1, bc = c + n % 3 - 1;
+                if (br >= 0 && br < 7 && bc >= 0 && bc < 7 && jkRpg_aArt[badge][br][bc] != '.') {
+                    px[(at + r) * stride + at + c] = jkRpg_Pixel(outline);
+                    break;
+                }
+            }
+    jkRpg_PaintArt(px, stride, at, at, badge, accent);
+}
+
+// A tile like the HUD item icons: one-pixel steel frame, black inside, the picture centred.
+static void jkRpg_PaintTile(uint16_t* px, int stride, int art, int badge, int accent)
+{
+    const uint8_t light[3] = {88, 92, 112}, dark[3] = {48, 56, 72}, black[3] = {0, 0, 0};
+    for (int r = 0; r < TILE; r++)
+        for (int c = 0; c < TILE; c++)
+            px[r * stride + c] = jkRpg_Pixel(r == TILE - 1 || c == TILE - 1 ? dark : (r == 0 || c == 0 ? light : black));
+    int h = 0;
+    while (jkRpg_aArt[art][h]) h++;
+    int w = (int)strlen(jkRpg_aArt[art][0]);
+    int x = (TILE - w) / 2, y = (TILE - h) / 2;
+    if (badge != BADGE_NONE) { // leave the corner to the badge
+        x = x > 3 ? x - 1 : 2;
+        y = y > 3 ? y - 1 : 2;
+    }
+    jkRpg_PaintArt(px, stride, x, y, art, accent);
+    if (badge != BADGE_NONE)
+        jkRpg_PaintBadge(px, stride, badge, accent);
+}
+
+// An empty 16-bit RGB1555 bitmap that can be drawn on the HUD (same setup as the weapon icons).
+static stdBitmap* jkRpg_NewBitmap(int width, int height)
+{
+    tRasterInfo format = {0};
+    format.width = width; format.height = height;
+    format.format = (rdTexFormat){.bpp=16, .is16bit=1, .r_bits=5, .g_bits=5, .b_bits=5,
+        .r_shift=10, .g_shift=5, .b_shift=0, .r_bitdiff=3, .g_bitdiff=3, .b_bitdiff=3};
+    stdBitmap* bitmap = stdBitmap_New(1, 0, 0, 0, &format.format);
+    if (!bitmap) return NULL;
+    bitmap->mipSurfaces[0] = stdDisplay_VBufferNew(&format, 0, 0, NULL);
+#ifdef SDL2_RENDER
+    bitmap->aTextureIds = STD_ALLOC(sizeof(uint32_t));
+    bitmap->abLoadedToGPU = STD_ALLOC(sizeof(int));
+    bitmap->paDataDepthConverted = STD_ALLOC(sizeof(void*));
+    if (bitmap->aTextureIds) bitmap->aTextureIds[0] = 0;
+    if (bitmap->abLoadedToGPU) bitmap->abLoadedToGPU[0] = 0;
+    if (bitmap->paDataDepthConverted) bitmap->paDataDepthConverted[0] = NULL;
+    if (!bitmap->aTextureIds || !bitmap->abLoadedToGPU || !bitmap->paDataDepthConverted) {
+        stdBitmap_Free(bitmap);
+        return NULL;
+    }
+#endif
+#ifdef STDBITMAP_PARTIAL_LOAD
+    bitmap->bLoaded = 1;
+#endif
+    if (!bitmap->mipSurfaces[0]) {
+        stdBitmap_Free(bitmap);
+        return NULL;
+    }
+    return bitmap;
+}
+
+static void jkRpg_OverlayShippedTiles(uint16_t* px, int stride); // generated pictures (end of file)
+static int jkRpg_DrawShippedFrame(int x, int y, int w, int h);
+static int jkRpg_DrawShippedBar(int x, int y, int w, int h);
+static void jkRpg_FreeShippedArt(void);
+
+static stdBitmap* jkRpg_MenuArt(void)
+{
+    if (jkRpg_pMenuArt || jkRpg_bMenuArtFailed)
+        return jkRpg_pMenuArt;
+    // The lower half repeats every tile without colour, for upgrades out of reach.
+    stdBitmap* bitmap = jkRpg_NewBitmap(ATLAS_COLS * TILE_CELL, 2 * ATLAS_ROWS * TILE_CELL);
+    tVBuffer* buffer = bitmap ? bitmap->mipSurfaces[0] : NULL;
+    if (!buffer || !stdDisplay_VBufferLock(buffer)) {
+        if (bitmap) stdBitmap_Free(bitmap);
+        jkRpg_bMenuArtFailed = 1; // draw the menu without pictures rather than retry every frame
+        return NULL;
+    }
+    uint16_t* px = (uint16_t*)buffer->surface_lock_alloc;
+    int stride = buffer->format.rowSize / 2;
+    memset(px, 0, buffer->format.rowSize * 2 * ATLAS_ROWS * TILE_CELL);
+    for (int tile = 0; tile < TILE_COUNT; tile++) {
+        uint16_t* at = px + ((tile / ATLAS_COLS) * TILE_CELL + 1) * stride + (tile % ATLAS_COLS) * TILE_CELL + 1;
+        int up = tile / TILES_PER_BRANCH, k = tile % TILES_PER_BRANCH;
+        if (tile == TILE_LOCK)
+            jkRpg_PaintBadge(at, stride, BADGE_LOCK, 0);
+        else if (k == 0 && jkRpg_aBranchArt[up].heading != ART_NONE)
+            jkRpg_PaintTile(at, stride, jkRpg_aBranchArt[up].heading, BADGE_NONE, jkRpg_aBranchArt[up].accent);
+        else if (k > 0)
+            jkRpg_PaintTile(at, stride, jkRpg_aBranchArt[up].art[k - 1], jkRpg_aBranchArt[up].badge[k - 1],
+                            jkRpg_aBranchArt[up].accent);
+    }
+    jkRpg_OverlayShippedTiles(px, stride);
+    for (int y = 0; y < ATLAS_ROWS * TILE_CELL; y++)
+        for (int x = 0; x < ATLAS_COLS * TILE_CELL; x++)
+            px[(y + ATLAS_ROWS * TILE_CELL) * stride + x] = jkRpg_GrayPixel(px[y * stride + x]);
+    stdDisplay_VBufferUnlock(buffer);
+    jkRpg_pMenuArt = bitmap;
+    return bitmap;
+}
+
+// The texture belongs to the HUD session (jkHud_Close), like the weapon icons.
+static void jkRpg_FreeLevelBadge(void);
+static void jkRpg_FreeGrayFont(void);
+static void jkRpg_FreeBactaGray(void);
+
+void jkRpg_FreeMenuArt(void)
+{
+    jkRpg_FreeLevelBadge();
+    jkRpg_FreeShippedArt();
+    jkRpg_FreeGrayFont();
+    jkRpg_FreeBactaGray();
+    if (jkRpg_pMenuArt)
+        stdBitmap_Free(jkRpg_pMenuArt);
+    jkRpg_pMenuArt = NULL;
+    jkRpg_bMenuArtFailed = 0;
+}
+
+static void jkRpg_DrawTile(int tile, int x, int y, flex_t scale, uint8_t bright)
+{
+    stdBitmap* art = jkRpg_MenuArt();
+    if (!art) return;
+    rdRect src = {(tile % ATLAS_COLS) * TILE_CELL + 1,
+                  (tile / ATLAS_COLS + (jkRpg_bGray ? ATLAS_ROWS : 0)) * TILE_CELL + 1, TILE, TILE};
+    std3D_DrawUIBitmapRGBA(art, 0, x, y, &src, scale, scale, 1, bright, bright, bright, 255);
+}
+
+// ------------------------------------------------------------------------------------------------
+// Navigation
+
+static int jkRpg_menuPage = 0;
+static int jkRpg_menuSel = 0;
+
+static int jkRpg_KeyPressed(int key)
+{
+    int count = 0;
+    stdControl_ReadKey(key, &count);
+    return count > 0;
+}
+
+static int jkRpg_PageShown(SithThing* p, int page)
+{
+    for (int up = 0; up < UP_COUNT; up++)
+        if (jkRpg_aUpgrades[up].page == page && jkRpg_IsFound(p, up))
+            return 1;
+    return 0;
+}
+
+// Keep the page and selection on something visible, e.g. after a load.
+static void jkRpg_FixSelection(SithThing* p)
+{
+    for (int i = 0; i < PAGE_COUNT && !jkRpg_PageShown(p, jkRpg_menuPage); i++)
+        jkRpg_menuPage = (jkRpg_menuPage + 1) % PAGE_COUNT;
+    if (jkRpg_menuSel < 0 || jkRpg_menuSel >= UP_COUNT || jkRpg_aUpgrades[jkRpg_menuSel].page != jkRpg_menuPage
+        || !jkRpg_IsFound(p, jkRpg_menuSel)) {
+        for (int up = 0; up < UP_COUNT; up++)
+            if (jkRpg_aUpgrades[up].page == jkRpg_menuPage && jkRpg_IsFound(p, up)) {
+                jkRpg_menuSel = up;
+                break;
+            }
+    }
+}
+
+static void jkRpg_MovePage(SithThing* p, int step)
+{
+    for (int i = 0; i < PAGE_COUNT; i++) {
+        jkRpg_menuPage = (jkRpg_menuPage + step + PAGE_COUNT) % PAGE_COUNT;
+        if (jkRpg_PageShown(p, jkRpg_menuPage))
+            break;
+    }
+    jkRpg_menuSel = -1;
+    jkRpg_FixSelection(p);
+}
+
+static void jkRpg_MoveSel(SithThing* p, int step)
+{
+    int up = jkRpg_menuSel;
+    for (int i = 0; i < UP_COUNT; i++) {
+        up = (up + step + UP_COUNT) % UP_COUNT;
+        if (jkRpg_aUpgrades[up].page == jkRpg_menuPage && jkRpg_IsFound(p, up)) {
+            jkRpg_menuSel = up;
+            return;
+        }
+    }
+}
+
+int jkRpg_MenuInput(SithThing* p)
+{
+    jkRpg_FixSelection(p);
+    static int lastX, lastY;
+    flex_t x = stdControl_ReadAxis(AXIS_JOY1_X), y = stdControl_ReadAxis(AXIS_JOY1_Y);
+    int dirX = x < -0.5 ? -1 : x > 0.5 ? 1 : 0;
+    int dirY = y < -0.5 ? -1 : y > 0.5 ? 1 : 0;
+    int moveX = dirX != lastX ? dirX : 0, moveY = dirY != lastY ? dirY : 0;
+    lastX = dirX; lastY = dirY;
+    if (jkRpg_KeyPressed(KEY_JOY1_B2)) return 0;
+    if (jkRpg_KeyPressed(DIK_UP) || jkRpg_KeyPressed(DIK_W) || jkRpg_KeyPressed(KEY_JOY1_HUP) || moveY < 0)
+        jkRpg_MoveSel(p, -1);
+    if (jkRpg_KeyPressed(DIK_DOWN) || jkRpg_KeyPressed(DIK_S) || jkRpg_KeyPressed(KEY_JOY1_HDOWN) || moveY > 0)
+        jkRpg_MoveSel(p, 1);
+    if (jkRpg_KeyPressed(DIK_LEFT) || jkRpg_KeyPressed(DIK_A) || jkRpg_KeyPressed(DIK_Q)
+        || jkRpg_KeyPressed(KEY_JOY1_HLEFT) || jkRpg_KeyPressed(KEY_JOY1_B10) || moveX < 0)
+        jkRpg_MovePage(p, -1);
+    if (jkRpg_KeyPressed(DIK_RIGHT) || jkRpg_KeyPressed(DIK_D) || jkRpg_KeyPressed(DIK_E) || jkRpg_KeyPressed(DIK_TAB)
+        || jkRpg_KeyPressed(KEY_JOY1_HRIGHT) || jkRpg_KeyPressed(KEY_JOY1_B11) || moveX > 0)
+        jkRpg_MovePage(p, 1);
+    if (jkRpg_KeyPressed(DIK_RETURN) || jkRpg_KeyPressed(DIK_SPACE) || jkRpg_KeyPressed(KEY_JOY1_B1))
+        jkRpg_Toggle(p, jkRpg_menuSel);
+    return 1;
+}
