+// Weapons dropped by enemies use the game's "+d" drop templates (+dstrifle, +dgreedopistol, ...),
+// which only enemy scripts create when they die; no level places them. A pickup keeps its template
+// through saves, so the distinction needs no extra state. Loose ammo drops use ammo scripts instead.
+static int jkRpg_IsEnemyWeapon(sithCog* pCog)
+{
+    static const char* scripts[] = {"pow_dstrifle.cog", "pow_dcrossbow.cog", "pow_drepeater.cog", "pow_drailgun.cog",
+        "pow_dconcrifle.cog", "pow_bryar.cog", "pow_thermal.cog", "pow_single_thermal.cog"};
+    SithThing* item = pCog->senderType == SENDERTYPE_THING ? sithThing_GetThingByIndex(pCog->senderRef) : NULL;
+    if (!item || !item->pTemplate || __strnicmp(item->pTemplate->aName, "+d", 2))
+        return 0;
+    for (size_t i = 0; i < sizeof(scripts) / sizeof(scripts[0]); i++)
+        if (jkRpg_IsScript(pCog, scripts[i]))
+            return 1;
+    return 0;
+}
