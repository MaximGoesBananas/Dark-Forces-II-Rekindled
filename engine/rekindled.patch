+
+// Seeing, Persuasion and Absorb end on timer 1; Blinding's only timer is each victim's blindness.
+// Speed's own timer already lasts 5 + 2.5 * rank.
+flex_t jkRpg_ForceTimer(sithCog* pCog, int id, flex_t delay)
+{
+    static const int timed[4] = {SITHBIN_F_SEEING, SITHBIN_F_PERSUASION, SITHBIN_F_ABSORB, SITHBIN_F_BLINDING};
+    if (delay <= 0)
+        return delay;
+    for (int i = 0; i < 4; i++)
+        if ((id == 1 || timed[i] == SITHBIN_F_BLINDING) && jkRpg_IsPowerScript(pCog, timed[i]))
+            return jkRpg_ForceSeconds((int)sithInventory_GetInventory(sithPlayer_g_pLocalPlayerThing, timed[i]));
+    return delay;
+}
+
+flex_t jkRpg_ForceExtraSpeed(sithCog* pCog, SithThing* pThing, flex_t extra)
+{
+    if (extra <= 0 || pThing != sithPlayer_g_pLocalPlayerThing || !jkRpg_IsPowerScript(pCog, SITHBIN_F_SPEED))
+        return extra;
+    return pThing->actorParams.maxThrust * (RPG_FORCE_SPEED - 1.0);
+}
+
+// The script adds 2.5 plus the held time (0.35 * rank at most, or that full amount on a tap) to the
+// current velocity. Keep the held share, between a normal jump and the rank's full height.
+// Launch speeds target 3.0/3.6/4.4/4.9 times normal height with campaign gravity 4,
+// player air drag 0.5 and jump speed 1.5 at 120 Hz; height is not launch speed.
+void jkRpg_ForceJumpVel(sithCog* pCog, SithThing* pThing, rdVector3* pVel)
+{
+    // Level scripts push other things too; only the local player has an inventory to read.
+    if (!pThing || pThing != sithPlayer_g_pLocalPlayerThing || !jkRpg_IsPowerScript(pCog, SITHBIN_F_JUMP))
+        return;
+    int rank = (int)sithInventory_GetInventory(pThing, SITHBIN_F_JUMP);
+    if (rank < 1)
+        return;
+    flex_t held = (pVel->z - pThing->physicsParams.vel.z - 2.5) / (0.35 * rank);
+    held = held < 0 ? 0 : held > 1 ? 1 : held;
+    static const flex_t jumpSpeed[5] = {1.0, 1.795378, 1.983583, 2.215835, 2.352489};
+    pVel->z = pThing->physicsParams.vel.z + pThing->actorParams.jumpSpeed * (1.0 + (jumpSpeed[jkRpg_ForceRankClamp(rank)] - 1.0) * held);
+}
