+    sithGamesave_GetProfilePath(temporary, sizeof(temporary), "autosave.tmp");
+    sithGamesave_GetProfilePath(destination, sizeof(destination), "autosave.jks");
+    memcpy(restart, sithGamesave_autosave_fname, sizeof(restart));
+    memcpy(previousFilename, sithGamesave_aCurFilename, sizeof(previousFilename));
+    // The load menu requires "level title~display name" in every visible save.
