+// The equipment whose first receipt unlocks a branch; 0 for skills, which are always available.
+static int jkRpg_FoundBin(int up, int second)
+{
+    if (up == UP_BACTA) return second ? 0 : SITHBIN_BACTATANK;
+    if (up == UP_LIGHT) return second ? 0 : SITHBIN_FIELDLIGHT;
+    return second ? 0 : jkRpg_aUpgrades[up].weapon;
+}
+
+// Remember equipment the player has held, so its branch stays after ammo runs out or an item is used.
+static void jkRpg_Discover(SithThing* p)
+{
+    int found = jkRpg_Get(p, RPG_BIN_FOUND), was = found;
+    // Escape from the Mines introduces traps before the player owns charges.
+    if (sithWorld_g_pCurrentWorld && !Main_bMotsCompat
+        && !__strcmpi(sithWorld_g_pCurrentWorld->map_jkl_fname, "04escapehouse.jkl"))
+        found |= 1 << UP_SEQUENCER;
+    for (int up = 0; up < UP_COUNT; up++)
+        for (int second = 0; second < 2; second++) {
+            int bin = jkRpg_FoundBin(up, second);
+            if (bin && sithInventory_GetInventory(p, bin) > 0)
+                found |= 1 << up;
+        }
+    if (found != was)
+        sithInventory_SetInventory(p, RPG_BIN_FOUND, found);
+}
+
+int jkRpg_IsFound(SithThing* p, int up)
+{
+    if (up == UP_FORCE) // the story grants Force powers
+        return sithInventory_GetInventory(p, SITHBIN_JEDI_RANK) > 0;
+    if (!jkRpg_FoundBin(up, 0))
+        return 1;
+    return (jkRpg_Get(p, RPG_BIN_FOUND) >> up) & 1;
+}
+
+// Levels 1-10 keep the early curve (about three levels in each of missions 1 and 2, two in
+// mission 3); later levels cost 13 XP more each time. Level 40 costs 52 XP more, for the eight
+// Rodians that missions 1 and 2 create at startup, so it takes 17,117 XP: every enemy and boss of
+// either route (17,118 XP), with only 1 XP to spare. docs/PROGRESSION.md has the table.
+#define RPG_SCRIPT_ENEMY_XP 52
+int jkRpg_XpForLevel(int level)
+{
+    if (level <= 1) return 0;
+    int n = level - 2;
+    int late = level > 10 ? level - 10 : 0;
+    return 100 + 200 * n + 5 * n * (n - 1) / 2 + 13 * late * late / 2
+        + (level >= RPG_MAX_LEVEL ? RPG_SCRIPT_ENEMY_XP : 0);
+}
