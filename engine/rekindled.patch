+    char16_t* levelTitle = jkGuiTitle_quicksave_related_func1(&jkCog_strings, sithWorld_g_pCurrentWorld->map_jkl_fname);
+    jk_snwprintf(title, 256, u"%s~Autosave", levelTitle);
+    if (!sithGamesave_Save("autosave.tmp", 1, 0, title)) return 0;
+    sithGamesave_Process();
+    memcpy(sithGamesave_autosave_fname, restart, sizeof(restart));
+    memcpy(sithGamesave_aCurFilename, previousFilename, sizeof(previousFilename));
+    int published = 0;
+    if (sithGamesave_lastWriteSucceeded) {
+#ifdef WIN32
+        published = MoveFileExA(temporary, destination, MOVEFILE_REPLACE_EXISTING) != 0;
+#else
+        published = rename(temporary, destination) == 0;
+#endif
+    }
+    if (!published) remove(temporary);
+    else {
+        // The autosave is now the latest save: death restarts from it, falling back to the save before it.
+        if (__strcmpi(restart, "autosave.jks"))
+            memcpy(sithGamesave_preAutosave, restart, sizeof(restart));
+        stdString_SafeStrCopy(sithGamesave_autosave_fname, "autosave.jks", sizeof(sithGamesave_autosave_fname));
+    }
+    return published;
+}
