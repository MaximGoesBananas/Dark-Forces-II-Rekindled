+static void jkGuiSetup_SliderDraw(jkGuiElement *element, jkGuiMenu *menu, tVBuffer *vbuf, BOOL redraw)
+{
+    int which = (int)(element - jkGuiSetup_Slider(0)) / 3;
+    int v = element->selectedTextEntry;
+    char16_t* out = jkGuiSetup_aValueText[which];
+    switch (which) {
+    case RPGS_FOV:        jk_snwprintf(out, 16, u"%d", FOV_MIN + v); break;
+    case RPGS_BRIGHTNESS: jk_snwprintf(out, 16, u"%.2f", 0.5 + 0.05 * v); break;
+    case RPGS_HUD:        jk_snwprintf(out, 16, u"%.2fx", 1.0 + 0.25 * v); break;
+    case RPGS_MOUSE:      jk_snwprintf(out, 16, u"%.1f", 1.0 + v * 0.1); break;
+    case RPGS_SABER:      stdString_CharToWchar(out, jkRpg_SaberColorName(v), 15); out[15] = 0; break;
+    case RPGS_CROSSHAIR:  stdString_CharToWchar(out, jkGuiSetup_aCrosshairNames[v < 0 ? 0 : (v > 4 ? 4 : v)], 15); out[15] = 0; break;
+    case RPGS_CROSSSIZE:  jk_snwprintf(out, 16, u"%d%%", 50 + 25 * v); break;
+    case RPGS_CROSSCOLOR: stdString_CharToWchar(out, jkRpg_CrosshairColorName(v), 15); out[15] = 0; break;
+    case RPGS_AUTOSAVE:
+        if (v == 0) stdString_CharToWchar(out, "Off", 15);
+        else jk_snwprintf(out, 16, u"%d min", v);
+        out[15] = 0;
+        break;
+    default:              jk_snwprintf(out, 16, u"%d%%", v); break;
+    }
+    element[1].wstr = out;
+    element[-1].textType = menu->lastMouseOverClickable == element ? 1 : 0;
+    jkGuiRend_UpdateAndDrawClickable(&element[-1], menu, 1);
+    jkGuiRend_SliderDraw(element, menu, vbuf, redraw);
+    jkGuiRend_UpdateAndDrawClickable(&element[1], menu, 1);
+}
+
+static int jkGuiSetup_Clamp(int v, int max) { return v < 0 ? 0 : (v > max ? max : v); }
+
+static void jkGuiSetup_Load(void)
+{
+    jkGuiSetup_Slider(RPGS_FOV)->selectedTextEntry = jkGuiSetup_Clamp(jkPlayer_fov - FOV_MIN, FOV_MAX - FOV_MIN);
+    jkGuiSetup_Slider(RPGS_BRIGHTNESS)->selectedTextEntry = jkGuiSetup_Clamp((int)((jkPlayer_gamma - 0.5) / 0.05 + 0.5), 30);
+    jkGuiSetup_Slider(RPGS_HUD)->selectedTextEntry = jkGuiSetup_Clamp((int)((jkPlayer_hudScale - 1.0) / 0.25 + 0.5), 12);
+    jkGuiSetup_Slider(RPGS_MUSIC)->selectedTextEntry = jkGuiSetup_Clamp((int)(jkGuiSound_musicVolume / RPG_MAX_VOLUME * 100.0 + 0.5), 100);
+    jkGuiSetup_Slider(RPGS_EFFECTS)->selectedTextEntry = jkGuiSetup_Clamp((int)(jkGuiSound_sfxVolume / RPG_MAX_VOLUME * 100.0 + 0.5), 100);
+    jkGuiSetup_loadedMouseStep = jkGuiSetup_MouseToStep(sithControl_GetMouseSensitivity());
+    jkGuiSetup_Slider(RPGS_MOUSE)->selectedTextEntry = jkGuiSetup_loadedMouseStep;
+    jkGuiSetup_Slider(RPGS_SABER)->selectedTextEntry = jkGuiSetup_Clamp(jkRpg_GetSaberColor(), 4);
+    jkGuiSetup_Slider(RPGS_CROSSHAIR)->selectedTextEntry = jkGuiSetup_Clamp(jkPlayer_setCrosshair, 4);
+    jkGuiSetup_Slider(RPGS_CROSSSIZE)->selectedTextEntry = jkGuiSetup_Clamp((int)((jkPlayer_crosshairScale - 0.5) / 0.25 + 0.5), 6);
+    jkGuiSetup_Slider(RPGS_CROSSCOLOR)->selectedTextEntry = jkGuiSetup_Clamp(jkRpg_GetCrosshairColor(), 4);
+
+    jkGuiSetup_Slider(RPGS_AUTOSAVE)->selectedTextEntry = jkGuiSetup_Clamp(jkRpg_GetAutosaveMinutes(), 15);
+
+    jkGuiSetup_Check(RPGC_INVERT)->boxChecked = sithControl_GetMouseInverted();
+    jkGuiSetup_Check(RPGC_SUBTITLES)->boxChecked = jkPlayer_setFullSubtitles;
+    jkGuiSetup_Check(RPGC_AUTOAIM)->boxChecked = sithWeapon_bAutoAim & 1;
+    jkGuiSetup_Check(RPGC_SWAY)->boxChecked = !jkPlayer_bDisableWeaponWaggle;
+    jkGuiSetup_Check(RPGC_SABERCAM)->boxChecked = jkPlayer_setSaberCam;
+    jkGuiSetup_Check(RPGC_VSYNC)->boxChecked = jkPlayer_enableVsync;
+    jkGuiSetup_Check(RPGC_WEAPONSWITCHER)->boxChecked = jkRpg_GetWeaponSwitcher();
+}
+
+static void jkGuiSetup_ApplyMouse(void)
+{
+    int step = jkGuiSetup_Slider(RPGS_MOUSE)->selectedTextEntry;
+    int inverted = jkGuiSetup_Check(RPGC_INVERT)->boxChecked != 0;
+    // Keep both stored axis values exactly when another setting is changed.
+    if (step != jkGuiSetup_loadedMouseStep)
+        sithControl_SetMouseLook(jkGuiSetup_MouseFromStep(step), inverted);
+    else if (inverted != sithControl_GetMouseInverted())
+        sithControl_SetMouseInverted(inverted);
+}
+
+static void jkGuiSetup_Apply(void)
+{
+    jkPlayer_fov = FOV_MIN + jkGuiSetup_Slider(RPGS_FOV)->selectedTextEntry;
+    jkPlayer_ClampFov();
+    jkRpg_SetSaberColor(jkGuiSetup_Slider(RPGS_SABER)->selectedTextEntry);
+    jkPlayer_gamma = 0.5 + 0.05 * jkGuiSetup_Slider(RPGS_BRIGHTNESS)->selectedTextEntry;
+    jkPlayer_hudScale = 1.0 + 0.25 * jkGuiSetup_Slider(RPGS_HUD)->selectedTextEntry;
+    jkGuiSound_musicVolume = RPG_MAX_VOLUME * 0.01 * jkGuiSetup_Slider(RPGS_MUSIC)->selectedTextEntry;
+    jkGuiSound_sfxVolume = RPG_MAX_VOLUME * 0.01 * jkGuiSetup_Slider(RPGS_EFFECTS)->selectedTextEntry;
+    jkGuiSetup_ApplyMouse();
+
+    // Crosshair style: 0 off, 1 classic (the original), 2 small cross, 3 dot, 4 circle.
+    jkPlayer_setCrosshair = jkGuiSetup_Slider(RPGS_CROSSHAIR)->selectedTextEntry;
+    jkPlayer_crosshairScale = 0.5 + 0.25 * jkGuiSetup_Slider(RPGS_CROSSSIZE)->selectedTextEntry;
+    jkRpg_SetCrosshairColor(jkGuiSetup_Slider(RPGS_CROSSCOLOR)->selectedTextEntry);
+    jkPlayer_setFullSubtitles = jkGuiSetup_Check(RPGC_SUBTITLES)->boxChecked != 0;
+    sithWeapon_bAutoAim = jkGuiSetup_Check(RPGC_AUTOAIM)->boxChecked != 0;
+    jkPlayer_bDisableWeaponWaggle = !jkGuiSetup_Check(RPGC_SWAY)->boxChecked;
+    jkPlayer_setSaberCam = jkGuiSetup_Check(RPGC_SABERCAM)->boxChecked != 0;
+    jkPlayer_enableVsync = jkGuiSetup_Check(RPGC_VSYNC)->boxChecked != 0;
+    jkRpg_SetWeaponSwitcher(jkGuiSetup_Check(RPGC_WEAPONSWITCHER)->boxChecked);
+    jkRpg_SetAutosaveMinutes(jkGuiSetup_Slider(RPGS_AUTOSAVE)->selectedTextEntry);
+
+    wuRegistry_SaveFloat("musicVolume", jkGuiSound_musicVolume);
+    wuRegistry_SaveFloat("sfxVolume", jkGuiSound_sfxVolume);
+    sithSoundMixer_UpdateMusicVolume(jkGuiSound_musicVolume);
+    stdSound_SetMenuVolume(jkGuiSound_sfxVolume);
+    jkPlayer_WriteConf(jkPlayer_playerShortName);
+    std3D_UpdateSettings();
+}
