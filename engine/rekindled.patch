+// Remove only the original campaign goggles; surrounding rewards remain untouched.
+// A bounded list also handles older saves without scanning the entire world each frame.
+static void jkRpg_RemoveGoggles(SithThing* p)
+{
+    if (!jkRpg_IsActive(p) || Main_bMotsCompat) return;
+    if (sithInventory_IsInventoryActivated(p, SITHBIN_IRGOGGLES)) {
+        // The original deactivation frees its green effect and pulse, preserving Force Seeing.
+        sithInventory_SetInventory(p, SITHBIN_IRGOGGLES, 1);
+        jkRpg_ToggleVisionItem(p, SITHBIN_IRGOGGLES);
+    }
+    sithInventory_SetInventory(p, SITHBIN_IRGOGGLES, 0);
+    sithInventory_SetInventoryAvailable(p, SITHBIN_IRGOGGLES, 0);
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (!world) return;
+    static const struct { const char* map; int index; } pickups[] = {
+        {"01narshadda.jkl", 141}, {"02narshadda.jkl", 384},
+        {"04escapehouse.jkl", 301}, {"06abarons.jkl", 272},
+        {"06bbarons.jkl", 206}, {"06bbarons.jkl", 214},
+        {"06bbarons.jkl", 291}, {"06bbarons.jkl", 328}
+    };
+    for (unsigned i = 0; i < sizeof(pickups) / sizeof(pickups[0]); ++i) {
+        if (__strcmpi(world->map_jkl_fname, pickups[i].map)
+            || pickups[i].index >= world->numThingsLoaded) continue;
+        SithThing* item = &world->aThings[pickups[i].index];
+        if (item->type == SITH_THING_ITEM && item->guid == pickups[i].index
+            && !(item->flags & SITH_TF_DESTROYED) && item->pTemplate
+            && !__strcmpi(item->pTemplate->aName, "goggles"))
+            sithThing_DestroyThing(item);
+    }
+}
