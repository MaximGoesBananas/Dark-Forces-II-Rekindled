+static void jkRpg_AddXp(SithThing* p, int gain)
+{
+    int xp = jkRpg_Get(p, RPG_BIN_XP) + gain;
+    int level = jkRpg_Get(p, RPG_BIN_LEVEL);
+    if (level < 1) level = 1;
+    int startingLevel = level;
+    sithInventory_SetInventory(p, RPG_BIN_XP, xp);
+    sithInventory_ChangeInventory(p, RPG_BIN_MISSIONXP, gain);
+    jkRpg_Print("+%d XP", gain, 0);
+
+    while (level < RPG_MAX_LEVEL && xp >= jkRpg_XpForLevel(level + 1)) {
+        level++;
+        sithInventory_SetInventory(p, RPG_BIN_LEVEL, level);
+        sithInventory_ChangeInventory(p, RPG_BIN_POINTS, 1);
+        sithInventory_ChangeInventory(p, RPG_BIN_MISSIONLVL, 1);
+        p->actorParams.health = p->actorParams.maxHealth;
+        jkRpg_numUndo = 0;
+        jkRpg_Print("LEVEL UP! Level %d", level);
+        // A boss death plays the game's own goal sound at the same moment; skip the fanfare there.
+        if (!jkRpg_BossXp(NULL))
+            jkRpg_PlaySound(RPG_SOUND_LEVELUP);
+    }
+    // Use the normal fading screen effect, once even when one award grants several levels.
+    if (level > startingLevel)
+        sithPlayer_AddDynamicTint(0.3, 0.25, 0.0);
+}
