+// ------------------------------------------------------------------------------------------------
+// Drawing. The layout is measured in units of a 640x480 screen; U() converts them to pixels.
+
+#define MENU_W 600          // panel width
+#define MENU_ROWS 4         // most branches on one page; the panel keeps this height on every page
+#define MENU_PAD 10         // inside the frame
+#define BAR_H 24            // title bar
+#define TABS_H 18
+#define HEAD_W 150          // branch heading column
+#define CHAIN_X 250         // centre of a branch's first upgrade
+#define CHAIN_STEP 130      // between upgrades
+#define SLOT 30             // upgrade picture with its frame
+
+static flex_t jkRpg_u = 1;
+#define U(v) ((int)((v) * jkRpg_u))
+#define PX(v) (U(v) > 0 ? U(v) : 1)
+
+static int jkRpg_LineH(int fontH) { return fontH + 4; }
+static int jkRpg_RowH(int fontH) { return SLOT + 10 + fontH + 6; }
+
+// Panel height in units for a font of this height.
+static int jkRpg_MenuH(int fontH)
+{
+    int line = jkRpg_LineH(fontH);
+    return 2 * MENU_PAD + BAR_H + 6 + TABS_H + 6 + MENU_ROWS * jkRpg_RowH(fontH) + 8
+        + line + 4 + RPG_MAX_RANK * (2 * line + 2) + 4 + 2 * line;
+}
+
+// Pixels per unit: the screen height's 480-line scale, kept inside 96% of the width and height.
+static flex_t jkRpg_MenuScale(int fontH)
+{
+    flex_t u = (flex_t)Video_format.height / 480.0;
+    flex_t fitW = (flex_t)Video_format.width * 0.96 / MENU_W;
+    flex_t fitH = (flex_t)Video_format.height * 0.96 / jkRpg_MenuH(fontH);
+    if (u > fitW) u = fitW;
+    if (u > fitH) u = fitH;
+    return u;
+}
+
+// A colourless copy of the HUD font's 16-bit glyph sheet for menu text out of reach, built once
+// per HUD session. The surface's transparent colour (and black) stay see-through, as the
+// renderer treats them. NULL (other formats):
+// text stays gold.
+static stdBitmap* jkRpg_pGrayFont;
+static stdBitmap* jkRpg_pGrayFontSource;
+
+static void jkRpg_FreeGrayFont(void)
+{
+    if (jkRpg_pGrayFont)
+        stdBitmap_Free(jkRpg_pGrayFont);
+    jkRpg_pGrayFont = NULL;
+    jkRpg_pGrayFontSource = NULL;
+}
+
+static stdBitmap* jkRpg_GrayFont(stdBitmap* source)
+{
+    if (source == jkRpg_pGrayFontSource)
+        return jkRpg_pGrayFont;
+    jkRpg_FreeGrayFont();
+    jkRpg_pGrayFontSource = source;
+    tVBuffer* from = source && source->mipSurfaces ? source->mipSurfaces[0] : NULL;
+    if (!from || from->format.format.bpp != 16 || !stdDisplay_VBufferLock(from))
+        return NULL;
+    const rdTexFormat* f = &from->format.format;
+    int w = from->format.width, h = from->format.height;
+    stdBitmap* gray = jkRpg_NewBitmap(w, h);
+    tVBuffer* to = gray ? gray->mipSurfaces[0] : NULL;
+    if (to && stdDisplay_VBufferLock(to)) {
+        for (int y = 0; y < h; y++)
+            for (int x = 0; x < w; x++) {
+                uint16_t p = ((uint16_t*)from->surface_lock_alloc)[y * (from->format.rowSize / 2) + x];
+                int r = ((p >> f->r_shift) & ((1 << f->r_bits) - 1)) << (8 - f->r_bits);
+                int g = ((p >> f->g_shift) & ((1 << f->g_bits) - 1)) << (8 - f->g_bits);
+                int b = ((p >> f->b_shift) & ((1 << f->b_bits) - 1)) << (8 - f->b_bits);
+                uint8_t rgb[3] = {(uint8_t)r, (uint8_t)g, (uint8_t)b};
+                ((uint16_t*)to->surface_lock_alloc)[y * (to->format.rowSize / 2) + x] =
+                    p != (uint16_t)from->transparent_color && (r | g | b) ? jkRpg_GrayPixel(jkRpg_Pixel(rgb)) : 0;
+            }
+        stdDisplay_VBufferUnlock(to);
+        jkRpg_pGrayFont = gray;
+    }
+    else if (gray)
+        stdBitmap_Free(gray);
+    stdDisplay_VBufferUnlock(from);
+    return jkRpg_pGrayFont;
+}
+
+// Text in the HUD's gold font, darkened by a tint for less important lines (colourless while
+// jkRpg_bGray is set). Returns its width; with draw 0 it only measures. Glyph lookup as in
+// stdFont_DrawAsciiGPU.
+static int jkRpg_TintText(stdFont* f, int x, int y, flex_t s, const char* str, uint8_t tint, int draw)
+{
+    stdBitmap* sheet = draw && jkRpg_bGray && jkRpg_GrayFont(f->pBitmap) ? jkRpg_pGrayFont : f->pBitmap;
+    int at = x;
+    for (; *str; str++) {
+        uint16_t ch = (uint8_t)*str;
+        int advance = f->marginX;
+        if (ch != ' ') {
+            stdFontCharset* set = &f->charsetHead;
+            while (set && (ch < set->charFirst || ch > set->charLast)) set = set->previous;
+            if (!set) {
+                ch = f->field_28;
+                set = &f->charsetHead;
+                while (set && (ch < set->charFirst || ch > set->charLast)) set = set->previous;
+            }
+            if (!set) continue;
+            stdFontEntry* e = &set->pEntries[ch - set->charFirst];
+            if (draw) {
+                rdRect src = {e->glyphTexX, 0, e->glyphWidth, stdFont_GetHeight(f)};
+                int shift = f->monospaceW && e->glyphWidth < f->monospaceW ? (f->monospaceW - e->glyphWidth) / 2 : 0;
+                std3D_DrawUIBitmapRGBA(sheet, 0, at + shift, y, &src, s, s, 1, tint, tint, tint, 255);
+            }
+            advance = e->glyphWidth + f->marginY;
+        }
+        if (advance < f->monospaceW) advance = f->monospaceW;
+        at += (int)(advance * s);
+    }
+    return at - x;
+}
+
+// Draws text at x (align 0), centred on x (1) or ending at x (2), shrunk to fit width if needed.
+static void jkRpg_MenuText(stdFont* f, int x, int y, int width, flex_t s, int align, uint8_t tint, const char* str)
+{
+    int w = jkRpg_TintText(f, 0, 0, s, str, 0, 0);
+    if (w > width && w > 0) {
+        s = s * width / w;
+        w = jkRpg_TintText(f, 0, 0, s, str, 0, 0);
+    }
+    jkRpg_TintText(f, align == 1 ? x - w / 2 : (align == 2 ? x - w : x), y, s, str, tint, 1);
+}
+
+static void jkRpg_Box(int x, int y, int w, int h, int t, uint8_t r, uint8_t g, uint8_t b)
+{
+    jkRpg_Rect(x, y, w, t, r, g, b, 255);
+    jkRpg_Rect(x, y + h - t, w, t, r, g, b, 255);
+    jkRpg_Rect(x, y + t, t, h - 2 * t, r, g, b, 255);
+    jkRpg_Rect(x + w - t, y + t, t, h - 2 * t, r, g, b, 255);
+}
+
+// Dark panel in the copper frame of the HUD gauges: dark rim, copper, a lit edge, inner shadow.
+static void jkRpg_DrawPanel(int x, int y, int w, int h)
+{
+    static const uint8_t rings[4][3] = {{30, 16, 8}, {150, 78, 34}, {214, 138, 72}, {40, 20, 10}};
+    int t = PX(1);
+    jkRpg_Rect(x, y, w, h, 12, 9, 7, 255);
+    if (jkRpg_DrawShippedFrame(x, y, w, h)) return; // the generated border, when installed
+    for (int i = 0; i < 4; i++)
+        jkRpg_Box(x + i * t, y + i * t, w - 2 * i * t, h - 2 * i * t, t, rings[i][0], rings[i][1], rings[i][2]);
+}
+
+// The rust title bar with stone end caps of the Force power screen.
+static void jkRpg_DrawBar(int x, int y, int w, int h)
+{
+    int t = PX(1), cap = PX(14), dot = PX(3);
+    jkRpg_Rect(x, y, w, h, 96, 42, 20, 255);
+    jkRpg_Rect(x, y, w, t, 158, 86, 46, 255);
+    jkRpg_Rect(x, y + h - t, w, t, 40, 17, 7, 255);
+    jkRpg_Rect(x, y + h / 2, w, h / 2 - t, 82, 35, 16, 255); // the lower half in shadow
+    for (int side = 0; side < 2; side++) {
+        int cx = side ? x + w - cap : x;
+        jkRpg_Rect(cx, y, cap, h, 150, 138, 116, 255);
+        jkRpg_Rect(side ? cx : cx + cap - t, y, t, h, 58, 50, 38, 255);
+        for (int j = 0; j < 3; j++)
+            for (int i = 0; i < 2; i++)
+                jkRpg_Rect(cx + U(2 + 6 * i) + (side ? t : 0), y + U(3) + (h - U(6)) * j / 3 + (i ? U(4) : 0),
+                           dot, dot, 96, 86, 68, 255);
+    }
+}
+
+// A small diamond marker, like the rank dots beside the Force powers.
+static void jkRpg_Diamond(int cx, int cy, int r, uint8_t red, uint8_t green, uint8_t blue)
+{
+    for (int i = -r; i <= r; i++) {
+        int half = r - (i < 0 ? -i : i);
+        jkRpg_Rect(cx - half, cy + i, 2 * half + 1, 1, red, green, blue, 255);
+    }
+}
+
+// Heading picture: the weapon model, the game's own item icon, or the branch's skill picture.
+static void jkRpg_DrawHeading(SithThing* p, int up, int cx, int top, int slot, flex_t tileScale)
+{
+    int size = (int)(TILE * tileScale), y = top + (slot - size) / 2;
+    if (jkRpg_aUpgrades[up].weapon) {
+        jkRpg_DrawWeaponIcon(jkRpg_aUpgrades[up].weapon, cx - slot, top, 2 * slot, slot);
+        return;
+    }
+    stdBitmap* icons[2] = {NULL, NULL};
+    if (up == UP_BACTA)
+        icons[0] = sithInventory_g_aTypes[SITHBIN_BACTATANK].hudBitmap;
+    if (up == UP_LIGHT) {
+        icons[0] = sithInventory_g_aTypes[SITHBIN_FIELDLIGHT].hudBitmap;
+    }
+    if (icons[0] && icons[0]->mipSurfaces && icons[0]->mipSurfaces[0]) {
+        int n = icons[1] && icons[1]->mipSurfaces && icons[1]->mipSurfaces[0] ? 2 : 1;
+        for (int i = 0; i < n; i++) {
+            flex_t s = (flex_t)size / icons[i]->mipSurfaces[0]->format.height;
+            std3D_DrawUIBitmap(icons[i], 0, cx - n * size / 2 - (n - 1) * U(2) + i * (size + U(4)), y, NULL, s, 1);
+        }
+        return;
+    }
+    jkRpg_DrawTile(up * TILES_PER_BRANCH, cx - size / 2, y, tileScale, 255);
+}
+
+// One branch: heading, then its three upgrades joined like the Force screen's power columns.
+static void jkRpg_DrawBranch(SithThing* p, stdFont* f, int up, int x, int y, flex_t tileScale)
+{
+    const jkRpgUpgrade* branch = &jkRpg_aUpgrades[up];
+    int nextTier = jkRpg_NextTier(p, up), canBuy = jkRpg_CanSpend(p, up), undoTier = jkRpg_UndoTier(up);
+    int locked = !undoTier && nextTier <= RPG_MAX_RANK && jkRpg_RaisedThisMission(p, up);
+    int size = (int)(TILE * tileScale), slot = U(SLOT), top = y + U(5);
+    int midY = top + slot / 2, labelY = top + slot + U(5);
+    uint32_t now = stdPlatform_GetTimeMsec();
+    int pulse = (int)(now % 1200) < 600 ? (int)(now % 600) : 600 - (int)(now % 600); // 0..600..0
+
+    jkRpg_DrawHeading(p, up, x + U(MENU_PAD + HEAD_W / 2), top, slot, tileScale);
+    jkRpg_MenuText(f, x + U(MENU_PAD + HEAD_W / 2), labelY, U(HEAD_W - 10), jkRpg_u, 1, 255, branch->name);
+
+    int prevRight = x + U(MENU_PAD + HEAD_W - 4);
+    for (int k = 0; k < RPG_MAX_RANK; k++) {
+        int cx = x + U(CHAIN_X + k * CHAIN_STEP), left = cx - slot / 2, ring = PX(2);
+        int owned = jkRpg_OwnsTier(p, up, k + 1), next = k + 1 == nextTier;
+        // Link from the previous step: bright once this upgrade is owned.
+        if (owned) jkRpg_Rect(prevRight, midY - PX(2) / 2, left - ring - U(3) - prevRight, PX(2), 240, 180, 40, 255);
+        else jkRpg_Rect(prevRight, midY, left - ring - U(3) - prevRight, PX(1), 96, 66, 22, 255);
+        prevRight = left + slot + ring + U(3);
+
+        // Only upgrades the player has or can buy right now get a coloured frame; locked,
+        // unaffordable and later upgrades have none, so they read as out of reach.
+        int framed = owned || (next && canBuy);
+        uint8_t r = 0, g = 0, b = 0, bright = 150; // later
+        if (owned) {
+            r = 240; g = 180; b = 40; bright = 255;
+            if (k + 1 == undoTier) { r = 255; g = 236; b = 150; } // can still be taken back
+        }
+        else if (next && canBuy) { // pulse between dark and pale gold
+            r = 120 + 135 * pulse / 600; g = 90 + 146 * pulse / 600; b = 30 + 120 * pulse / 600; bright = 255;
+        }
+        else if (next)
+            bright = locked ? 130 : 220;
+        if (framed)
+            jkRpg_Rect(left - ring, top - ring, slot + 2 * ring, slot + 2 * ring, r, g, b, 255);
+        jkRpg_Rect(left, top, slot, slot, 0, 0, 0, 255);
+        int tx = left + (slot - size) / 2, ty = top + (slot - size) / 2;
+        jkRpg_bGray = !framed; // out of reach: colourless, equally dim picture and name
+        jkRpg_DrawTile(up * TILES_PER_BRANCH + 1 + k, tx, ty, tileScale, framed ? bright : RPG_GRAY_TILE);
+        if (next && locked)
+            jkRpg_DrawTile(TILE_LOCK, tx, ty, tileScale, 255);
+        jkRpg_MenuText(f, cx, labelY, U(CHAIN_STEP - 8), jkRpg_u, 1, framed ? 255 : RPG_GRAY_TEXT, branch->nodes[k].name);
+        jkRpg_bGray = 0;
+    }
+}
+
+void jkRpg_DrawMenu(SithThing* p, stdFont* pFont)
+{
+    jkRpg_FixSelection(p);
+    int fontH = stdFont_GetHeight(pFont);
+    jkRpg_u = jkRpg_MenuScale(fontH);
+    // Pictures fill their frame; below double size they stay at whole pixels (1x) so 4:3 stays crisp.
+    flex_t u = jkRpg_u, tileScale = (flex_t)U(SLOT - 4) / TILE;
+    if (tileScale < 2) tileScale = tileScale >= 1 ? 1 : tileScale;
+    int line = U(jkRpg_LineH(fontH));
+    int w = U(MENU_W), h = U(jkRpg_MenuH(fontH));
+    int x = (Video_format.width - w) / 2, y = (Video_format.height - h) / 2;
+    int inner = w - 2 * U(MENU_PAD);
+    char tmp[192];
+
+    jkRpg_DrawPanel(x, y, w, h);
+
+    // Title bar: name on the left, progress on the right.
+    int barX = x + U(MENU_PAD), barY = y + U(MENU_PAD), barH = U(BAR_H);
+    int capW = jkRpg_DrawShippedBar(barX, barY, inner, barH);
+    if (!capW) {
+        capW = PX(14);
+        jkRpg_DrawBar(barX, barY, inner, barH);
+    }
+    flex_t titleScale = u * 1.5;
+    jkRpg_MenuText(pFont, barX + capW + U(8), barY + (barH - (int)(fontH * titleScale)) / 2, inner / 3, titleScale, 0, 255, "UPGRADES");
+    int level = jkRpg_Level(p);
+    if (level < jkRpg_MaxLevel())
+        stdString_snprintf(tmp, sizeof(tmp), "Level %d    XP %d / %d    Points %d", level, jkRpg_Xp(p), jkRpg_XpForLevel(level + 1), jkRpg_Points(p));
+    else
+        stdString_snprintf(tmp, sizeof(tmp), "Level %d    Points %d", level, jkRpg_Points(p));
+    jkRpg_MenuText(pFont, barX + inner - capW - U(8), barY + (barH - U(fontH)) / 2, inner / 2, u, 2, 255, tmp);
+
+    // Category tabs: only pages with something discovered.
+    int tabsY = barY + barH + U(6), tabsW = 0, gap = U(26);
+    for (int page = 0; page < PAGE_COUNT; page++)
+        if (jkRpg_PageShown(p, page))
+            tabsW += jkRpg_TintText(pFont, 0, 0, u, jkRpg_aPageNames[page], 0, 0) + gap;
+    int tx = x + (w - (tabsW - gap)) / 2;
+    for (int page = 0; page < PAGE_COUNT; page++) {
+        if (!jkRpg_PageShown(p, page)) continue;
+        int tw = jkRpg_TintText(pFont, 0, 0, u, jkRpg_aPageNames[page], 0, 0);
+        int sel = page == jkRpg_menuPage;
+        jkRpg_TintText(pFont, tx, tabsY + U(2), u, jkRpg_aPageNames[page], sel ? 255 : 125, 1);
+        if (sel) {
+            jkRpg_Rect(tx - U(4), tabsY + U(4) + U(fontH), tw + U(8), PX(2), 240, 180, 40, 255);
+            jkRpg_Diamond(tx - U(10), tabsY + U(2) + U(fontH) / 2, PX(3), 240, 180, 40);
+            jkRpg_Diamond(tx + tw + U(10), tabsY + U(2) + U(fontH) / 2, PX(3), 240, 180, 40);
+        }
+        tx += tw + gap;
+    }
+    jkRpg_Rect(x + U(MENU_PAD), tabsY + U(TABS_H) + U(2), inner, PX(1), 110, 58, 26, 255);
+
+    // Branches of this page.
+    int rowH = U(jkRpg_RowH(fontH)), rowY = tabsY + U(TABS_H) + U(6);
+    for (int up = 0, row = 0; up < UP_COUNT; up++) {
+        if (jkRpg_aUpgrades[up].page != jkRpg_menuPage || !jkRpg_IsFound(p, up)) continue;
+        int ry = rowY + row++ * rowH;
+        if (up == jkRpg_menuSel) {
+            jkRpg_Rect(x + U(MENU_PAD - 1), ry, w - U(2 * MENU_PAD - 2), rowH - U(3), 58, 38, 12, 255); // inside the border
+            jkRpg_Box(x + U(MENU_PAD - 1), ry, w - U(2 * MENU_PAD - 2), rowH - U(3), PX(1), 240, 180, 40);
+        }
+        jkRpg_DrawBranch(p, pFont, up, x, ry, tileScale);
+    }
+
+    // The selected branch: every upgrade described; an upgrade waiting for the next mission says so.
+    const jkRpgUpgrade* sel = &jkRpg_aUpgrades[jkRpg_menuSel];
+    int nextTier = jkRpg_NextTier(p, jkRpg_menuSel), waiting = jkRpg_RaisedThisMission(p, jkRpg_menuSel);
+    int canBuy = jkRpg_CanSpend(p, jkRpg_menuSel);
+    int dy = rowY + MENU_ROWS * rowH + U(2);
+    int lx = x + U(MENU_PAD + 6), textX = lx + U(16), textW = x + w - U(MENU_PAD + 6) - textX;
+    jkRpg_Rect(x + U(MENU_PAD), dy, inner, PX(1), 110, 58, 26, 255);
+    dy += U(6);
+    jkRpg_MenuText(pFont, lx, dy, inner - U(12), u, 0, 255, sel->name);
+    dy += line + U(4);
+    for (int k = 0; k < RPG_MAX_RANK; k++) {
+        int owned = jkRpg_OwnsTier(p, jkRpg_menuSel, k + 1), next = k + 1 == nextTier;
+        int mx = lx + U(5), my = dy + U(fontH) / 2;
+        if (owned) jkRpg_Diamond(mx, my, PX(4), 240, 180, 40);
+        else {
+            jkRpg_Diamond(mx, my, PX(4), next ? 255 : 90, next ? 236 : 66, next ? 150 : 22);
+            jkRpg_Diamond(mx, my, PX(4) - PX(1) > 0 ? PX(4) - PX(1) : 1, 12, 9, 7);
+        }
+        const char* state = owned ? "Owned" : (next ? (waiting ? "Next mission" : "Next") : "Later");
+        int stateW = jkRpg_TintText(pFont, 0, 0, u, state, 0, 0);
+        jkRpg_bGray = !owned && !(next && canBuy); // the same upgrades as in the chains above
+        jkRpg_MenuText(pFont, x + w - U(MENU_PAD + 6), dy, stateW, u, 2, jkRpg_bGray ? RPG_GRAY_TEXT : 200, state);
+        jkRpg_MenuText(pFont, textX, dy, textW - stateW - U(10), u, 0, jkRpg_bGray ? RPG_GRAY_TEXT : 255, sel->nodes[k].name);
+        jkRpg_MenuText(pFont, textX, dy + line, textW, u, 0, jkRpg_bGray ? RPG_GRAY_TEXT : 215, sel->nodes[k].desc);
+        jkRpg_bGray = 0;
+        dy += 2 * line + U(2);
+    }
+    dy += U(4);
+    jkRpg_Rect(x + U(MENU_PAD), dy + line / 2, inner, PX(1), 110, 58, 26, 255); // above the key help
+    dy += line;
+    const char* key = jkRpg_MenuKeyName();
+    if (stdControl_bHasPhysicalJoystick)
+        stdString_snprintf(tmp, sizeof(tmp), "D-pad/stick: choose/page    A: buy or take back    B/Back: close");
+    else stdString_snprintf(tmp, sizeof(tmp), "Up/Down or W/S: choose    Left/Right, A/D or Q/E: page    Enter: buy or take back    %s%s",
+                       key ? key : "Bind Upgrade Menu in Setup", key ? ": close" : " to close");
+    jkRpg_MenuText(pFont, x + w / 2, dy, inner, u, 1, 140, tmp);
+}
+
+// ------------------------------------------------------------------------------------------------
+// Level plate: a wide gunmetal nameplate centred on top of the left HUD gauge, held by copper
+// straps like the gauge's own chain links, with "LEVEL n" in large gold letters. While points wait,
+// the same window shows a pulsing gold arrow and "PRESS <menu key>" ("SETUP" when unbound) instead.
+//
+// The plate is painted once into textures at the screen's own resolution for the current HUD
+// size: shapes are measured in gauge-bitmap pixels (statusleft is 59x60) and shaded like the
+// gauge's steel ring and copper links. The letters are resampled from the HUD message font
+// (msgFont16.sft) loaded from the player's installation; no game art is shipped.
+
+#define PLATE_X 1.5f        // main plate's top left corner, in gauge pixels from the gauge's
+#define PLATE_Y (-8.5f)     // top left; centred over the ring, resting on the gauge's top link
+#define PLATE_W 54.0f
+#define PLATE_H 12.4f
+#define PLATE_ART_H PLATE_H // the original gauge chain remains visible below
+#define TEXT_CAP 5.4f       // letter height in the windows
+#define ARROW_W 5.0f
+#define TEXT_TRACK 0.7f    // extra space between letters
+
+typedef struct { float* px; int w, h; float s; } jkRpgCanvas; // straight RGBA, 0-1
+
+static stdFont* jkRpg_pPlateFont;   // msgFont16.sft, kept unconverted for painting
+static int jkRpg_bPlateFontFailed;
+static stdBitmap* jkRpg_pPlate;     // "LEVEL n", or the menu key while points wait
+static stdBitmap* jkRpg_pArrow;     // the waiting-points arrow, drawn with a pulsing tint
+static char jkRpg_plateText[64];
+static flex_t jkRpg_plateScale, jkRpg_arrowScale;
+static float jkRpg_plateArrowX;     // where the arrow goes in the window, in gauge pixels
+
+static float jkRpg_Clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
+
+// A small repeatable grain, per gauge pixel like the HUD art's dither.
+static float jkRpg_Grain(int x, int y)
+{
+    uint32_t h = (uint32_t)(x * 374761393 + y * 668265263);
+    h = (h ^ (h >> 13)) * 1274126177;
+    return ((h >> 24) & 255) / 255.0f - 0.5f;
+}
+
+static void jkRpg_Blend(jkRpgCanvas* c, int x, int y, float r, float g, float b, float a)
+{
+    if (x < 0 || y < 0 || x >= c->w || y >= c->h || a <= 0) return;
+    float* d = &c->px[(y * c->w + x) * 4];
+    float out = a + d[3] * (1 - a);
+    for (int i = 0; i < 3; i++) {
+        float src = jkRpg_Clamp01(i == 0 ? r : (i == 1 ? g : b));
+        d[i] = out > 0 ? (src * a + d[i] * d[3] * (1 - a)) / out : 0;
+    }
+    d[3] = out;
+}
+
+// Signed distance (gauge pixels, negative inside) to a plate: a bar whose ends are chamfered into
+// short rivet tabs.
+static float jkRpg_PlateDist(float x, float y, float w, float h)
+{
+    float cx = w / 2, cy = h / 2, dx = fabsf(x - cx), dy = fabsf(y - cy);
+    float side = dx - cx, top = dy - cy;
+    float chamfer = (dx - (cx - 4.2f)) * 0.606f + (dy - cy) * 0.795f; // cut from the top edge to the tab
+    float d = side > top ? side : top;
+    return chamfer > d ? chamfer : d;
+}
+
+static float jkRpg_RoundRectDist(float x, float y, float x0, float y0, float x1, float y1, float r)
+{
+    float qx = fabsf(x - (x0 + x1) / 2) - ((x1 - x0) / 2 - r), qy = fabsf(y - (y0 + y1) / 2) - ((y1 - y0) / 2 - r);
+    float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+    return sqrtf(ox * ox + oy * oy) + (qx > qy ? (qx < 0 ? qx : 0) : (qy < 0 ? qy : 0)) - r;
+}
+
+// Fraction of a texel inside a shape, from 4x4 samples, so edges are smooth.
+#define JKRPG_COVER(c, X, Y, EXPR, OUT) do { int n_ = 0; \
+    for (int j_ = 0; j_ < 4; j_++) for (int i_ = 0; i_ < 4; i_++) { \
+        float sx = ((X) + (i_ + 0.5f) / 4) / (c)->s, sy = ((Y) + (j_ + 0.5f) / 4) / (c)->s; \
+        if ((EXPR) < 0) n_++; } \
+    (OUT) = n_ / 16.0f; } while (0)
+
+// A domed steel rivet in its socket.
+static void jkRpg_PaintRivet(jkRpgCanvas* c, float cx, float cy, float r, int copper)
+{
+    for (int y = (int)((cy - r - 1) * c->s); y <= (int)((cy + r + 1) * c->s); y++)
+        for (int x = (int)((cx - r - 1) * c->s); x <= (int)((cx + r + 1) * c->s); x++) {
+            float px = (x + 0.5f) / c->s - cx, py = (y + 0.5f) / c->s - cy, dist = sqrtf(px * px + py * py);
+            float cover;
+            JKRPG_COVER(c, x, y, sqrtf((sx - cx) * (sx - cx) + (sy - cy) * (sy - cy)) - (r + 0.45f), cover);
+            if (dist > r) { // dark socket ring around the head
+                jkRpg_Blend(c, x, y, 0.06f, 0.06f, 0.07f, cover * 0.85f);
+                continue;
+            }
+            float nx = px / r, ny = py / r, nz = sqrtf(1 - nx * nx - ny * ny > 0 ? 1 - nx * nx - ny * ny : 0);
+            float diff = jkRpg_Clamp01(-0.45f * nx - 0.6f * ny + 0.66f * nz);
+            float spec = powf(jkRpg_Clamp01(-0.24f * nx - 0.32f * ny + 0.92f * nz), 24);
+            float base[3] = {0.40f, 0.41f, 0.42f}, tone[3] = {1.0f, 1.0f, 1.0f};
+            if (copper) { base[0] = 0.56f; base[1] = 0.29f; base[2] = 0.14f; tone[0] = 1.0f; tone[1] = 0.85f; tone[2] = 0.65f; }
+            float k = 0.25f + 1.05f * diff, edge = dist > r * 0.8f ? 0.65f : 1.0f;
+            jkRpg_Blend(c, x, y, jkRpg_Clamp01((base[0] * k + spec * tone[0]) * edge), jkRpg_Clamp01((base[1] * k + spec * tone[1]) * edge),
+                        jkRpg_Clamp01((base[2] * k + spec * tone[2]) * edge), 1);
+        }
+}
+
+// The gunmetal frame with an outer bevel lit from the upper left, a black window recessed into
+// it, and rivets in the end tabs (left, right or both).
+static void jkRpg_PaintPlate(jkRpgCanvas* c, float x0, float w, float h, int rivets)
+{
+    const float lx = -0.6f, ly = -0.8f, wx0 = x0 + 5.2f, wx1 = x0 + w - 5.2f, wy0 = 2.5f, wy1 = h - 2.5f;
+    for (int y = 0; y < (int)(h * c->s) + 1; y++)
+        for (int x = (int)(x0 * c->s); x < (int)((x0 + w) * c->s) + 1; x++) {
+            float gx = (x + 0.5f) / c->s, gy = (y + 0.5f) / c->s, cover;
+            JKRPG_COVER(c, x, y, jkRpg_PlateDist(sx - x0, sy, w, h), cover);
+            if (cover <= 0) continue;
+            float d = jkRpg_PlateDist(gx - x0, gy, w, h);
+            float dw = jkRpg_RoundRectDist(gx, gy, wx0, wy0, wx1, wy1, 1.4f);
+            const float e = 0.05f;
+            float v;
+            if (dw < 0) { // the window: black, a little shadow under its top lip
+                v = 0.035f + (dw > -1.0f && gy < (wy0 + wy1) / 2 ? 0 : 0.02f);
+                jkRpg_Blend(c, x, y, v, v, v * 1.15f, cover);
+                continue;
+            }
+            // Gunmetal: light at the top, darker below, with the HUD's per-pixel grain.
+            v = 0.46f - 0.18f * gy / h + jkRpg_Grain((int)(gx * 2), (int)(gy * 2)) * 0.06f;
+            if (d > -1.3f) { // outer bevel, facing outwards
+                float nx = (jkRpg_PlateDist(gx - x0 + e, gy, w, h) - d) / e, ny = (jkRpg_PlateDist(gx - x0, gy + e, w, h) - d) / e;
+                float lit = nx * lx + ny * ly;
+                v += 0.30f * lit;
+                if (lit > 0.75f && d > -0.9f) v += 0.18f; // bright edge
+            }
+            if (dw < 1.2f) { // inner bevel, sloping down into the window
+                float nx = (jkRpg_RoundRectDist(gx + e, gy, wx0, wy0, wx1, wy1, 1.4f) - dw) / e;
+                float ny = (jkRpg_RoundRectDist(gx, gy + e, wx0, wy0, wx1, wy1, 1.4f) - dw) / e;
+                v += 0.30f * (-nx * lx - ny * ly);
+                if (dw < 0.35f) v *= 0.35f; // the window's lip
+            }
+            if (d > -0.35f) v *= 0.35f; // dark outline
+            v = jkRpg_Clamp01(v);
+            jkRpg_Blend(c, x, y, v, v * 1.02f, v * 1.08f, cover);
+        }
+    float ry = h / 2, r = 1.45f;
+    if (rivets & 1) jkRpg_PaintRivet(c, x0 + 2.25f, ry, r, 0);
+    if (rivets & 2) jkRpg_PaintRivet(c, x0 + w - 2.25f, ry, r, 0);
+}
+
+// The HUD message font, unconverted: glyph pixels and the transparent key colour.
+static stdFont* jkRpg_PlateFont(void)
+{
+    if (!jkRpg_pPlateFont && !jkRpg_bPlateFontFailed) {
+        jkRpg_pPlateFont = stdFont_Load("ui\\sft\\msgFont16.sft", 0, 0);
+        stdBitmap* b = jkRpg_pPlateFont ? jkRpg_pPlateFont->pBitmap : NULL;
+        if (!b || !b->mipSurfaces || !b->mipSurfaces[0] || b->format.bpp != 16) {
+            if (jkRpg_pPlateFont) stdFont_Free(jkRpg_pPlateFont);
+            jkRpg_pPlateFont = NULL;
+            jkRpg_bPlateFontFailed = 1;
+        }
+    }
+    return jkRpg_pPlateFont;
+}
+
+static stdFontEntry* jkRpg_Glyph(stdFont* f, int ch)
+{
+    for (stdFontCharset* set = &f->charsetHead; set; set = set->previous)
+        if (ch >= set->charFirst && ch <= set->charLast)
+            return &set->pEntries[ch - set->charFirst];
+    return NULL;
+}
+
+// Width in gauge pixels of text whose capitals are cap pixels tall (they fill the font's top 9.5 rows).
+static float jkRpg_PlateTextW(stdFont* f, const char* str, float cap)
+{
+    float scale = cap / 9.5f, w = 0;
+    for (; *str; str++) {
+        stdFontEntry* e = *str == ' ' ? NULL : jkRpg_Glyph(f, (uint8_t)*str);
+        w += (e ? e->glyphWidth + f->marginY : f->marginX) * scale + TEXT_TRACK;
+    }
+    return w;
+}
+
+// Letters resampled from the message font: gold from top to bottom, the font's own dark shading
+// kept as orange-brown, and a dark outline so they read on the black window.
+static void jkRpg_PaintText(jkRpgCanvas* c, stdFont* f, const char* str, float x, float top, float cap)
+{
+    stdBitmap* b = f->pBitmap;
+    tVBuffer* v = b->mipSurfaces[0];
+    if (!stdDisplay_VBufferLock(v)) return;
+    const rdTexFormat* fmt = &b->format;
+    int rows = v->format.height, len = (int)strlen(str);
+    float scale = cap / 9.5f, h = rows * scale;
+    float* mask = (float*)calloc((size_t)c->w * c->h, sizeof(float));
+    float* gold = (float*)calloc((size_t)c->w * c->h * 3, sizeof(float));
+    if (mask && gold) {
+        float at = x;
+        for (int i = 0; i < len; i++) {
+            stdFontEntry* e = str[i] == ' ' ? NULL : jkRpg_Glyph(f, (uint8_t)str[i]);
+            if (!e) { at += f->marginX * scale + TEXT_TRACK; continue; }
+            for (int ty = (int)(top * c->s); ty < (int)((top + h) * c->s) + 1 && ty < c->h; ty++)
+                for (int tx = (int)(at * c->s); tx < (int)((at + e->glyphWidth * scale) * c->s) + 1 && tx < c->w; tx++) {
+                    float cover = 0, rgb[3] = {0, 0, 0};
+                    for (int n = 0; n < 16; n++) {
+                        float fx = (((tx + (n % 4 + 0.5f) / 4) / c->s) - at) / scale;
+                        float fy = (((ty + (n / 4 + 0.5f) / 4) / c->s) - top) / scale;
+                        int sx = (int)fx, sy = (int)fy;
+                        if (fx < 0 || fy < 0 || sx >= e->glyphWidth || sy >= rows || tx < 0 || ty < 0) continue;
+                        uint16_t p = ((uint16_t*)((uint8_t*)v->surface_lock_alloc + sy * v->format.rowSize))[e->glyphTexX + sx];
+                        if ((b->palFmt & 1) && p == b->colorkey) continue;
+                        int g = (p >> fmt->g_shift) & ((1 << fmt->g_bits) - 1), gmax = (1 << fmt->g_bits) - 1;
+                        float t = jkRpg_Clamp01(sy / (float)rows);
+                        if (gmax > 0 && g * 2 > gmax) { rgb[0] += 1.0f; rgb[1] += 0.92f - 0.36f * t; rgb[2] += 0.22f - 0.20f * t; }
+                        else { rgb[0] += 0.88f; rgb[1] += 0.50f; rgb[2] += 0.04f; } // the font's own shading
+                        cover += 1;
+                    }
+                    if (!cover) continue;
+                    int k = ty * c->w + tx;
+                    mask[k] = cover / 16;
+                    for (int j = 0; j < 3; j++) gold[k * 3 + j] = rgb[j] / cover;
+                }
+            at += (e->glyphWidth + f->marginY) * scale + TEXT_TRACK;
+        }
+        int reach = (int)(c->s * 0.6f + 0.5f); // outline thickness: about half a gauge pixel
+        if (reach < 1) reach = 1;
+        for (int y = 0; y < c->h; y++)
+            for (int x = 0; x < c->w; x++) {
+                float nearest = 0;
+                for (int j = -reach; j <= reach; j++)
+                    for (int i = -reach; i <= reach; i++)
+                        if (y + j >= 0 && y + j < c->h && x + i >= 0 && x + i < c->w && mask[(y + j) * c->w + x + i] > nearest)
+                            nearest = mask[(y + j) * c->w + x + i];
+                if (nearest > 0) jkRpg_Blend(c, x, y, 0.10f, 0.04f, 0.01f, nearest);
+                int k = y * c->w + x;
+                if (mask[k] > 0) jkRpg_Blend(c, x, y, gold[k * 3], gold[k * 3 + 1], gold[k * 3 + 2], mask[k]);
+            }
+    }
+    free(mask);
+    free(gold);
+    stdDisplay_VBufferUnlock(v);
+}
+
+// The waiting-points arrow: gold, bevelled, painted beside the plate and drawn with a pulsing tint.
+static void jkRpg_PaintArrow(jkRpgCanvas* c, float x0, float y0, float w, float h)
+{
+    for (int y = (int)(y0 * c->s); y < (int)((y0 + h) * c->s) + 1; y++)
+        for (int x = (int)(x0 * c->s); x < (int)((x0 + w) * c->s) + 1; x++) {
+            float gx = (x + 0.5f) / c->s - x0, gy = (y + 0.5f) / c->s - y0, cover;
+#define JKRPG_ARROW(px, py) (fmaxf(fmaxf(fabsf((px) - w / 2) - (py) * w / (h * 1.1f), (py) - h * 0.55f), -(py)) < 0 \
+    || (fabsf((px) - w / 2) < w * 0.2f && (py) < h && (py) >= 0) ? -1.0f : 1.0f)
+            JKRPG_COVER(c, x, y, JKRPG_ARROW(sx - x0, sy - y0), cover);
+            if (cover <= 0) continue;
+            float lit = gx < w / 2 ? 1.0f : 0.78f, t = gy / h;
+            jkRpg_Blend(c, x, y, 1.0f * lit, (0.92f - 0.35f * t) * lit, (0.45f - 0.35f * t) * lit, cover);
+        }
+}
+
+static stdBitmap* jkRpg_CanvasBitmap(jkRpgCanvas* c)
+{
+    stdBitmap* b = jkRpg_NewBitmap(c->w, c->h);
+    tVBuffer* v = b ? b->mipSurfaces[0] : NULL;
+    if (!v || !stdDisplay_VBufferLock(v)) {
+        if (b) stdBitmap_Free(b);
+        return NULL;
+    }
+    for (int y = 0; y < c->h; y++) {
+        uint16_t* row = (uint16_t*)((uint8_t*)v->surface_lock_alloc + y * v->format.rowSize);
+        for (int x = 0; x < c->w; x++) {
+            float* p = &c->px[(y * c->w + x) * 4];
+            // One-bit alpha: half-covered edge texels keep their colour darkened against the scene.
+            uint8_t rgb[3] = {(uint8_t)(255 * p[0] * (p[3] < 1 ? p[3] : 1)), (uint8_t)(255 * p[1] * (p[3] < 1 ? p[3] : 1)),
+                              (uint8_t)(255 * p[2] * (p[3] < 1 ? p[3] : 1))};
+            row[x] = p[3] >= 0.5f ? jkRpg_Pixel(rgb) : 0;
+        }
+    }
+    stdDisplay_VBufferUnlock(v);
+    return b;
+}
+
+// The game's HUD art is low resolution, enlarged with square pixels. Average each block of one
+// gauge pixel (`block` screen pixels) so painted HUD art has the same coarse grain.
+static void jkRpg_Pixelate(jkRpgCanvas* c, float block)
+{
+    if (block <= 1.0f) return;
+    for (int by = 0; (int)(by * block) < c->h; by++) {
+        int y0 = (int)(by * block), y1 = (int)((by + 1) * block);
+        if (y1 > c->h) y1 = c->h;
+        for (int bx = 0; (int)(bx * block) < c->w; bx++) {
+            int x0 = (int)(bx * block), x1 = (int)((bx + 1) * block);
+            if (x1 > c->w) x1 = c->w;
+            float acc[4] = {0, 0, 0, 0};
+            for (int y = y0; y < y1; y++)
+                for (int x = x0; x < x1; x++) {
+                    const float* q = &c->px[((size_t)y * c->w + x) * 4];
+                    for (int k = 0; k < 3; k++) acc[k] += q[k] * q[3];
+                    acc[3] += q[3];
+                }
+            int n = (x1 - x0) * (y1 - y0);
+            if (n <= 0) continue;
+            for (int y = y0; y < y1; y++)
+                for (int x = x0; x < x1; x++) {
+                    float* q = &c->px[((size_t)y * c->w + x) * 4];
+                    for (int k = 0; k < 3; k++) q[k] = acc[3] > 0 ? acc[k] / acc[3] : 0;
+                    q[3] = acc[3] / n;
+                }
+        }
+    }
+}
+
+static int jkRpg_NewCanvas(jkRpgCanvas* c, float w, float h, flex_t s)
+{
+    c->s = (float)s;
+    c->w = (int)(w * s + 1);
+    c->h = (int)(h * s + 1);
+    c->px = (float*)calloc((size_t)c->w * c->h * 4, sizeof(float));
+    return c->px != NULL;
+}
+
+static void jkRpg_FreeLevelBadge(void)
+{
+    if (jkRpg_pPlate) stdBitmap_Free(jkRpg_pPlate);
+    if (jkRpg_pArrow) stdBitmap_Free(jkRpg_pArrow);
+    if (jkRpg_pPlateFont) stdFont_Free(jkRpg_pPlateFont);
+    jkRpg_pPlate = jkRpg_pArrow = NULL;
+    jkRpg_pPlateFont = NULL;
+    jkRpg_bPlateFontFailed = 0;
+    jkRpg_plateText[0] = 0;
+}
+
+// The plate with its text; repainted when the text or the HUD size changes. With `arrow`, the text
+// moves right to leave room for the arrow, and long key names get smaller letters.
+static stdBitmap* jkRpg_LevelPlate(const char* text, int arrow, flex_t s)
+{
+    if (jkRpg_pPlate && !strcmp(jkRpg_plateText, text) && jkRpg_plateScale == s)
+        return jkRpg_pPlate;
+    if (jkRpg_pPlate) stdBitmap_Free(jkRpg_pPlate);
+    jkRpg_pPlate = NULL;
+    stdString_snprintf(jkRpg_plateText, sizeof(jkRpg_plateText), "%s", text);
+    jkRpg_plateScale = s;
+    jkRpgCanvas c;
+    if (!jkRpg_NewCanvas(&c, PLATE_W, PLATE_ART_H, s)) return NULL;
+    jkRpg_PaintPlate(&c, 0, PLATE_W, PLATE_H, 3);
+    stdFont* f = jkRpg_PlateFont();
+    if (f) {
+        float gap = arrow ? ARROW_W + 1.5f : 0, room = PLATE_W - 11.0f - gap, cap = TEXT_CAP; // inset five gauge pixels at either side
+        float tw = jkRpg_PlateTextW(f, text, cap);
+        while (tw > room && cap > 2.5f) {
+            cap *= 0.94f;
+            tw = jkRpg_PlateTextW(f, text, cap);
+        }
+        float x = (PLATE_W - tw - gap) / 2;
+        jkRpg_plateArrowX = x;
+        jkRpg_PaintText(&c, f, text, x + gap, (PLATE_H - cap) / 2, cap);
+    }
+    jkRpg_Pixelate(&c, (float)jkPlayer_hudScale);
+    jkRpg_pPlate = jkRpg_CanvasBitmap(&c);
+    free(c.px);
+    return jkRpg_pPlate;
+}
+
+static stdBitmap* jkRpg_ArrowSprite(flex_t s)
+{
+    if (jkRpg_pArrow && jkRpg_arrowScale == s)
+        return jkRpg_pArrow;
+    if (jkRpg_pArrow) stdBitmap_Free(jkRpg_pArrow);
+    jkRpg_pArrow = NULL;
+    jkRpg_arrowScale = s;
+    jkRpgCanvas c;
+    if (!jkRpg_NewCanvas(&c, ARROW_W + 1, PLATE_H, s)) return NULL;
+    jkRpg_PaintArrow(&c, 0.5f, (PLATE_H - 6.0f) / 2, ARROW_W, 6.0f);
+    jkRpg_Pixelate(&c, (float)jkPlayer_hudScale);
+    jkRpg_pArrow = jkRpg_CanvasBitmap(&c);
+    free(c.px);
+    return jkRpg_pArrow;
+}
+
+static stdBitmap* jkRpg_ShippedPlate(const char* text, int arrow, flex_t s);
+
+void jkRpg_DrawLevelBadge(SithThing* p, stdFont* pFont, int gaugeX, int gaugeY)
+{
+    flex_t s = jkPlayer_hudScale;
+    float x = gaugeX + PLATE_X * s, y = gaugeY + PLATE_Y * s;
+    int points = jkRpg_Points(p) > 0 && jkRpg_CanBuyAny(p); // waiting points that can be spent now
+    const char* key = jkRpg_MenuKeyName();
+    char text[80];
+    if (points <= 0) stdString_snprintf(text, sizeof(text), "LEVEL %d", jkRpg_Level(p));
+    else if (key) stdString_snprintf(text, sizeof(text), "PRESS %s", key);
+    else stdString_snprintf(text, sizeof(text), "SETUP"); // unbound: the binding is made in Setup
+    stdBitmap* artPlate = jkRpg_ShippedPlate(text, points > 0, s); // generated plate, the game's menu lettering
+    if (artPlate)
+        std3D_DrawUIBitmapRGBA(artPlate, 0, x, y, NULL, 1, 1, 1, 255, 255, 255, 255);
+    stdBitmap* plate = artPlate ? artPlate : jkRpg_LevelPlate(text, points > 0, s);
+    if (plate && plate != artPlate)
+        std3D_DrawUIBitmapRGBA(plate, 0, x, y, NULL, 1, 1, 1, 255, 255, 255, 255);
+    if (plate != artPlate && (!jkRpg_PlateFont() || !plate)) { // without the font file (or memory): plain HUD text in the plate's place
+        if (pFont) jkRpg_MenuText(pFont, (int)(x + 6 * s), (int)(y + 3 * s), Video_format.width - (int)(x + 6 * s) - (int)(64 * s), s * 0.6f, 0, 255, text);
+        return;
+    }
+    if (points <= 0) return;
+    stdBitmap* arrow = jkRpg_ArrowSprite(s);
+    if (!arrow) return;
+    // The arrow pulses between dim and full gold.
+    uint32_t now = stdPlatform_GetTimeMsec();
+    int pulse = (int)(now % 1600) < 800 ? (int)(now % 800) : 800 - (int)(now % 800); // 0..800..0
+    uint8_t glow = (uint8_t)(140 + 115 * pulse / 800);
+    std3D_DrawUIBitmapRGBA(arrow, 0, x + jkRpg_plateArrowX * s, y, NULL, 1, 1, 1, glow, glow, glow, 255);
+}
+
+// ------------------------------------------------------------------------------------------------
+// Generated art shipped with the mod in the game's rpg\art folder (see docs/UPGRADE-ART.md):
+// upgrades.bmp  24x24 pictures in tile order (magenta: none, keep the drawn picture)
+// plate.bmp     the blank level plate at 4 texels per gauge pixel
+// frame.bmp     the menu border, cut into corners and edges and stretched to the panel
+// titlebar.bmp  the title bar, stretched between its two end caps
+// weapons.bmp   192x96 transparent weapon pictures, five columns by two rows
+// bacta.bmp / force.bmp: the two inner HUD panels at 4 texels per gauge pixel
+// Each is optional: a missing or unreadable file keeps the drawn version. They are uncompressed
+// 24-bit BMPs, read here directly; magenta (255, 0, 255) is transparent.
+
+enum { ARTFILE_UPGRADES, ARTFILE_PLATE, ARTFILE_FRAME, ARTFILE_BAR, ARTFILE_WEAPONS, ARTFILE_BACTA, ARTFILE_FORCE, ARTFILE_COUNT };
+static const char* const jkRpg_aArtFiles[ARTFILE_COUNT] = {"upgrades.bmp", "plate.bmp", "frame.bmp", "titlebar.bmp", "weapons.bmp", "bacta.bmp", "force.bmp"};
+static jkRpgCanvas jkRpg_aArt2[ARTFILE_COUNT];
+static int jkRpg_bArtTried;
+static stdBitmap* jkRpg_pWeaponArt;
+static unsigned jkRpg_weaponArtMask;
+
+#define FRAME_BORDER 20      // frame.bmp border, texels
+#define FRAME_T 12           // drawn border, menu units
+#define BAR_CAP 52           // titlebar.bmp end cap width, texels
+#define PLATE_TEXELS 4.0f    // plate.bmp texels per gauge pixel
+#define WINDOW_X0 7.25f      // the plate's black window, gauge pixels
+#define WINDOW_X1 46.5f
+#define WINDOW_Y0 2.5f
+#define WINDOW_Y1 10.25f
+#define BACTA_ART_W 133     // bacta.bmp texels, 4 per gauge pixel (process_ui.py prints the window)
+#define BACTA_ART_H 128
+#define BACTA_WIN_X0 3.25f    // its dark window, gauge pixels
+#define BACTA_WIN_Y0 3.75f
+#define BACTA_WIN_X1 28.75f
+#define BACTA_WIN_Y1 27.5f
+
+static int jkRpg_ReadBmp(const char* path, jkRpgCanvas* out)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    uint8_t h[54];
+    if (fread(h, 1, sizeof(h), f) != sizeof(h)) { fclose(f); return 0; }
+    uint32_t offset = h[10] | h[11] << 8 | h[12] << 16 | (uint32_t)h[13] << 24;
+    int32_t w = h[18] | h[19] << 8 | h[20] << 16 | (uint32_t)h[21] << 24;
+    int32_t ht = h[22] | h[23] << 8 | h[24] << 16 | (uint32_t)h[25] << 24;
+    int ok = h[0] == 'B' && h[1] == 'M' && offset >= 54
+        && h[14] == 40 && !h[15] && !h[16] && !h[17] && h[26] == 1 && !h[27]
+        && h[28] == 24 && !h[29] && !h[30] && !h[31] && !h[32] && !h[33]
+        && w > 0 && w <= 4096 && ht != 0 && ht >= -4096 && ht <= 4096;
+    if (!ok) { fclose(f); return 0; }
+    int rows = ht < 0 ? -ht : ht, stride = (w * 3 + 3) & ~3;
+    uint8_t* line = ok ? (uint8_t*)malloc(stride) : NULL;
+    out->px = ok && line ? (float*)calloc((size_t)w * rows * 4, sizeof(float)) : NULL;
+    ok = out->px && fseek(f, offset, SEEK_SET) == 0;
+    for (int r = 0; ok && r < rows; r++) {
+        if (fread(line, 1, stride, f) != (size_t)stride) { ok = 0; break; }
+        int y = ht > 0 ? rows - 1 - r : r; // bottom-up unless the height is negative
+        for (int x = 0; x < w; x++) {
+            float* p = &out->px[((size_t)y * w + x) * 4];
+            uint8_t b = line[x * 3], g = line[x * 3 + 1], rr = line[x * 3 + 2];
+            int key = rr == 255 && g == 0 && b == 255;
+            p[0] = rr / 255.0f; p[1] = g / 255.0f; p[2] = b / 255.0f; p[3] = key ? 0 : 1;
+        }
+    }
+    free(line);
+    fclose(f);
+    if (!ok) { free(out->px); out->px = NULL; return 0; }
+    out->w = w; out->h = rows; out->s = 1;
+    return 1;
+}
+
+static const jkRpgCanvas* jkRpg_ShippedArt(int which)
+{
+    if (!jkRpg_bArtTried) {
+        jkRpg_bArtTried = 1;
+        for (int i = 0; i < ARTFILE_COUNT; i++) {
+            char path[128];
+            stdString_snprintf(path, sizeof(path), "rpg/art/%s", jkRpg_aArtFiles[i]);
+            if (!jkRpg_ReadBmp(path, &jkRpg_aArt2[i])) memset(&jkRpg_aArt2[i], 0, sizeof(jkRpgCanvas));
+        }
+        // Sanity: the shapes the layout below expects.
+        if (jkRpg_aArt2[ARTFILE_WEAPONS].px && (jkRpg_aArt2[ARTFILE_WEAPONS].w != 960 || jkRpg_aArt2[ARTFILE_WEAPONS].h != 192))
+            { free(jkRpg_aArt2[ARTFILE_WEAPONS].px); jkRpg_aArt2[ARTFILE_WEAPONS].px = NULL; }
+        const jkRpgCanvas* weapons = &jkRpg_aArt2[ARTFILE_WEAPONS];
+        if (weapons->px)
+            for (int y = 0; y < weapons->h; y++)
+                for (int x = 0; x < weapons->w; x++)
+                    if (weapons->px[(y * weapons->w + x) * 4 + 3] > 0)
+                        jkRpg_weaponArtMask |= 1u << ((y / 96) * 5 + x / 192);
+        // The shipped atlas has no lock tile; older atlases without the newest branch still fit.
+        if (jkRpg_aArt2[ARTFILE_UPGRADES].px && (jkRpg_aArt2[ARTFILE_UPGRADES].w < ATLAS_COLS * TILE
+            || jkRpg_aArt2[ARTFILE_UPGRADES].h < (UP_ENDURANCE * TILES_PER_BRANCH + ATLAS_COLS - 1) / ATLAS_COLS * TILE))
+            { free(jkRpg_aArt2[ARTFILE_UPGRADES].px); jkRpg_aArt2[ARTFILE_UPGRADES].px = NULL; }
+        if (jkRpg_aArt2[ARTFILE_FRAME].px && (jkRpg_aArt2[ARTFILE_FRAME].w <= 2 * FRAME_BORDER || jkRpg_aArt2[ARTFILE_FRAME].h <= 2 * FRAME_BORDER))
+            { free(jkRpg_aArt2[ARTFILE_FRAME].px); jkRpg_aArt2[ARTFILE_FRAME].px = NULL; }
+        if (jkRpg_aArt2[ARTFILE_BAR].px && jkRpg_aArt2[ARTFILE_BAR].w <= 2 * BAR_CAP)
+            { free(jkRpg_aArt2[ARTFILE_BAR].px); jkRpg_aArt2[ARTFILE_BAR].px = NULL; }
+        if (jkRpg_aArt2[ARTFILE_FORCE].px && (jkRpg_aArt2[ARTFILE_FORCE].w != 136 || jkRpg_aArt2[ARTFILE_FORCE].h != 128))
+            { free(jkRpg_aArt2[ARTFILE_FORCE].px); jkRpg_aArt2[ARTFILE_FORCE].px = NULL; }
+        if (jkRpg_aArt2[ARTFILE_BACTA].px && (jkRpg_aArt2[ARTFILE_BACTA].w != BACTA_ART_W || jkRpg_aArt2[ARTFILE_BACTA].h != BACTA_ART_H))
+            { free(jkRpg_aArt2[ARTFILE_BACTA].px); jkRpg_aArt2[ARTFILE_BACTA].px = NULL; }
+    }
+    return jkRpg_aArt2[which].px ? &jkRpg_aArt2[which] : NULL;
+}
+
+// The menu and weapon reminder share one atlas and keep the model fallback for empty slots.
+int jkRpg_DrawShippedWeaponIcon(int weapon, int x, int y, int width, int height)
+{
+    if (weapon < 1 || weapon > 10 || width <= 0 || height <= 0) return 0;
+    const jkRpgCanvas* art = jkRpg_ShippedArt(ARTFILE_WEAPONS);
+    if (!art) return 0;
+    int sx = ((weapon - 1) % 5) * 192, sy = ((weapon - 1) / 5) * 96;
+    if (!(jkRpg_weaponArtMask & (1u << (weapon - 1)))) return 0;
+    if (!jkRpg_pWeaponArt) jkRpg_pWeaponArt = jkRpg_CanvasBitmap((jkRpgCanvas*)art);
+    if (!jkRpg_pWeaponArt) return 0;
+    rdRect rect = {sx, sy, 192, 96};
+    flex_t scale = fmin((flex_t)width / 192, (flex_t)height / 96);
+    std3D_DrawUIBitmapRGBA(jkRpg_pWeaponArt, 0, x + (width - 192 * scale) * 0.5,
+        y + (height - 96 * scale) * 0.5, &rect, scale, scale, 1, 255, 255, 255, 255);
+    return 1;
+}
+
+// Copy a source rectangle into a destination rectangle, averaging 4x4 samples per pixel so
+// the art keeps its detail when shrunk and stays even when enlarged.
+static void jkRpg_Stretch(const jkRpgCanvas* src, float sx0, float sy0, float sx1, float sy1,
+                          jkRpgCanvas* dst, int dx0, int dy0, int dx1, int dy1)
+{
+    if (dx1 <= dx0 || dy1 <= dy0) return;
+    for (int y = dy0 < 0 ? 0 : dy0; y < dy1 && y < dst->h; y++)
+        for (int x = dx0 < 0 ? 0 : dx0; x < dx1 && x < dst->w; x++) {
+            float acc[4] = {0, 0, 0, 0};
+            for (int n = 0; n < 16; n++) {
+                float fx = sx0 + (x - dx0 + (n % 4 + 0.5f) / 4) * (sx1 - sx0) / (dx1 - dx0);
+                float fy = sy0 + (y - dy0 + (n / 4 + 0.5f) / 4) * (sy1 - sy0) / (dy1 - dy0);
+                int ix = (int)fx, iy = (int)fy;
+                if (ix < 0) ix = 0;
+                if (iy < 0) iy = 0;
+                if (ix >= src->w) ix = src->w - 1;
+                if (iy >= src->h) iy = src->h - 1;
+                const float* p = &src->px[((size_t)iy * src->w + ix) * 4];
+                for (int c = 0; c < 3; c++) acc[c] += p[c] * p[3];
+                acc[3] += p[3];
+            }
+            float* d = &dst->px[((size_t)y * dst->w + x) * 4];
+            for (int c = 0; c < 3; c++) d[c] = acc[3] > 0 ? acc[c] / acc[3] : 0;
+            d[3] = acc[3] / 16;
+        }
+}
+
+// The generated pictures replace the drawn ones tile by tile.
+static void jkRpg_OverlayShippedTiles(uint16_t* px, int stride)
+{
+    const jkRpgCanvas* art = jkRpg_ShippedArt(ARTFILE_UPGRADES);
+    if (!art) return;
+    for (int tile = 0; tile < TILE_LOCK; tile++) {
+        // Extended illumination replaces the old battery picture with its drawn lamp.
+        if (tile == UP_LIGHT * TILES_PER_BRANCH + 2) continue;
+        // Keep shipped atlases compatible with the original Sequencer icon order.
+        int sourceTile = tile;
+        if (tile == UP_SEQUENCER * TILES_PER_BRANCH + 1) sourceTile++;
+        if (tile == UP_SEQUENCER * TILES_PER_BRANCH + 2) sourceTile--;
+        int sx = (sourceTile % ATLAS_COLS) * TILE, sy = (sourceTile / ATLAS_COLS) * TILE, opaque = 0;
+        for (int i = 0; i < TILE * TILE; i++)
+            opaque += art->px[((size_t)(sy + i / TILE) * art->w + sx + i % TILE) * 4 + 3] > 0;
+        if (opaque < TILE * TILE / 2) continue; // no picture in this slot
+        uint16_t* at = px + ((tile / ATLAS_COLS) * TILE_CELL + 1) * stride + (tile % ATLAS_COLS) * TILE_CELL + 1;
+        for (int y = 0; y < TILE; y++)
+            for (int x = 0; x < TILE; x++) {
+                const float* p = &art->px[((size_t)(sy + y) * art->w + sx + x) * 4];
+                uint8_t rgb[3] = {(uint8_t)(p[0] * 255), (uint8_t)(p[1] * 255), (uint8_t)(p[2] * 255)};
+                at[y * stride + x] = p[3] > 0 ? jkRpg_Pixel(rgb) : 0x8000;
+            }
+    }
+}
+
+static stdBitmap* jkRpg_pFrame, *jkRpg_pBar, *jkRpg_pArtPlate, *jkRpg_pBactaIcon;
+static stdBitmap* jkRpg_aHudPanels[2]; // Bacta, selected Force power
+static flex_t jkRpg_aHudPanelScales[2];
+static int jkRpg_frameW, jkRpg_frameH, jkRpg_frameT, jkRpg_barW, jkRpg_barH;
+static flex_t jkRpg_artPlateScale;
+
+// The menu border: corners kept whole, edges stretched along their length.
+static int jkRpg_DrawShippedFrame(int x, int y, int w, int h)
+{
+    const jkRpgCanvas* art = jkRpg_ShippedArt(ARTFILE_FRAME);
+    int t = U(FRAME_T);
+    if (!art || t < 2 || w <= 2 * t || h <= 2 * t) return 0;
+    if (!jkRpg_pFrame || jkRpg_frameW != w || jkRpg_frameH != h || jkRpg_frameT != t) {
+        if (jkRpg_pFrame) stdBitmap_Free(jkRpg_pFrame);
+        jkRpg_pFrame = NULL;
+        jkRpg_frameW = w; jkRpg_frameH = h; jkRpg_frameT = t;
+        jkRpgCanvas c;
+        if (!jkRpg_NewCanvas(&c, (float)w, (float)h, 1)) return 0;
+        c.w = w; c.h = h; // exactly the panel
+        const float b = FRAME_BORDER, sw = (float)art->w, sh = (float)art->h;
+        const float sxs[4] = {0, b, sw - b, sw}, sys[4] = {0, b, sh - b, sh};
+        const int dxs[4] = {0, t, w - t, w}, dys[4] = {0, t, h - t, h};
+        for (int j = 0; j < 3; j++)
+            for (int i = 0; i < 3; i++)
+                if (i != 1 || j != 1) // the inside stays the panel's own dark background
+                    jkRpg_Stretch(art, sxs[i], sys[j], sxs[i + 1], sys[j + 1], &c, dxs[i], dys[j], dxs[i + 1], dys[j + 1]);
+        jkRpg_pFrame = jkRpg_CanvasBitmap(&c);
+        free(c.px);
+    }
+    if (!jkRpg_pFrame) return 0;
+    std3D_DrawUIBitmapRGBA(jkRpg_pFrame, 0, x, y, NULL, 1, 1, 1, 255, 255, 255, 255);
+    return 1;
+}
+
+// The title bar; returns the width of its end caps (0 when the drawn bar is used instead).
+static int jkRpg_DrawShippedBar(int x, int y, int w, int h)
+{
+    const jkRpgCanvas* art = jkRpg_ShippedArt(ARTFILE_BAR);
+    int cap = art ? BAR_CAP * h / art->h : 0;
+    if (!art || h < 2 || w <= 2 * cap) return 0;
+    if (!jkRpg_pBar || jkRpg_barW != w || jkRpg_barH != h) {
+        if (jkRpg_pBar) stdBitmap_Free(jkRpg_pBar);
+        jkRpg_pBar = NULL;
+        jkRpg_barW = w; jkRpg_barH = h;
+        jkRpgCanvas c;
+        if (!jkRpg_NewCanvas(&c, (float)w, (float)h, 1)) return 0;
+        c.w = w; c.h = h; // exactly the bar
+        float sw = (float)art->w, sh = (float)art->h;
+        jkRpg_Stretch(art, 0, 0, BAR_CAP, sh, &c, 0, 0, cap, h);
+        jkRpg_Stretch(art, BAR_CAP, 0, sw - BAR_CAP, sh, &c, cap, 0, w - cap, h);
+        jkRpg_Stretch(art, sw - BAR_CAP, 0, sw, sh, &c, w - cap, 0, w, h);
+        jkRpg_pBar = jkRpg_CanvasBitmap(&c);
+        free(c.px);
+    }
+    if (!jkRpg_pBar) return 0;
+    std3D_DrawUIBitmapRGBA(jkRpg_pBar, 0, x, y, NULL, 1, 1, 1, 255, 255, 255, 255);
+    return cap;
+}
