+// Timed saves use their own slot; never replace a manual quicksave or restart point.
+// Run at the end of a safe simulation frame, with no pending save/load request.
+int sithGamesave_Autosave(void)
+{
+    if (sithGamesave_state != SITH_GS_NONE || writeFile || !sithWorld_g_pCurrentWorld
+        || !sithPlayer_g_pLocalPlayerThing || sithNet_isMulti || Main_bMotsCompat)
+        return 0;
