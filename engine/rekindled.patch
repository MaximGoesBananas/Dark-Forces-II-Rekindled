+// Mission 3's authored first-objective sector is the house entrance. Its one-time
+// reminder is saved independently of learning the key; lighting changes cannot retrigger it.
+static void jkRpg_VisionReminder(SithThing* p, int batteryPickup)
+{
+    static int shown;
+    static flex_t lastAt;
+    flex_t now = sithTime_g_secGameTime;
+    if (!jkRpg_IsActive(p) || (p->flags & SITH_TF_DEAD) || now < 8.0)
+        return;
+    int notices = jkRpg_Get(p, RPG_BIN_VISIONKEY);
+    int mansionMap = sithWorld_g_pCurrentWorld
+        && !__strcmpi(sithWorld_g_pCurrentWorld->map_jkl_fname, "03katarn.jkl");
+    int mansion = mansionMap && p->sector && p->sector->id == 140 && !(notices & 2);
+    if (sithInventory_IsInventoryActivated(p, SITHBIN_FIELDLIGHT)) {
+        if (mansion) sithInventory_SetInventory(p, RPG_BIN_VISIONKEY, notices | 2);
+        return;
+    }
+    if ((!batteryPickup && sithInventory_GetInventory(p, SITHBIN_BATTERY) <= 0)
+        || (!mansion && ((notices & 1) || (!batteryPickup && mansionMap)
+            || (shown && (!batteryPickup || (now >= lastAt && now - lastAt < 120.0))))))
+        return;
+    int bin = SITHBIN_FIELDLIGHT;
+    if (sithInventory_GetInventory(p, bin) <= 0 || !sithInventory_IsInventoryAvailable(p, bin))
+        return;
+    shown = 1;
+    lastAt = now;
+    if (mansion) sithInventory_SetInventory(p, RPG_BIN_VISIONKEY, notices | 2);
+    const char* key = jkRpg_BindingName(INPUT_FUNC_USEVISION);
+    if (key)
+        jkRpg_Print("Press %s to use your field light.", key);
+    else
+        jkRpg_Print("Bind Toggle field light in Setup to use your light.");
+}
+
+// Scales what the game's scripts give or take. ChangeInv and HealThing call this with the amount
+// (HealThing passes bin -1):
+// - ammo from pow_* pickups (Scavenger); leftover fractions add up per ammo type
+// - health packs (Field Medic), shield recharges (Shields), bacta (Bacta tank), Force Healing
+// - battery pickups and field light drain
+// - natural Force recovery from force_well.cog (Force), not pickups, Absorb or Surge
+flex_t jkRpg_PickupAmount(sithCog* pCog, SithThing* p, int bin, flex_t amount)
+{
+    if (amount == 0 || !pCog || !pCog->pScript || !jkRpg_IsActive(p))
+        return amount;
+    int bPickup = !__strnicmp(pCog->pScript->aName, "pow_", 4);
+    if (bin == SITHBIN_FORCEMANA) {
+        if (amount < 0 || !jkRpg_IsScript(pCog, "force_well.cog"))
+            return amount;
+        int persuasion = sithInventory_IsInventoryActivated(p, SITHBIN_F_PERSUASION);
+        return amount * jkRpg_ForceRegenScale(jkRpg_Rank(p, UP_FORCE), persuasion);
+    }
+    if (bin == SITHBIN_BATTERY) {
+        if (amount > 0 && jkRpg_IsScript(pCog, "pow_battery.cog"))
+            jkRpg_VisionReminder(p, 1);
+        int rank = jkRpg_Rank(p, UP_LIGHT);
+        if (amount < 0 && rank >= 3 && jkRpg_IsScript(pCog, "item_fieldlight.cog"))
+            return amount * 0.5;
+        return amount;
+    }
+    if (amount < 0)
+        return amount;
+    if (bin < 0) {
+        if (jkRpg_IsScript(pCog, "force_heal.cog"))
+            return jkRpg_ForceHealAmount(amount);
+        if (jkRpg_IsScript(pCog, "item_bacta.cog")) {
+            int rank = jkRpg_Rank(p, UP_BACTA);
+            if (rank >= 2)
+                sithInventory_ChangeInventory(p, RPG_BIN_BACTAHEAL, RPG_BACTA_LASTING);
+            return amount * jkRpg_BactaShare(rank);
+        }
+        if (jkRpg_IsScript(pCog, "pow_health.cog"))
+            return amount * jkRpg_HealthPackShare(jkRpg_Rank(p, UP_MEDIC), jkRpg_IsLow(p->actorParams.health, p->actorParams.maxHealth));
+        return bPickup ? amount * 0.75 : amount;
+    }
+    if (!bPickup)
+        return amount;
+    if (bin == SITHBIN_BACTATANK) {
+        jkRpg_BactaReminder(p); // before the tank is added, so a first tank is still undiscovered
+        return amount;
+    }
+    if (bin == SITHBIN_SHIELDS) // armor vests, Super Shield and backpacks keep the mod's 60% share
+        return amount * (jkRpg_IsScript(pCog, "pow_shields.cog") ? jkRpg_ShieldPackShare(jkRpg_Rank(p, UP_SHIELDS)) : 0.6);
+    if (bin != SITHBIN_ENERGY && bin != SITHBIN_POWER && bin != SITHBIN_RAILCHARGES && bin != 4 && bin != 8)
+        return amount;
+    // Rocket supplies follow the halved carrying limit, including Scavenger bonuses.
+    if (bin == SITHBIN_RAILCHARGES)
+        amount *= 0.5;
+    // Mission 18 is supplied mostly by dropped repeaters; halve every source of power cells here.
+    if (bin == SITHBIN_POWER && sithWorld_g_pCurrentWorld
+        && !__strcmpi(sithWorld_g_pCurrentWorld->map_jkl_fname, "19a.jkl"))
+        amount *= 0.5;
+    // The shortage test uses the receiving ammo supply before collection, not the selected weapon.
+    int low = jkRpg_IsLow(sithInventory_GetInventory(p, bin), sithInventory_g_aTypes[bin].max);
+    flex_t total = amount * jkRpg_AmmoShare(jkRpg_Rank(p, UP_SCAVENGER), low, jkRpg_IsEnemyWeapon(pCog)) + jkRpg_aLeftover[bin];
+    flex_t give = (flex_t)(int)total;
+    if (give < 1 && amount >= 1 && (bin == 4 || bin == 8)) // the pickup is the weapon itself
+        give = 1;
+    jkRpg_aLeftover[bin] = total - give;
+    return give;
+}
+
+// Force energy limits in the game's scripts. Natural recovery (force_well.cog) and Force pickups
+// (pow_mana.cog) clamp energy to Jedi rank * 50; the level start (kyle.cog) and Surge pickups refill
+// to it. Deep reserves raises that capacity by a quarter, so clamps keep energy up to the upgraded
+// capacity and refills fill it.
+flex_t jkRpg_ScriptSetInv(sithCog* pCog, SithThing* p, int bin, flex_t amount)
+{
+    if (bin != SITHBIN_FORCEMANA || !pCog || !pCog->pScript || !jkRpg_IsActive(p))
+        return amount;
+    flex_t story = sithInventory_GetInventory(p, SITHBIN_JEDI_RANK) * 50.0;
+    if (amount != story)
+        return amount;
+    flex_t capacity = story * jkRpg_ForceCapacityScale(jkRpg_Rank(p, UP_FORCE));
+    if (jkRpg_IsScript(pCog, "force_well.cog") || jkRpg_IsScript(pCog, "pow_mana.cog")) {
+        flex_t energy = sithInventory_GetInventory(p, bin);
+        return energy < capacity ? energy : capacity;
+    }
+    if (jkRpg_IsScript(pCog, "kyle.cog") || jkRpg_IsScript(pCog, "pow_lightside.cog") || jkRpg_IsScript(pCog, "pow_darkside.cog"))
+        return capacity;
+    return amount;
+}
+
+// Scripts written for a 100-health maximum see health as a share of the upgraded maximum:
+// health packs are taken and bacta is used below 100, and Force Healing works unless health is 100.
+// Clamp Kyle's reported health for Yun's script; jkRpg_YunTaunt controls the taunt instead.
+flex_t jkRpg_ScriptHealth(sithCog* pCog, SithThing* pThing, flex_t health)
+{
+    if (jkRpg_IsScript(pCog, "darkjedi_yun.cog") && jkRpg_IsActive(pThing))
+        return pThing->actorParams.maxHealth;
+    if (!(jkRpg_IsScript(pCog, "pow_health.cog") || jkRpg_IsScript(pCog, "item_bacta.cog") || jkRpg_IsScript(pCog, "force_heal.cog"))
+        || !jkRpg_IsActive(pThing) || pThing->actorParams.maxHealth <= 0)
+        return health;
+    return health * 100.0 / pThing->actorParams.maxHealth;
+}
