+static void jkRpg_FixPoolGuards(void)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (__strcmpi(world->map_jkl_fname, "04escapehouse.jkl")) return;
+    static uint32_t lastAttempt;
+    uint32_t now = stdPlatform_GetTimeMsec();
+    if (lastAttempt && (uint32_t)(now-lastAttempt)<1000) return;
+    lastAttempt = now;
+    static const rdVector3 banks[] = {
+        {0.65, 2.95, 0.72}, {1.30, 2.20, 0.72},
+        {2.30, 3.40, 0.72}, {1.60, 4.20, 0.72}
+    };
+    for (int i=0; i<=world->numThings; ++i) {
+        SithThing* guard = &world->aThings[i];
+        if (guard->type != SITH_THING_ACTOR ||
+            (guard->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED)) ||
+            (!jkRpg_IsScript(guard->pCog, "actor_tk.cog") && !jkRpg_IsScript(guard->pCog, "actor_tb.cog"))) continue;
+        rdVector3 pos = guard->position;
+        if (pos.x < -0.30 || pos.x > 3.25 || pos.y < 1.80 || pos.y > 5.20 || pos.z < -0.5 || pos.z > 0.35) continue;
+        for (int spot=0; spot<4; ++spot) {
+            pos = banks[spot];
+            SithThing anchor = *guard;
+            anchor.position = pos;
+            anchor.sector = sithSector_FindSectorAtPos(world, &pos);
+            if (!anchor.sector) continue;
+            SithSector* sector = jkRpg_CrowdPosition(&anchor, guard, &pos, 0.04);
+            if (!sector) continue;
+            jkRpg_MoveActor(guard, pos, sector);
+            stdPlatform_Printf("RPG reservoir guard moved: %d\n", guard->idx);
+            break;
+        }
+    }
+}
