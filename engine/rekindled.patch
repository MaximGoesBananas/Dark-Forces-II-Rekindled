+// RPG: profiles saved before the bacta key existed get R, as fresh profiles do, when R is unused
+// or is only one of several Next Item keys (the stock R/] pair; Next Item keeps the others).
+// "rpgbactakey" in the profile marks it as already offered, so a removed binding stays removed.
+static void sithControl_MigrateBactaKey(int hasBactaSetting)
+{
+    if (hasBactaSetting || sithControl_aInputFuncToKeyinfo[INPUT_FUNC_USEBACTA].numEntries)
+        return;
+    for (int i = 0; i < INPUT_FUNC_MAX; i++)
+        for (uint32_t j = 0; j < sithControl_aInputFuncToKeyinfo[i].numEntries; j++)
+            if ((sithControl_aInputFuncToKeyinfo[i].aEntries[j].flags & INPUT_MAPPING_FLAG_DXKEY)
+                && sithControl_aInputFuncToKeyinfo[i].aEntries[j].dxKeyNum == DIK_R
+                && (i != INPUT_FUNC_NEXTINV || sithControl_aInputFuncToKeyinfo[i].numEntries < 2))
+                return;
+    sithControl_BindControl(INPUT_FUNC_USEBACTA, DIK_R, 0); // also releases R from Next Item
+}
+
+// Offer G once, releasing only its redundant Next Weapon keyboard binding.
+static void sithControl_MigrateVisionKey(int hasVisionSetting)
+{
+    if (hasVisionSetting || sithControl_aInputFuncToKeyinfo[INPUT_FUNC_USEVISION].numEntries)
+        return;
+    int otherWeaponKey = 0;
