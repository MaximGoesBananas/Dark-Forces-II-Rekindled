+
+// Match the engine's collision rules, ignoring the seed itself but not doors or other actors.
+static int jkRpg_CrowdPath(SithThing* seed, SithSector* sector, const rdVector3* from, const rdVector3* to, flex_t radius)
+{
+    rdVector3 dir;
+    rdVector_Sub3(&dir, to, from);
+    flex_t distance = rdVector_Normalize3Acc(&dir);
+    sithCollision_SearchForCollisions(sector, seed, from, &dir, distance, radius, 0);
+    SithCollision* hit;
+    int clear = 1;
+    while ((hit = sithCollision_PopStack())) {
+        if (hit->type & (SITHCOLLISION_THING | SITHCOLLISION_WORLD)) {
+            clear = 0;
+            break;
+        }
+    }
+    sithCollision_DecreaseStackLevel();
+    return clear;
+}
+
+// Distance down to walkable floor: the engine's walkable-floor test on real level geometry, keeping
+// away from water and scripted/moving floors. Negative when the first surface below is not such a floor.
+static flex_t jkRpg_FloorBelow(SithSector* sector, const rdVector3* from, flex_t depth, rdVector3* pNormal)
+{
+    rdVector3 down = {0, 0, -1};
+    sithCollision_SearchForCollisions(sector, NULL, from, &down, depth, 0, RAYCAST_1 | RAYCAST_10);
+    SithCollision* hit;
+    flex_t distance = -1;
+    while ((hit = sithCollision_PopStack())) {
+        if (!(hit->type & SITHCOLLISION_WORLD)) continue;
+        if (hit->surface && !hit->surface->pAdjoin && hit->hitNorm.z >= 0.6
+            && !(hit->surface->flags & (SITH_SURFACE_COG_LINKED | SITH_SURFACE_WATER | SITH_SURFACE_VERYDEEPWATER))) {
+            distance = hit->distance;
+            if (pNormal) *pNormal = hit->hitNorm;
+        }
+        break;
+    }
+    sithCollision_DecreaseStackLevel();
+    return distance;
+}
+
+// Move a point through the level. Returns the sector it reaches, or NULL when something stops it;
+// *pWall is then 1 for solid level geometry, 0 for a closed or invisible passage.
+static SithSector* jkRpg_CrowdProbe(SithSector* sector, const rdVector3* from, const rdVector3* to, int* pWall)
+{
+    rdVector3 dir;
+    rdVector_Sub3(&dir, to, from);
+    flex_t distance = rdVector_Normalize3Acc(&dir);
+    *pWall = 0;
+    if (distance <= 0) return sector;
+    sithCollision_SearchForCollisions(sector, NULL, from, &dir, distance, 0, RAYCAST_1);
+    SithCollision* hit;
+    while ((hit = sithCollision_PopStack())) {
+        if ((hit->type & SITHCOLLISION_ADJOINCROSS) && hit->surface && hit->surface->pAdjoin) {
+            sector = hit->surface->pAdjoin->sector;
+            continue;
+        }
+        if (hit->type & SITHCOLLISION_WORLD) {
+            *pWall = hit->surface && !hit->surface->pAdjoin;
+            sector = NULL;
+            break;
+        }
+    }
+    sithCollision_DecreaseStackLevel();
+    return sector;
+}
+
+#define RPG_CROWD_STEP  0.05    // largest drop below the floor's own slope at the body's edge
+#define RPG_CROWD_RAYS  8       // directions checked around the body
+#define RPG_CROWD_PROBE 0.1     // probe height above the floor
+
+// Floor that holds a whole standing body near `pos`: real walkable floor under the centre, and at
+// the body's radius all around either the same floor (following its slope, within a small step)
+// or a solid wall beside the feet. A drop, or a closed/invisible passage over one, fails.
+// Returns the sector above the floor and the floor height, or NULL.
+static SithSector* jkRpg_CrowdFloor(const rdVector3* pos, flex_t radius, flex_t* pFloor)
+{
+    // Find the floor first: a horizontal ray would reject otherwise walkable uphill ground.
+    rdVector3 top = *pos, normal;
+    SithSector* sector = sithSector_FindSectorAtPos(sithWorld_g_pCurrentWorld, &top);
+    for (int step = 0; !sector && step < 2; step++) {
+        top.z += 0.15;
+        sector = sithSector_FindSectorAtPos(sithWorld_g_pCurrentWorld, &top);
+    }
+    if (!sector || (sector->flags & (SITH_SECTOR_UNDERWATER | SITH_SECTOR_USETHRUST))) return NULL;
+    flex_t below = jkRpg_FloorBelow(sector, &top, 0.6, &normal);
+    if (below < 0) return NULL;
+    *pFloor = top.z - below;
+
+    // Probe just above the floor: from the centre out to the body's edge, then down.
+    rdVector3 feet = {top.x, top.y, *pFloor + RPG_CROWD_PROBE};
+    int wall;
+    SithSector* feetSector = jkRpg_CrowdProbe(sector, &top, &feet, &wall);
+    if (!feetSector) return NULL;
+    for (int i = 0; i < RPG_CROWD_RAYS; i++) {
+        flex_t angle = i * (2.0 * M_PI / RPG_CROWD_RAYS);
+        rdVector3 offset = {cos(angle) * radius, sin(angle) * radius, 0}, edge = feet;
+        rdVector_Add3Acc(&edge, &offset);
+        SithSector* edgeSector = jkRpg_CrowdProbe(feetSector, &feet, &edge, &wall);
+        if (!edgeSector) {
+            if (wall) continue; // a wall right beside the feet
+            return NULL;
+        }
+        // Where the centre's floor plane continues under this edge, plus a small step.
+        flex_t expected = RPG_CROWD_PROBE + (normal.x * offset.x + normal.y * offset.y) / normal.z;
+        if (expected < 0 || jkRpg_FloorBelow(edgeSector, &edge, expected + RPG_CROWD_STEP, NULL) < 0)
+            return NULL;
+    }
+    return sector;
+}
+
+static SithSector* jkRpg_CrowdPosition(SithThing* seed, SithThing* tpl, rdVector3* pos, flex_t spacingMargin)
+{
+    flex_t radius = tpl->moveSize + (spacingMargin > 0 ? 0.025 : 0);
+    flex_t floor;
+    if (!jkRpg_CrowdFloor(pos, tpl->moveSize, &floor)) return NULL;
+    pos->z = floor + sithPhysics_GetThingHeight(tpl) + 0.002;
+    if (fabs(pos->z - seed->position.z) > 0.35) return NULL;
+    if (!jkRpg_CrowdPath(seed, seed->sector, &seed->position, pos, 0.01)) return NULL;
+    SithSector* sector = sithSector_FindSectorAtPos(sithWorld_g_pCurrentWorld, pos);
+    if (!sector) return NULL;
+    // Leave room around the body and above the head, including at sector boundaries.
+    rdVector3 head = *pos;
+    head.z += 0.08;
+    if (!jkRpg_CrowdPath(seed, sector, pos, &head, radius)) return NULL;
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* other = &world->aThings[i];
+        if (!other->type || !other->collide || (other->flags & (SITH_TF_DISABLED | SITH_TF_DESTROYED))) continue;
+        // Authored spots use the model collision above, not its oversized bounding sphere.
+        if (spacingMargin == 0 && other->collide == 3) continue;
+        rdVector3 delta;
+        rdVector_Sub3(&delta, &other->position, pos);
+        flex_t spacing = radius + other->moveSize + spacingMargin;
+        if (fabs(delta.z) < 0.25 && delta.x * delta.x + delta.y * delta.y < spacing * spacing)
+            return NULL;
+    }
+    return sector;
+}
+
+// Authored things keep their level index as GUID. Created things get a player-prefixed
+// GUID, preserved in saves. The stock campaign never spawns these ordinary civilian
+// templates from COG; its dynamically created ordinary civilians are the mod's crowds.
+static int jkRpg_IsAuthored(SithThing* thing)
+{
+    return thing->guid == thing->idx;
+}
+
+static void jkRpg_FixBaronsPatron(SithThing* player)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (__strcmpi(world->map_jkl_fname, "06abarons.jkl")
+        || jkRpg_Get(player, RPG_BIN_CROWDS) != 1) return;
+    SithThing* woman = sithTemplate_GetTemplate("woman1");
+    if (!woman || !woman->renderData.model3 || !woman->pPuppetClass || !woman->pCog) return;
+    for (int i = 0; i <= world->numThings; ++i) {
+        SithThing* patron = &world->aThings[i];
+        rdVector3 pos = patron->position;
+        if (jkRpg_IsAuthored(patron) || jkRpg_CivilianKind(patron) != 1
+            || (patron->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))
+            || !patron->pTemplate || __strcmpi(patron->pTemplate->aName, "man1")
+            || pos.x < 6.3 || pos.x > 6.65 || pos.y < 40.05 || pos.y > 40.4
+            || pos.z < 0.3 || pos.z > 0.45) continue;
+        // Keep the existing actor, health, route and population contribution.
+        if (patron->puppet && patron->renderData.puppet) sithPuppet_ResetTrack(patron);
+        sithThing_SetThingModel(patron, woman->renderData.model3);
+        patron->pPuppetClass = woman->pPuppetClass;
+        patron->pSoundClass = woman->pSoundClass;
+        patron->pCog = woman->pCog;
+        patron->pTemplate = woman;
+        break;
+    }
+    sithInventory_SetInventory(player, RPG_BIN_CROWDS, 2);
+}
+
+// An actor stands on floor that holds its whole body.
+static int jkRpg_StandsSupported(SithThing* thing)
+{
+    flex_t floor;
+    return jkRpg_CrowdFloor(&thing->position, thing->moveSize, &floor) != NULL;
+}
