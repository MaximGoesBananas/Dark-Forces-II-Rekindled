+static void jkGuiRend_ControllerFocusStep(jkGuiMenu* menu, int step)
+{
+    jkGuiElement* previous = menu->focusedElement ? menu->focusedElement : menu->lastMouseOverClickable;
+    int count = 0;
+    while (menu->paElements[count].type != ELEMENT_END) ++count;
+    if (!count) return;
+    int index = previous ? (int)(previous - menu->paElements) : (step > 0 ? count - 1 : 0);
+    for (int i = 0; i < count; ++i) {
+        index = (index + step + count) % count;
+        jkGuiElement* element = &menu->paElements[index];
+        if (!element->bIsVisible || element->type == ELEMENT_TEXT || element->type >= ELEMENT_8) continue;
+        menu->focusedElement = (element->type == ELEMENT_LISTBOX || element->type == ELEMENT_TEXTBOX || element->type == ELEMENT_SLIDER) ? element : NULL;
+        jkGuiRend_ClickableMouseover(menu, element);
+        if (previous) jkGuiRend_UpdateAndDrawClickable(previous, menu, 1);
+        jkGuiRend_UpdateAndDrawClickable(element, menu, 1);
+        return;
+    }
+}
