+// Older Fuel Station saves already have two additions per original. Remove half
+// the surviving additions once, after their scripts have registered population.
+static void jkRpg_ThinFuelStation(SithThing* player)
+{
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    if (__strcmpi(world->map_jkl_fname, "09fuelstation.jkl")
+        || jkRpg_Get(player, RPG_BIN_CROWDS) != 1
+        || jkRpg_Get(player, RPG_BIN_CROWDFIX) < 2) return;
+    int added = 0, removed = 0;
+    for (int i = 0; i <= world->numThings; i++) {
+        SithThing* thing = &world->aThings[i];
+        if (!jkRpg_CivilianKind(thing) || jkRpg_IsAuthored(thing) || !thing->sector
+            || (thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))) continue;
+        if (++added % 2) continue;
+        sithThing_DestroyThing(thing);
+        removed++;
+    }
+    sithInventory_ChangeInventory(player, SITHBIN_PEDS_TOTAL, -removed);
+    sithInventory_SetInventory(player, RPG_BIN_CROWDS, 2);
+    stdPlatform_Printf("RPG Fuel Station crowds: removed=%d\n", removed);
+}
