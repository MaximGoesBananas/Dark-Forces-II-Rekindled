+// Enemy bolts and blasts reaching the player's health rise by campaign phase (docs/DIFFICULTY-PLAN.md):
+// 1 = before the saber, 2 = Barons Hed to the cargo ship, 3 = escape and tower, 4 = the final act.
+// Boss duels and any other map keep the general share.
+static flex_t jkRpg_RangedShare(void)
+{
+    static const struct { const char* map; flex_t share; } phases[] = {
+        {"01narshadda.jkl", 0.5}, {"02narshadda.jkl", 0.5}, {"03katarn.jkl", 0.5}, {"04escapehouse.jkl", 0.5},
+        {"06abarons.jkl", 0.6}, {"06bbarons.jkl", 0.6}, {"08escape88.jkl", 0.6}, {"09fuelstation.jkl", 0.6},
+        {"10cargo.jkl", 0.6},
+        {"12escape.jkl", 0.7}, {"14tower.jkl", 0.7},
+        {"16aescapeship.jkl", 0.8}, {"16bescapeship.jkl", 0.8}, {"18ascend.jkl", 0.8}, {"19a.jkl", 0.8},
+        {"19b.jkl", 0.8}
+    };
+    const char* map = sithWorld_g_pCurrentWorld ? sithWorld_g_pCurrentWorld->map_jkl_fname : "";
+    for (int i = 0; i < (int)(sizeof(phases) / sizeof(phases[0])); ++i)
+        if (!__strcmpi(map, phases[i].map)) return phases[i].share;
+    return 0.75;
+}
+
+// Damage after shields: the player's attacks and campaign combat balance.
+flex_t jkRpg_ModifyDamage(SithThing* pVictim, SithThing* pDamager, SithThing* pAttacker, flex_t damage, int damageType)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    if (!jkRpg_IsActive(p))
+        return damage;
+    if (pVictim == p) {
+        // Shorter, sharper duels; powerful scripted Force attacks keep their original damage.
+        if ((damageType == SITH_DAMAGE_SABER || damageType == SITH_DAMAGE_IMPACT) && jkRpg_IsCampaignBoss(pAttacker))
+            return damage * 1.25 * (!__strcmpi(pAttacker->pTemplate->aName, "sariss") ? 1.25 : 1.0);
+        // This hook runs after shields: soften only enemy bolts/blasts reaching health, by phase.
+        // Impact/melee, sabers, Force, hazards and the player's own shots retain their damage.
+        // Placed enemy mines have no owner; their blasts count as enemy blasts too.
+        if (pDamager && !jkRpg_IsForceShot(pDamager)
+            && (pDamager->type == SITH_THING_WEAPON || pDamager->type == SITH_THING_EXPLOSION)
+            && (damageType == SITH_DAMAGE_ENERGY || damageType == SITH_DAMAGE_FIRE)
+            && ((pAttacker && pAttacker->type == SITH_THING_ACTOR)
+                || (pAttacker != p && pDamager->type == SITH_THING_EXPLOSION && jkRpg_IsSequencerBlast(pDamager->pTemplate)))) {
+            // Enemy thermal blasts lose another 35% of health damage; shields have already run.
+            if (pDamager->type == SITH_THING_EXPLOSION && jkRpg_IsTemplate(pDamager->pTemplate, "+egrenade_exp"))
+                return damage * jkRpg_RangedShare() * 0.65;
+            return damage * jkRpg_RangedShare();
+        }
+        return damage;
+    }
+    if (pAttacker != p)
+        return damage;
+    // Preserve saved health and the bosses' scripted thresholds/healing; scale player hits instead.
+    if (jkRpg_IsCampaignBoss(pVictim)) {
+        // Preserve scripted stages: Maw lasts 20% longer; Sariss lasts 25% less time under equal hits.
+        const char* boss = pVictim->pTemplate->aName;
+        damage *= !__strcmpi(boss, "maw") ? 1.25 : !__strcmpi(boss, "sariss") ? 2.0
+            : !__strcmpi(boss, "pic") ? 1.5 / 0.9 : 1.5;
+    }
+    if (damageType & SITH_DAMAGE_FORCE)
+        return damage;
+    int weapon = jkRpg_TagOf(pDamager);
+    if (!weapon && (damageType & SITH_DAMAGE_SABER))
+        weapon = SITHBIN_LIGHTSABER;
+    // Other untagged damage counts only when it is the held weapon's own shot, blast or blow, so a
+    // Force power's projectile, such as Destruction's impact, or a blast whose tag was lost to a
+    // reload (an old mine) never takes on the held weapon's rules.
+    else if (!weapon) {
+        int held = jkRpg_CurWeapon(p);
+        if (!pDamager || (pDamager->type == SITH_THING_WEAPON ? jkRpg_IsWeaponShot(held, pDamager->pTemplate)
+                          : pDamager->type == SITH_THING_EXPLOSION ? jkRpg_IsWeaponBlast(held, pDamager->pTemplate) : 1))
+            weapon = held;
+    }
+    if (!weapon)
+        return damage;
+    jkRpgMods m;
+    jkRpg_GetMods(p, weapon, &m);
+    return damage * m.damage;
+}
+
+// Reduces damage to the player before shields absorb it (called by jkRpg_DamageBeforeShields).
+// Only the player's own protection changes; damage to enemies is untouched.
+flex_t jkRpg_WeaponProtection(SithThing* p, SithThing* pDamager, flex_t damage, int damageType)
+{
+    if (!pDamager)
+        return damage;
+    if (jkRpg_IsEnemyDetonator(pDamager, p))
+        damage *= RPG_ENEMY_DETONATOR;
+    jkRpgMods m;
+    if (pDamager->type == SITH_THING_EXPLOSION) {
+        // Safer handling/blasts: the player's own thermal detonators and concussion blasts.
+        int weapon = jkRpg_TagOf(pDamager);
+        if ((weapon == RPG_THERMAL || weapon == RPG_CONCUSSION) && sithThing_GetThingParent(pDamager) == p) {
+            jkRpg_GetMods(p, weapon, &m);
+            damage *= m.selfBlast;
+        }
+        // Blast padding: every sequencer explosion, the player's or an enemy mine.
+        if (jkRpg_IsSequencerBlast(pDamager->pTemplate)) {
+            jkRpg_GetMods(p, RPG_SEQUENCER, &m);
+            damage *= m.mineBlast;
+        }
+    }
+    // Blaster protection: bolts that get past the drawn saber.
+    if (pDamager->type == SITH_THING_WEAPON && (damageType & SITH_DAMAGE_ENERGY) && !jkRpg_IsForceShot(pDamager)
+        && jkRpg_CurWeapon(p) == SITHBIN_LIGHTSABER) {
+        jkRpg_GetMods(p, SITHBIN_LIGHTSABER, &m);
+        damage *= m.guard;
+    }
+    return damage;
+}
+
+// ---- Muzzle lights: the bowcaster's green charge light at the barrel's tip, growing with the
+// charge, and a tinier red flash at the stormtrooper rifle's muzzle for each shot. ----
+#define RPG_GLOW_MIN 0.0015   // world units: the charge light's radius as charging starts
+#define RPG_GLOW_MAX 0.0065   // and at a full charge
+#define RPG_FLASH_SIZE 0.0021 // the rifle's flash at its brightest
+#define RPG_FLASH_TIME 0.09   // seconds it takes to fade
+// Only the blade tip's round glow: the blade-edge texture left a dark band where they met.
+static const char* const jkRpg_aGlowMats[2][2] = {{"sabergreen0.mat", "sabergreen0.mat"}, {"saberred0.mat", "saberred0.mat"}};
+static rdPolyline jkRpg_aGlowLine[2];
+static rdThing jkRpg_aGlowThing[2];
+static int jkRpg_aGlowReady[2], jkRpg_aGlowFailed[2];
+
+static void jkRpg_FreeChargeGlow(void)
+{
+    for (int i = 0; i < 2; i++) {
+        if (jkRpg_aGlowReady[i]) {
+            rdThing_FreeEntry(&jkRpg_aGlowThing[i]);
+            rdPolyline_FreeEntry(&jkRpg_aGlowLine[i]);
+        }
+        jkRpg_aGlowReady[i] = jkRpg_aGlowFailed[i] = 0;
+    }
+    jkRpg_rifleShot = -1;
+}
+
+// The rifle's flash, 1 just after a shot down to 0; -1 when there is none to show.
+static flex_t jkRpg_RifleFlashShare(SithThing* p)
+{
+    flex_t since = sithTime_g_secGameTime - jkRpg_rifleShot;
+    if (!jkRpg_IsActive(p) || jkRpg_CurWeapon(p) != RPG_RIFLE || jkRpg_rifleShot < 0 || since < 0 || since >= RPG_FLASH_TIME)
+        return -1;
+    return 1 - since / RPG_FLASH_TIME;
+}
+
+// How far the held bowcaster charge has come, 0 to 1 (its last volley stage); -1 when not charging.
+static flex_t jkRpg_BowChargeShare(SithThing* p)
+{
+    if (!jkRpg_IsActive(p) || jkRpg_CurWeapon(p) != RPG_BOWCASTER || sithWeapon_8BD0A0[0] == -1.0)
+        return -1;
+    jkRpgMods m;
+    jkRpg_GetMods(p, RPG_BOWCASTER, &m);
+    flex_t full = RPG_BOW_STAGE * (m.bolts > 5 ? 3 : 2); // stages to five bolts, or seven with Full spread
+    flex_t held = (sithTime_g_secGameTime - sithWeapon_8BD0A0[0]) * m.charge;
+    return held <= 0 ? 0 : held >= full ? 1 : held / full;
+}
+
+// Drawn with the first-person weapon (jkPlayer_DrawPov), after it, on top of the barrel's tip.
+void jkRpg_DrawChargeGlow(rdThing* pov, rdMatrix34* orient)
+{
+    SithThing* p = sithPlayer_g_pLocalPlayerThing;
+    flex_t share = jkRpg_BowChargeShare(p), flash = jkRpg_RifleFlashShare(p);
+    int kind = flash >= 0; // 0 the bowcaster's green light, 1 the rifle's red flash
+    rdModel3* model = pov ? pov->model3 : NULL;
+    if ((share < 0 && flash < 0) || !model || !pov->paJointMatrices || !model->numGeos || jkRpg_aGlowFailed[kind])
+        return;
+    rdPolyline* line = &jkRpg_aGlowLine[kind];
+    if (!jkRpg_aGlowReady[kind]) {
+        if (!rdPolyline_NewEntry(line, kind ? "RifleFlash" : "BowGlow", (char*)jkRpg_aGlowMats[kind][0], (char*)jkRpg_aGlowMats[kind][1],
+                                 0, RPG_GLOW_MIN, RPG_GLOW_MIN, RD_LIGHTMODE_4_UNK, 0, 0, 0.0) // as the saber blade
+            || !rdThing_NewEntry(&jkRpg_aGlowThing[kind], p) || !rdThing_SetPolyline(&jkRpg_aGlowThing[kind], line)) {
+            jkRpg_aGlowFailed[kind] = 1;
+            return;
+        }
+        jkRpg_aGlowReady[kind] = 1;
+    }
+    // The barrel's tip is the model point farthest forward from the eye, as the model is posed now.
+    rdGeoset* geo = &model->aGeos[0];
+    rdVector3 tip, at;
+    flex_t best = -1e9;
+    for (uint32_t n = 0; n < model->numHNodes; n++) {
+        uint32_t mesh = model->aHierarchyNodes[n].meshIdx;
+        if (mesh >= geo->numMeshes) continue;
+        rdMesh* m = &geo->aMeshes[mesh];
+        for (int v = 0; v < m->numVertices; v++) {
+            rdMatrix_TransformPoint34(&at, &m->aVertices[v], &pov->paJointMatrices[n]);
+            flex_t ahead = rdVector_Dot3(&at, &orient->lvec);
+            if (ahead > best) { best = ahead; tip = at; }
+        }
+    }
+    if (best <= -1e9)
+        return;
+    // The charge light grows through the charge and pulses gently once full; the flash shrinks away.
+    flex_t pulse = share >= 1 ? 0.85 + 0.15 * sinf((flex32_t)(sithTime_g_secGameTime * 12.0)) : 1.0;
+    flex_t r = kind ? RPG_FLASH_SIZE * (0.4 + 0.6 * flash) : (RPG_GLOW_MIN + (RPG_GLOW_MAX - RPG_GLOW_MIN) * share) * pulse;
+    line->baseRadius = line->tipRadius = r;
+    line->length = 0; // the round tip cap alone
+    rdMatrix34 place = *orient;      // a short upright stroke, seen side-on: a soft round light
+    place.lvec = orient->uvec;
+    place.uvec = orient->lvec;
+    rdVector_Neg3Acc(&place.uvec);
+    place.scale = tip;
+    // On top of the barrel: depth-tested, the tip's own faces darkened the light's lower half.
+    rdSetZBufferMethod(RD_ZBUFFER_NOREAD_NOWRITE);
+    rdThing_Draw(&jkRpg_aGlowThing[kind], &place);
+    rdCache_Flush();
+    rdSetZBufferMethod(RD_ZBUFFER_READ_NOWRITE);
+}
+
+// A level was freed or a save is loading: queued blasts, projectile tags and the saber state
+// belong to the old world (thing slots and signatures repeat in the next one). The charge glow's
+// materials belong to it as well.
+void jkRpg_WeaponsResetSession(void)
+{
+    jkRpg_numPending = 0;
+    memset(jkRpg_aTagSig, 0, sizeof(jkRpg_aTagSig));
+    jkRpg_saberUpdated = -1;
+    jkRpg_FreeChargeGlow();
+}
+
+// Once per frame while the game runs.
+void jkRpg_WeaponsTick(SithThing* p, flex_t deltaSecs)
+{
+    jkRpg_RunPendingBlasts();
+}
