+#ifdef SDL2_RENDER
+// Preserve the stock blue blade's texels, with a vivid falloff and white core.
+static int rdMaterial_BlueSaberPixel(unsigned char index, int alpha)
+{
+    int r, g, b;
+    switch (index) {
+    case 0: return 0;
+    case 16: r=255; g=255; b=255; break;
+    case 17: r=176; g=207; b=255; break;
+    case 18: r=96;  g=155; b=255; break;
+    case 19: r=40;  g=100; b=255; break;
+    case 20: r=16;  g=72;  b=255; break;
+    case 137:r=8;   g=48;  b=255; break;
+    case 138:r=4;   g=24;  b=208; break;
+    case 139:r=0;   g=12;  b=144; break;
+    case 140:r=0;   g=4;   b=96;  break;
+    default: return -1;
+    }
+    // The texture shader swaps B/R after the REV upload: use native RGB565/1555.
+    return alpha ? 0x8000 | (r>>3)<<10 | (g>>3)<<5 | (b>>3)
+                 : (r>>3)<<11 | (g>>2)<<5 | (b>>3);
+}
+
+static tVBuffer* rdMaterial_BlueSaber(tVBuffer* original, const char* path, int alpha)
+{
+    const char* name = stdFileFromPath(path);
+    if (original->format.format.bpp != 8 ||
+        (__strcmpi(name, "saberblue0.mat") && __strcmpi(name, "saberblue1.mat")))
+        return original;
+    stdDisplay_VBufferLock(original);
+    // Unknown indices mean custom artwork: leave it untouched.
+    for (int y=0; y<original->format.height; ++y)
+        for (int x=0; x<original->format.width; ++x)
+            if (rdMaterial_BlueSaberPixel(((unsigned char*)original->surface_lock_alloc)[y*original->format.rowSize+x], alpha) < 0) {
+                stdDisplay_VBufferUnlock(original);
+                return original;
+            }
+    tRasterInfo format = original->format;
+    format.format.is16bit = 1;
+    format.format.bpp = 16;
+    tVBuffer* colored = stdDisplay_VBufferNew(&format, 0, 0, NULL);
+    if (colored) {
+        stdDisplay_VBufferLock(colored);
+        for (int y=0; y<original->format.height; ++y) {
+            uint16_t* row = (uint16_t*)((char*)colored->surface_lock_alloc + y*colored->format.rowSize);
+            for (int x=0; x<original->format.width; ++x)
+                row[x] = rdMaterial_BlueSaberPixel(((unsigned char*)original->surface_lock_alloc)[y*original->format.rowSize+x], alpha);
+        }
+        stdDisplay_VBufferUnlock(colored);
+    }
+    stdDisplay_VBufferUnlock(original);
+    if (!colored) return original;
+    stdDisplay_VBufferFree(original);
+    return colored;
+}
+#endif
+
+#ifdef SDL2_RENDER
+// RPG clothing variety (jkRpgOutfits.c): one mip converted to native RGB565 through a
+// palette-index table. The original stays untouched.
+static tVBuffer* rdMaterial_RecolorMip(tVBuffer* original, const uint16_t* table)
+{
+    if (!original || original->format.format.bpp != 8)
+        return NULL;
+    tRasterInfo format = original->format;
+    format.format.is16bit = 1;
+    format.format.bpp = 16;
+    tVBuffer* colored = stdDisplay_VBufferNew(&format, 0, 0, NULL);
+    if (!colored)
+        return NULL;
+    stdDisplay_VBufferLock(original);
+    stdDisplay_VBufferLock(colored);
+    for (int y=0; y<original->format.height; ++y) {
+        const unsigned char* src = (unsigned char*)original->surface_lock_alloc + y*original->format.rowSize;
+        uint16_t* row = (uint16_t*)((char*)colored->surface_lock_alloc + y*colored->format.rowSize);
+        for (int x=0; x<original->format.width; ++x)
+            row[x] = table[src[x]];
+    }
+    stdDisplay_VBufferUnlock(colored);
+    stdDisplay_VBufferUnlock(original);
+    return colored;
+}
+
+// RPG clothing variety: a separately owned copy of a loaded opaque 8-bit material, recoloured
+// through `table`, without reading files again. Returns NULL when the material does not
+// qualify (alpha, 16-bit art, missing data); free the result with rdMaterial_FreeEntry and
+// RDROID_FREE, never through the world's material list.
+rdMaterial* rdMaterial_CopyRecolored(const rdMaterial* pSrc, const uint16_t* table)
+{
+    if (!pSrc || !pSrc->textures || !pSrc->num_textures || pSrc->texFormat.bpp != 8)
+        return NULL;
+    rdMaterial* pMat = (rdMaterial*)RDROID_ALLOC(sizeof(rdMaterial));
+    if (!pMat)
+        return NULL;
+    *pMat = *pSrc;
+    pMat->palette_alloc = NULL;
+    pMat->num_texinfo = 0;
+    memset(pMat->texinfos, 0, sizeof(pMat->texinfos));
+    pMat->textures = (rdTexture*)RDROID_ALLOC(sizeof(rdTexture) * pSrc->num_textures);
+    if (!pMat->textures) {
+        pMat->num_textures = 0;
+        goto fail;
+    }
+    memset(pMat->textures, 0, sizeof(rdTexture) * pSrc->num_textures);
+    for (uint32_t t = 0; t < pSrc->num_textures; t++) {
+        const rdTexture* src = &pSrc->textures[t];
+        rdTexture* dst = &pMat->textures[t];
+        if (src->alpha_en & 1)
+            goto fail;
+        dst->alpha_en = src->alpha_en;
+        dst->unk_0c = src->unk_0c;
+        dst->color_transparent = src->color_transparent;
+        dst->width_bitcnt = src->width_bitcnt;
+        dst->width_minus_1 = src->width_minus_1;
+        dst->height_minus_1 = src->height_minus_1;
+        for (uint32_t m = 0; m < src->num_mipmaps; m++) {
+            dst->texture_struct[m] = rdMaterial_RecolorMip(src->texture_struct[m], table);
+            if (!dst->texture_struct[m])
+                goto fail;
+            dst->num_mipmaps = m + 1;
+            rdDDrawSurface* surfaces[2] = {&dst->alphaMats[m], &dst->opaqueMats[m]};
+            for (int s = 0; s < 2; s++) {
+                surfaces[s]->albedo_factor[0] = surfaces[s]->albedo_factor[1] = 1.0;
+                surfaces[s]->albedo_factor[2] = surfaces[s]->albedo_factor[3] = 1.0;
+                surfaces[s]->skip_jkgm = 1; // texture packs replace the original by name only
+            }
+        }
+    }
+    for (uint32_t i = 0; i < pSrc->num_texinfo; i++) {
+        rdTexinfo* info = (rdTexinfo*)RDROID_ALLOC(sizeof(rdTexinfo));
+        if (!info)
+            goto fail;
+        *info = *pSrc->texinfos[i];
+        if (info->texture_ptr)
+            info->texture_ptr = &pMat->textures[info->texture_ptr - pSrc->textures];
+        pMat->texinfos[i] = info;
+        pMat->num_texinfo = i + 1;
+    }
+    return pMat;
+fail:
+    rdMaterial_FreeEntry(pMat);
+    RDROID_FREE(pMat);
+    return NULL;
+}
+#endif
